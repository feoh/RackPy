#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["cyclopts>=5.2,<6"]
#
# [tool.uv]
# exclude-newer = "2026-10-21T00:00:00Z"
# ///
"""Classify every public virtual method in the SDK inventory by thread and lock rules (RP-06).

Reads upstream/api-surface.json and the reviewed rules in
upstream/callback-rules.json, then writes docs/reference/callback-matrix.md.
A virtual method that no rule matches fails the check, so new upstream
callbacks cannot slip through unclassified.
"""

import json
from collections import Counter, defaultdict
from pathlib import Path
from typing import Any

import cyclopts

REPO = Path(__file__).resolve().parent.parent
SURFACE = REPO / "upstream" / "api-surface.json"
RULES = REPO / "upstream" / "callback-rules.json"
OUTPUT = REPO / "docs" / "reference" / "callback-matrix.md"
RECORD_KINDS = {"record", "specialization", "class_template", "partial_specialization"}

app = cyclopts.App(help=__doc__)


def strip_args(name: str) -> str:
    depth, out = 0, []
    for ch in name:
        if ch == "<":
            depth += 1
        elif ch == ">":
            depth -= 1
        elif depth == 0:
            out.append(ch)
    return "".join(out).strip()


def records(entries: list[dict[str, Any]]) -> dict[str, dict[str, Any]]:
    found: dict[str, dict[str, Any]] = {}
    for e in entries:
        if e["kind"] in RECORD_KINDS:
            found.setdefault(strip_args(e["name"]), e)
    return found


def ancestors(name: str, recs: dict[str, dict[str, Any]]) -> list[str]:
    """The record and every base reachable through `bases`, nearest first."""
    out: list[str] = []
    todo = [strip_args(name)]
    while todo:
        current = todo.pop(0)
        if current in out:
            continue
        out.append(current)
        for base in recs.get(current, {}).get("bases", []):
            todo.append(strip_args(base["type"]))
    return out


def method_name(entry: dict[str, Any]) -> str:
    return "~" if entry["kind"] == "destructor" else entry["name"].rsplit("::", 1)[1]


def classify(entries: list[dict[str, Any]], rules: list[dict[str, Any]]) -> list[dict[str, Any]]:
    recs = records(entries)
    rows = []
    for e in entries:
        if not e.get("virtual") or e["classification"] != "public":
            continue
        owner = e["name"].rsplit("::", 1)[0]
        chain = ancestors(owner, recs)
        name = method_name(e)
        rule = next(
            (
                r
                for r in rules
                if (r["family"] == "*" or r["family"] in chain)
                and (name in r["methods"] or "*" in r["methods"])
                and not (name == "~" and "*" in r["methods"] and "~" not in r["methods"])
            ),
            None,
        )
        rows.append(
            {
                "id": e["id"],
                "owner": owner,
                "method": name,
                "family": rule["family"] if rule else None,
                "strategy": rule["strategy"] if rule else None,
                "blocks": rule.get("blocks") if rule else None,
                "override": bool(e.get("override")),
                "deprecated": bool(e.get("deprecated") or e.get("comment_deprecated")),
            }
        )
    return rows


def render(rows: list[dict[str, Any]], doc: dict[str, Any]) -> str:
    strategies = doc["strategies"]
    by_strategy = Counter(r["strategy"] for r in rows)
    out = [
        "# Callback thread and lock matrix",
        "",
        "**Generated by `bin/callback-matrix --write`; do not edit by hand.** Rules and evidence:",
        "[`upstream/callback-rules.json`](../../upstream/callback-rules.json) and",
        "[ADR 003](../decisions/003-lifetimes-and-threads.md).",
        "",
        f"Every public virtual method in the inventory: **{len(rows)}** entries.",
        "",
        "## Strategies",
        "",
        "| Strategy | Methods | Meaning |",
        "| --- | --- | --- |",
    ]
    for name, meaning in strategies.items():
        out.append(f"| `{name}` | {by_strategy.get(name, 0)} | {meaning} |")
    out += ["", "## By family", ""]
    groups: dict[tuple[str, str], list[dict[str, Any]]] = defaultdict(list)
    for r in rows:
        groups[(r["family"] or "UNMATCHED", r["strategy"] or "UNMATCHED")].append(r)
    out += ["| Family | Strategy | Methods (declared or overridden) | Count |", "| --- | --- | --- | --- |"]
    for (fam, strat), items in sorted(groups.items()):
        names = sorted({i["method"] for i in items})
        shown = ", ".join(f"`{n}`" for n in names[:14]) + (", …" if len(names) > 14 else "")
        out.append(f"| `{fam}` | `{strat}` | {shown} | {len(items)} |")
    blocked = sorted({r["blocks"] for r in rows if r["blocks"]})
    out += [
        "",
        "## Unresolved",
        "",
        f"{by_strategy.get('unresolved', 0)} methods are unresolved and block: "
        + (", ".join(blocked) if blocked else "nothing")
        + ".",
        "",
    ]
    return "\n".join(out)


@app.command
def check(*, write: bool = False) -> None:
    """Classify all public virtual methods; fail if any is unmatched. With --write, update the matrix doc."""
    surface = json.loads(SURFACE.read_text(encoding="utf-8"))
    doc = json.loads(RULES.read_text(encoding="utf-8"))
    rows = classify(surface["entries"], doc["rules"])
    unmatched = [r["id"] for r in rows if r["strategy"] is None]
    if write:
        OUTPUT.write_text(render(rows, doc), encoding="utf-8")
    counts = Counter(r["strategy"] for r in rows)
    print(f"{len(rows)} public virtual methods: {dict(sorted((k or 'UNMATCHED', v) for k, v in counts.items()))}")
    if unmatched:
        raise SystemExit("unclassified virtual methods:\n" + "\n".join(unmatched[:50]))
    if not write and OUTPUT.exists() and OUTPUT.read_text(encoding="utf-8") != render(rows, doc):
        raise SystemExit(f"{OUTPUT} is out of date; run bin/callback-matrix check --write")


@app.command
def show(strategy: str) -> None:
    """List the method IDs with one strategy."""
    surface = json.loads(SURFACE.read_text(encoding="utf-8"))
    doc = json.loads(RULES.read_text(encoding="utf-8"))
    for r in classify(surface["entries"], doc["rules"]):
        if r["strategy"] == strategy:
            print(r["id"])


if __name__ == "__main__":
    app()
