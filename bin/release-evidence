#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["cyclopts>=5.2,<6"]
#
# [tool.uv]
# exclude-newer = "2026-10-21T00:00:00Z"
# ///
"""Collect RackPy's release evidence from one CI run: coverage and sample parity on every platform (RP-42).

collect  judge a finished run's test, sample and candidate evidence on each platform. `--allow-promoted`
         permits only working-tree changes to the manifest and its generated coverage outputs.
slices   split records into exact independent-review chunks of at most 25; with --carry-plan, use only its redo IDs.
verdicts validate reviewer answers against the frozen slices and write review/<slice>.verdicts.json.
carry    carry accepted reviews from OLD to NEW only when manifest-record, test and mapped-source Git blobs match.
promote  require complete fresh verdicts plus a revalidated carry plan before marking records `verified`.
         `bin/check_coverage.py check` then needs the verdict files in review/.
"""

import contextlib
import hashlib
import json
import re
import subprocess
import sys
import tempfile
from collections import Counter
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

import cyclopts

sys.path.insert(0, str(Path(__file__).resolve().parent))
import binding_manifest as bm

app = cyclopts.App(help=__doc__)
REPO_SLUG = "feoh/rackpy"
DEST = bm.REPO / "release-evidence"
# Where each platform's test outcomes and its release candidate's introspection are in a run's artifacts.
TESTS = {
    "lin-x64": [
        "python-reports",
        "native-reports",
        "host-reports",
        "docs-reports",
        "dist-reports",
        "inventory-reports",
    ],
    "mac-arm64": [
        "macos-mac-arm64-app-reports",
        "macos-mac-arm64-coverage-reports",
        "macos-mac-arm64-dsp-reports",
        "macos-mac-arm64-examples-reports",
        "macos-mac-arm64-services-reports",
    ],
    "mac-x64": [
        "macos-mac-x64-app-reports",
        "macos-mac-x64-coverage-reports",
        "macos-mac-x64-dsp-reports",
        "macos-mac-x64-examples-reports",
        "macos-mac-x64-services-reports",
    ],
    "win-x64": [
        "windows-win-x64-app-reports",
        "windows-win-x64-coverage-reports",
        "windows-win-x64-dsp-reports",
        "windows-win-x64-examples-reports",
        "windows-win-x64-services-reports",
    ],
}
CANDIDATES = {
    "lin-x64": "release-candidate-evidence",
    "mac-arm64": "macos-mac-arm64-release-candidate-evidence",
    "mac-x64": "macos-mac-x64-release-candidate-evidence",
    "win-x64": "windows-win-x64-release-candidate-evidence",
}
SHOWN = 40  # problems listed per platform and check; the counts cover all of them
SHARED_JOB = "Hooks, typing and unit tests"  # synthetic checker mutation tests run here, once on Linux


def gh(*args: str) -> str:
    return subprocess.run(["gh", *args], capture_output=True, text=True, check=True).stdout


def checked_run(run: int, *, allow_promoted: bool = False) -> dict[str, Any]:
    """Require a finished CI run and an exact or promotion-only checkout."""
    info: dict[str, Any] = json.loads(
        gh("run", "view", str(run), "-R", REPO_SLUG, "--json", "headSha,headBranch,url,status,jobs")
    )
    if info["status"] != "completed":
        raise SystemExit(f"run {run} is {info['status']}; use a finished run")
    check_checkout(info["headSha"], allow_promoted=allow_promoted)
    return info


def require_verdict_commit(path: Path, doc: dict[str, Any], candidate: str) -> None:
    """A review is tied to the exact candidate source, not just to stable record IDs."""
    if doc.get("commit") != candidate:
        raise SystemExit(f"{path}: verdict reviewed {doc.get('commit')}, not CI candidate {candidate}")


PROMOTION_OUTPUTS = (
    "bindings/manifest.json",
    "bindings/generated/",
    "native/bindings/generated/",
    "docs/reference/coverage.md",
    "docs/reference/callback-paths.md",
    "docs/reference/crosswalk.md",
    "docs/reference/crosswalk/",
    "src/rackpy/raw/glfw.pyi",
    "src/rackpy/raw/blendish.pyi",
)
MAX_REVIEW_CHUNK = 25
_CARRY_BLOBS: dict[tuple[str, str, str], bytes] = {}
_CARRY_MANIFESTS: dict[tuple[str, str], tuple[dict[str, Any], dict[str, bytes]]] = {}


def _git_blob(revision: str, path: str) -> bytes:
    key = (str(bm.REPO.resolve()), revision, path)
    if key not in _CARRY_BLOBS:
        result = subprocess.run(["git", "show", f"{revision}:{path}"], cwd=bm.REPO, capture_output=True, check=False)
        if result.returncode:
            raise ValueError(f"cannot read {revision}:{path} from Git")
        _CARRY_BLOBS[key] = result.stdout
    return _CARRY_BLOBS[key]


def _git_commit(revision: str) -> str:
    return subprocess.run(
        ["git", "rev-parse", "--verify", f"{revision}^{{commit}}"],
        cwd=bm.REPO,
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()


def _manifest_for(revision: str) -> tuple[dict[str, Any], dict[str, bytes]]:
    key = (str(bm.REPO.resolve()), revision)
    if key not in _CARRY_MANIFESTS:
        raw = _git_blob(revision, "bindings/manifest.json")
        parsed = json.loads(raw)
        _CARRY_MANIFESTS[key] = (parsed, _record_bytes(raw))
    return _CARRY_MANIFESTS[key]


def _record_bytes(data: bytes) -> dict[str, bytes]:
    parsed = json.loads(data)
    entries = parsed.get("entries") if isinstance(parsed, dict) else None
    if not isinstance(entries, list):
        raise ValueError("manifest has no entries array")
    text = data.decode("utf-8")
    marker = data.find(b'"entries"')
    array_start = data.find(b"[", marker)
    if array_start < 0:
        raise ValueError("cannot find manifest entries array")
    offset = len(data[:array_start].decode("utf-8")) + 1
    decoder = json.JSONDecoder()
    records: dict[str, bytes] = {}
    for _ in entries:
        while offset < len(text) and (text[offset].isspace() or text[offset] == ","):
            offset += 1
        if offset >= len(text) or text[offset] == "]":
            break
        record, end = decoder.raw_decode(text, offset)
        if not isinstance(record, dict) or not isinstance(record.get("id"), str):
            raise ValueError("manifest entry is missing a string ID")
        if record["id"] in records:
            raise ValueError(f"duplicate manifest record: {record['id']}")
        records[record["id"]] = text[offset:end].encode("utf-8")
        offset = end
    if len(records) != len(entries):
        raise ValueError("could not extract exact bytes for all manifest entries")
    return records


def _record_dependencies(record: dict[str, Any]) -> list[str]:
    paths = [record["implementation"]] if isinstance(record.get("implementation"), str) else []
    for field in ("tests", "sources"):
        values = record.get(field, [])
        if not isinstance(values, list):
            raise ValueError(f"{record.get('id')}: {field} must be a list")
        paths.extend(
            value.split("::", 1)[0] if field == "tests" else value for value in values if isinstance(value, str)
        )
    mapping = record.get("mapping")
    if isinstance(mapping, dict) and isinstance(mapping.get("sources"), list):
        paths.extend(path for path in mapping["sources"] if isinstance(path, str))
    normalized = set()
    for value in paths:
        path = Path(value)
        if path.is_absolute() or ".." in path.parts or not path.parts:
            raise ValueError(f"unsafe mapping/test path: {value!r}")
        normalized.add(path.as_posix())
    return sorted(normalized)


def _same_record_inputs(old: str, new: str, record: dict[str, Any], old_record: bytes, new_record: bytes) -> bool:
    if old_record != new_record:
        return False
    for path in _record_dependencies(record):
        try:
            if _git_blob(old, path) != _git_blob(new, path):
                return False
        except ValueError:
            return False
    return True


def check_checkout(commit: str, *, allow_promoted: bool = False) -> None:
    """Require the candidate checkout; optionally permit only coverage-promotion outputs."""
    head = subprocess.run(
        ["git", "rev-parse", "HEAD"], cwd=bm.REPO, capture_output=True, text=True, check=True
    ).stdout.strip()
    if commit != head:
        raise SystemExit(f"run tested {commit}, but checkout is {head}; use the exact candidate commit")
    changed = subprocess.run(
        ["git", "diff", "--name-only", "HEAD", "--"], cwd=bm.REPO, capture_output=True, text=True, check=True
    ).stdout.splitlines()
    if allow_promoted:
        disallowed = [
            path
            for path in changed
            if path not in PROMOTION_OUTPUTS
            and not any(path.startswith(prefix) for prefix in PROMOTION_OUTPUTS if prefix.endswith("/"))
        ]
        if disallowed:
            raise SystemExit(f"--allow-promoted permits only manifest/generated outputs; found {disallowed}")
    elif changed:
        raise SystemExit(
            "tracked files differ from the candidate commit; commit or restore them before judging evidence"
        )


def shared_check_problems(jobs: dict[str, str]) -> list[bm.Problem]:
    """The Linux unit job runs platform-independent coverage-checker mutation tests for the whole release."""
    conclusion = jobs.get(SHARED_JOB) or "missing"
    if conclusion == "success":
        return []
    return [bm.Problem("shared-checks", SHARED_JOB, f"shared Linux unit job is {conclusion}, not success")]


def selection_problems(root: Path, platform: str) -> list[bm.Problem]:
    """Focused macOS/Windows diagnostic runs are not full-candidate evidence."""
    if platform == "lin-x64":
        return []
    problems: list[bm.Problem] = []
    for artifact in TESTS[platform]:
        selection = root / artifact / "selection.txt"
        try:
            expression = selection.read_text(encoding="utf-8")
        except OSError:
            problems.append(bm.Problem("test-selection", artifact, "full-suite selection attestation is missing"))
            continue
        if expression:
            problems.append(
                bm.Problem("test-selection", artifact, f"diagnostic pytest -k selection was used: {expression!r}")
            )
    return problems


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def problems_doc(problems: list[bm.Problem]) -> dict[str, Any]:
    ordered = sorted(problems, key=lambda p: (p.code, p.id))
    return {
        "count": len(problems),
        "by_code": dict(sorted(Counter(p.code for p in problems).items())),
        "first": [{"code": p.code, "id": p.id, "message": p.message} for p in ordered[:SHOWN]],
    }


def contains_placeholder(value: Any) -> bool:
    if isinstance(value, str):
        return value.strip().lower() in {"todo", "tbd", "placeholder", "unreviewed", "n/a"}
    if isinstance(value, dict):
        return any(contains_placeholder(item) for item in value.values())
    if isinstance(value, list):
        return any(contains_placeholder(item) for item in value)
    return False


def download(run: int, root: Path) -> None:
    """The run's test reports and release-candidate reports, into ROOT/<artifact>/."""
    for name in {n for names in TESTS.values() for n in names} | set(CANDIDATES.values()):
        # Not uploaded (the job did not run, or failed early): that platform shows no evidence.
        with contextlib.suppress(subprocess.CalledProcessError):
            gh("run", "download", str(run), "-R", REPO_SLUG, "-n", name, "-D", str(root / name))


def platform_outcomes(root: Path, platform: str) -> dict[str, str]:
    folders = [root / n / "evidence" for n in TESTS[platform] if (root / n / "evidence").is_dir()]
    return bm.load_evidence(folders, platform)


def write_json(path: Path, doc: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n", encoding="utf-8", newline="\n")


@app.command
def carry(old: str, new: str, *, review_dir: Path = bm.REVIEWS, dest: Path | None = None) -> None:
    """Carry only accepted verdicts whose exact manifest, test and mapped-source blobs did not change."""
    try:
        old_sha, new_sha = _git_commit(old), _git_commit(new)
        old_manifest, old_bytes = _manifest_for(old_sha)
        new_manifest, new_bytes = _manifest_for(new_sha)
        old_entries = {item["id"]: item for item in old_manifest["entries"]}
        new_entries = {item["id"]: item for item in new_manifest["entries"]}
        previous: dict[str, tuple[str, str, str, str]] = {}
        for path in sorted(review_dir.glob("*.verdicts.json")):
            document = bm.load_json(path)
            if document.get("commit") != old_sha:
                continue
            if errors := bm.review_file_problems(document):
                raise ValueError(f"{path}: {errors[0]}")
            for record_id, verdict in document["records"].items():
                if verdict["verdict"] != "accept":
                    continue
                item = (document["reviewer"], document["commit"], path.name, sha256(path))
                if record_id in previous and previous[record_id] != item:
                    raise ValueError(f"conflicting accepted verdicts for {record_id}")
                previous[record_id] = item
        for path in sorted(review_dir.glob("carry-*.json")):
            prior_plan = bm.load_json(path)
            if prior_plan.get("commit") != old_sha:
                continue
            for record_id, carried in prior_plan.get("carried", {}).items():
                if not isinstance(carried, dict) or carried.get("verdict") != "accept":
                    continue
                reviewer = carried.get("reviewer")
                reviewed_commit = carried.get("reviewed_commit")
                source_file = carried.get("source_file")
                if (
                    carried.get("carry_commit") != old_sha
                    or not isinstance(reviewed_commit, str)
                    or not isinstance(reviewer, str)
                    or not isinstance(source_file, str)
                    or Path(source_file).name != source_file
                    or not source_file.endswith(".verdicts.json")
                ):
                    raise ValueError(f"{path}: invalid carried provenance for {record_id}")
                source_path = review_dir / source_file
                if not source_path.is_file() or sha256(source_path) != carried.get("source_sha256"):
                    raise ValueError(f"{path}: source verdict changed or missing for {record_id}")
                source_doc = bm.load_json(source_path)
                if (
                    source_doc.get("commit") != reviewed_commit
                    or source_doc.get("reviewer") != reviewer
                    or source_doc.get("records", {}).get(record_id, {}).get("verdict") != "accept"
                ):
                    raise ValueError(f"{path}: source verdict does not support carry for {record_id}")
                original_manifest, original_bytes = _manifest_for(reviewed_commit)
                original_entries = {item["id"]: item for item in original_manifest["entries"]}
                if (
                    record_id not in original_entries
                    or record_id not in old_entries
                    or not _same_record_inputs(
                        reviewed_commit,
                        old_sha,
                        original_entries[record_id],
                        original_bytes[record_id],
                        old_bytes[record_id],
                    )
                ):
                    continue
                item = (reviewer, reviewed_commit, source_file, carried["source_sha256"])
                if record_id in previous and previous[record_id] != item:
                    raise ValueError(f"conflicting accepted verdicts for {record_id}")
                previous[record_id] = item
        reviewable = {
            record_id for record_id, entry in new_entries.items() if entry.get("status") in {"implemented", "verified"}
        }
        carried_records: dict[str, Any] = {}
        redo: list[str] = []
        for record_id in sorted(reviewable):
            verdict = previous.get(record_id)
            if verdict is None:
                redo.append(record_id)
                continue
            reviewer, reviewed_commit, source_file, source_sha256 = verdict
            original_manifest, original_bytes = _manifest_for(reviewed_commit)
            original_entries = {item["id"]: item for item in original_manifest["entries"]}
            if (
                record_id not in original_entries
                or record_id not in new_entries
                or not _same_record_inputs(
                    reviewed_commit,
                    new_sha,
                    original_entries[record_id],
                    original_bytes[record_id],
                    new_bytes[record_id],
                )
            ):
                redo.append(record_id)
                continue
            carried_records[record_id] = {
                "verdict": "accept",
                "reviewer": reviewer,
                "reviewed_commit": reviewed_commit,
                "carry_commit": new_sha,
                "source_file": source_file,
                "source_sha256": source_sha256,
            }
        plan = {
            "schema_version": 1,
            "from_commit": old_sha,
            "commit": new_sha,
            "carried": carried_records,
            "redo": redo,
            "chunks": [redo[index : index + MAX_REVIEW_CHUNK] for index in range(0, len(redo), MAX_REVIEW_CHUNK)],
        }
        target = dest or review_dir / f"carry-{old_sha[:12]}-{new_sha[:12]}.json"
        write_json(target, plan)
        print(
            json.dumps(
                {
                    "from_commit": old_sha,
                    "commit": new_sha,
                    "carried": len(carried_records),
                    "redo": len(redo),
                    "plan": str(target),
                }
            )
        )
    except (ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:
        raise SystemExit(str(exc)) from exc


@app.command
def collect(run: int, *, dest: Path = DEST, allow_promoted: bool = False) -> None:
    """Judge every platform from finished CI run RUN and write DEST.

    --allow-promoted accepts only local manifest/generated coverage outputs changed after the run.
    """
    info = checked_run(run, allow_promoted=allow_promoted)
    jobs = {j["name"]: j["conclusion"] for j in info["jobs"]}
    inputs = bm.load_inputs()
    manifest: dict[str, Any] = bm.load_json(bm.MANIFEST)
    examples: dict[str, Any] = bm.load_json(bm.EXAMPLES)
    summary: dict[str, Any] = {}
    with tempfile.TemporaryDirectory(prefix="rackpy-evidence-") as scratch:
        root = Path(scratch)
        download(run, root)
        check_checkout(info["headSha"], allow_promoted=allow_promoted)
        for platform in TESTS:
            entry: dict[str, Any] = {}
            try:
                outcomes = platform_outcomes(root, platform)
            except bm.ManifestError as e:
                entry["error"] = str(e)
                summary[platform] = entry
                continue
            entry["tests"] = dict(sorted(Counter(outcomes.values()).items()))
            problems, counts = bm.evidence_problems(inputs, manifest, platform, outcomes)
            entry["records"] = dict(sorted(counts.items()))
            entry["evidence_problems"] = problems_doc(problems)
            sample_issues, per_sample = bm.sample_problems(examples["samples"], platform, outcomes)
            entry["samples"] = dict(sorted(Counter(r["status"] for r in per_sample.values()).items()))
            entry["sample_problems"] = problems_doc(sample_issues)
            write_json(dest / "samples" / f"{platform}.json", {"platform": platform, "samples": per_sample})
            introspection = root / CANDIDATES[platform] / f"introspection-{platform}.json"
            if introspection.exists():
                artifact: dict[str, Any] = bm.load_json(introspection)
                entry["candidate_introspection"] = {
                    "sha256": sha256(introspection),
                    "objects": len(artifact.get("objects") or {}),
                }
                release = bm.release_problems(inputs, manifest, platform, artifact, outcomes)
                entry["release_problems"] = problems_doc(
                    release + shared_check_problems(jobs) + selection_problems(root, platform)
                )
            else:
                entry["candidate_introspection"] = None  # no candidate: the release bar cannot be judged
            summary[platform] = entry
            write_json(dest / "coverage" / f"{platform}.json", {"platform": platform, **entry})
    write_json(
        dest / "run.json",
        {
            "run": run,
            "url": info["url"],
            "commit": info["headSha"],
            "branch": info["headBranch"],
            "jobs": dict(sorted(jobs.items())),
            "inventory_sha256": inputs.inventory_sha256,
            "manifest_sha256": sha256(bm.MANIFEST),
            "examples_sha256": sha256(bm.EXAMPLES),
            "collected_at": datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ"),
        },
    )
    (dest / "SUMMARY.md").write_text(markdown(run, info, jobs, summary), encoding="utf-8", newline="\n")
    print((dest / "SUMMARY.md").read_text(encoding="utf-8"))


@app.command
def slices(
    *,
    size: int = MAX_REVIEW_CHUNK,
    dest: Path = bm.REVIEWS,
    carry_plan: Path | None = None,
) -> None:
    """Write deterministic review chunks of at most SIZE; use a carry plan to emit only redo IDs."""
    if not 1 <= size <= MAX_REVIEW_CHUNK:
        raise SystemExit(f"review slice size must be between 1 and {MAX_REVIEW_CHUNK}")
    if carry_plan is not None:
        plan = bm.load_json(carry_plan)
        chunks = plan.get("chunks")
        if not isinstance(chunks, list) or any(not isinstance(chunk, list) or len(chunk) > size for chunk in chunks):
            raise SystemExit(f"{carry_plan}: invalid chunks or chunk exceeds requested size")
        plan_slices = [
            {"slice": f"redo-{index:03d}", "family": "redo", "headers": [], "records": chunk}
            for index, chunk in enumerate(chunks, start=1)
        ]
        write_json(dest / "slices.json", {"commit": plan["commit"], "size": size, "slices": plan_slices})
        print(
            f"{sum(len(item['records']) for item in plan_slices)} records in {len(plan_slices)} redo slices: "
            f"{dest / 'slices.json'}"
        )
        return
    inputs = bm.load_inputs()
    manifest: dict[str, Any] = bm.load_json(bm.MANIFEST)
    grouped: dict[str, dict[str, list[str]]] = {}
    for record in manifest["entries"]:
        if record["status"] != "implemented":
            continue
        entry = inputs.index.get(record["id"])
        family = bm.family_of(inputs.inventory, entry) if entry else "unassigned"
        header = str((entry or {}).get("header", "?"))
        grouped.setdefault(family, {}).setdefault(header, []).append(record["id"])
    out: list[dict[str, Any]] = []
    for family in sorted(grouped):
        slug = bm.FAMILY_SLUGS.get(family, family).replace("_", "-")
        current: dict[str, Any] | None = None
        for header in sorted(grouped[family]):
            ids = sorted(grouped[family][header])
            for start in range(0, len(ids), size):
                chunk = ids[start : start + size]
                if current is None or len(current["records"]) + len(chunk) > size:
                    current = {"slice": f"{slug}-{sum(1 for s in out if s['family'] == family) + 1:02d}"}
                    current.update(family=family, headers=[], records=[])
                    out.append(current)
                if header not in current["headers"]:
                    current["headers"].append(header)
                current["records"].extend(chunk)
    commit = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True, check=True).stdout.strip()
    write_json(dest / "slices.json", {"commit": commit, "size": size, "slices": out})
    for item in out:
        print(f"{item['slice']}: {len(item['records'])} records, {', '.join(item['headers'])}")
    print(f"{sum(len(i['records']) for i in out)} records in {len(out)} slices: {dest / 'slices.json'}")


@app.command
def verdicts(answers: list[Path], *, dest: Path = bm.REVIEWS) -> None:
    """Write each reviewer's ANSWER (its final message: one fenced json block) as DEST/<slice>.verdicts.json, after
    checking the verdict format and that it judges exactly its slice's records (slices.json)."""
    slice_plan = bm.load_json(dest / "slices.json")
    if slice_plan.get("size", MAX_REVIEW_CHUNK) > MAX_REVIEW_CHUNK:
        raise SystemExit(f"{dest / 'slices.json'}: review chunks may contain at most {MAX_REVIEW_CHUNK} records")
    if any(len(item.get("records", [])) > MAX_REVIEW_CHUNK for item in slice_plan.get("slices", [])):
        raise SystemExit(f"{dest / 'slices.json'}: review chunk exceeds {MAX_REVIEW_CHUNK} records")
    slices = {s["slice"]: s for s in slice_plan["slices"]}
    for answer in answers:
        blocks = re.findall(r"```json\s*\n(.*?)\n```", answer.read_text(encoding="utf-8"), re.DOTALL)
        if len(blocks) != 1:
            raise SystemExit(f"{answer}: expected one fenced json block, found {len(blocks)}")
        doc = json.loads(blocks[0])
        if errors := bm.review_file_problems(doc):
            raise SystemExit(f"{answer}: {'; '.join(errors)}")
        if doc.get("commit") != slice_plan.get("commit"):
            raise SystemExit(f"{answer}: review output does not name the frozen slices commit")
        if contains_placeholder(doc) or doc.get("reviewer", "").endswith(":"):
            raise SystemExit(f"{answer}: reviewer output contains a placeholder")
        item = slices.get(doc.get("slice"))
        if item is None:
            raise SystemExit(f"{answer}: no slice {doc.get('slice')!r} in {dest / 'slices.json'}")
        expected, judged = set(item["records"]), set(doc["records"])
        if expected != judged:
            missing, extra = sorted(expected - judged), sorted(judged - expected)
            raise SystemExit(
                f"{answer}: {len(missing)} records missing ({missing[:3]}), {len(extra)} extra ({extra[:3]})"
            )
        write_json(dest / f"{doc['slice']}.verdicts.json", doc)
        counts = Counter(v["verdict"] for v in doc["records"].values())
        print(f"{doc['slice']}: {', '.join(f'{k} {v}' for k, v in sorted(counts.items()))}")


def carried_review_docs(plan_path: Path, candidate: str) -> tuple[list[dict[str, Any]], set[str], list[list[str]]]:
    """Validate the carry plan and return exact-SHA reviewer docs plus redo/chunk IDs."""
    plan = bm.load_json(plan_path)
    if plan.get("commit") != candidate or not isinstance(plan.get("carried"), dict):
        raise SystemExit(f"{plan_path}: carry plan is not for exact candidate {candidate}")
    old_sha = plan.get("from_commit")
    if not isinstance(old_sha, str) or len(old_sha) != 40:
        raise SystemExit(f"{plan_path}: missing full from_commit")
    chunks = plan.get("chunks")
    redo = plan.get("redo")
    if (
        not isinstance(chunks, list)
        or any(not isinstance(chunk, list) or not 1 <= len(chunk) <= MAX_REVIEW_CHUNK for chunk in chunks)
        or not isinstance(redo, list)
        or set(redo) != {record_id for chunk in chunks for record_id in chunk}
    ):
        raise SystemExit(f"{plan_path}: invalid redo/chunk plan")
    if len({tuple(chunk) for chunk in chunks}) != len(chunks):
        raise SystemExit(f"{plan_path}: duplicate review chunks")
    chunk_ids = [record_id for chunk in chunks for record_id in chunk]
    if len(chunk_ids) != len(set(chunk_ids)):
        raise SystemExit(f"{plan_path}: a record appears in multiple review chunks")
    new_manifest, new_bytes = _manifest_for(candidate)
    new_entries = {item["id"]: item for item in new_manifest["entries"]}
    by_reviewer: dict[str, dict[str, Any]] = {}
    for record_id, carried in plan["carried"].items():
        if not isinstance(carried, dict) or carried.get("verdict") != "accept":
            raise SystemExit(f"{plan_path}: {record_id} is not an accepted carry")
        reviewer = carried.get("reviewer")
        reviewed = carried.get("reviewed_commit")
        source_file = carried.get("source_file")
        if (
            carried.get("carry_commit") != candidate
            or not isinstance(reviewed, str)
            or not isinstance(reviewer, str)
            or not isinstance(source_file, str)
            or Path(source_file).name != source_file
            or not source_file.endswith(".verdicts.json")
            or record_id not in new_entries
        ):
            raise SystemExit(f"{plan_path}: invalid or changed carry provenance for {record_id}")
        source_path = plan_path.parent / source_file
        if not source_path.is_file() or sha256(source_path) != carried.get("source_sha256"):
            raise SystemExit(f"{plan_path}: source verdict file changed or is missing for {record_id}")
        source_doc = bm.load_json(source_path)
        if errors := bm.review_file_problems(source_doc):
            raise SystemExit(f"{source_path}: {errors[0]}")
        if (
            source_doc.get("commit") != reviewed
            or source_doc.get("reviewer") != reviewer
            or source_doc.get("records", {}).get(record_id, {}).get("verdict") != "accept"
        ):
            raise SystemExit(f"{plan_path}: source verdict does not support carry for {record_id}")
        original_manifest, original_bytes = _manifest_for(reviewed)
        original_entries = {item["id"]: item for item in original_manifest["entries"]}
        if record_id not in original_entries or not _same_record_inputs(
            reviewed,
            candidate,
            original_entries[record_id],
            original_bytes[record_id],
            new_bytes[record_id],
        ):
            raise SystemExit(f"{plan_path}: changed source inputs for {record_id}")
        reviewer_doc = by_reviewer.setdefault(reviewer, {"reviewer": reviewer, "commit": candidate, "records": {}})
        reviewer_doc["records"][record_id] = {"verdict": "accept"}
    reviewable = {
        record_id for record_id, item in new_entries.items() if item.get("status") in {"implemented", "verified"}
    }
    carried_ids = {record_id for document in by_reviewer.values() for record_id in document["records"]}
    if carried_ids & set(redo) or carried_ids | set(redo) != reviewable:
        raise SystemExit(f"{plan_path}: carried and redo IDs do not partition the reviewable manifest")
    return list(by_reviewer.values()), set(redo), chunks


@app.command
def promote(
    run: int,
    verdicts: list[Path] | None = None,
    *,
    platforms: list[str] | None = None,
    carry_plan: Path | None = None,
) -> None:
    """Mark accepted records verified; --carry-plan permits only revalidated identical verdicts."""
    info = checked_run(run)
    jobs = {j["name"]: j["conclusion"] for j in info["jobs"]}
    if issues := shared_check_problems(jobs):
        raise SystemExit(issues[0].message)
    docs = []
    for path in verdicts or []:
        if path.resolve().parent != bm.REVIEWS.resolve() or not path.name.endswith(".verdicts.json"):
            raise SystemExit(f"{path}: verdict files live in {bm.REVIEWS} as <slice>.verdicts.json")
        doc = bm.load_json(path)
        if errors := bm.review_file_problems(doc):
            raise SystemExit(f"{path}: {'; '.join(errors)}")
        if contains_placeholder(doc) or doc.get("reviewer", "").endswith(":"):
            raise SystemExit(f"{path}: reviewer verdict contains a placeholder")
        require_verdict_commit(path, doc, info["headSha"])
        docs.append(doc)
    if carry_plan is not None:
        carried_docs, redo_ids, chunks = carried_review_docs(carry_plan, info["headSha"])
        fresh_ids = [record_id for document in docs for record_id in document["records"]]
        if any(verdict["verdict"] == "finding" for document in docs for verdict in document["records"].values()):
            raise SystemExit("cannot promote an incremental review round with findings; adjudicate and re-review")
        if len(fresh_ids) != len(set(fresh_ids)) or set(fresh_ids) != redo_ids:
            raise SystemExit("fresh verdicts must cover each and only each planned redo record")
        slice_plan = bm.load_json(bm.REVIEWS / "slices.json")
        expected_slices = {f"redo-{index:03d}": chunk for index, chunk in enumerate(chunks, start=1)}
        actual_slices = {item["slice"]: item["records"] for item in slice_plan.get("slices", [])}
        if slice_plan.get("commit") != info["headSha"] or actual_slices != expected_slices:
            raise SystemExit("slices.json does not match the frozen candidate carry plan")
        for document in docs:
            expected = expected_slices.get(document.get("slice"))
            if expected is None or set(document["records"]) != set(expected):
                raise SystemExit(f"{document.get('slice')}: verdict output differs from its exact planned chunk")
        carried_ids = {record_id for document in carried_docs for record_id in document["records"]}
        if carried_ids & redo_ids:
            raise SystemExit("carry plan overlaps its redo set")
        docs.extend(carried_docs)
    selected_platforms = list(TESTS) if platforms is None else platforms
    if not selected_platforms or len(selected_platforms) != len(set(selected_platforms)):
        raise SystemExit("--platforms must name one or more distinct CI platforms")
    unknown_platforms = sorted(set(selected_platforms) - set(TESTS))
    if unknown_platforms:
        raise SystemExit(f"unknown --platforms: {', '.join(unknown_platforms)}; choose from {', '.join(TESTS)}")
    inputs = bm.load_inputs()
    manifest: dict[str, Any] = bm.load_json(bm.MANIFEST)
    eligible = {
        ident
        for ident, entry in inputs.index.items()
        if bm.counted(entry) and any(bm.availability(inputs.inventory, entry)[p] == "yes" for p in selected_platforms)
    }
    blocked: dict[str, list[str]] = {}
    with tempfile.TemporaryDirectory(prefix="rackpy-promote-") as scratch:
        root = Path(scratch)
        download(run, root)
        selection_issues = [issue for platform in selected_platforms for issue in selection_problems(root, platform)]
        if selection_issues:
            raise SystemExit("; ".join(issue.message for issue in selection_issues))
        for platform in selected_platforms:
            try:
                outcomes = platform_outcomes(root, platform)
            except bm.ManifestError as e:
                raise SystemExit(f"run {run} has no evidence for {platform}: {e}") from None
            for problem in bm.evidence_problems(inputs, manifest, platform, outcomes)[0]:
                blocked.setdefault(problem.id, []).append(platform)
    check_checkout(info["headSha"])
    promoted, skipped = bm.promote_records(manifest, docs, blocked, eligible=eligible)
    bm.MANIFEST.write_text(bm.dumps(manifest), encoding="utf-8", newline="\n")
    for ident, why in sorted(skipped.items()):
        print(f"not promoted: {ident}: {why}")
    print(f"{len(promoted)} records verified, {len(skipped)} not; now run bin/generate_bindings.py generate")


def markdown(run: int, info: dict[str, Any], jobs: dict[str, str], summary: dict[str, Any]) -> str:
    def counts(d: dict[str, int] | None) -> str:
        return ", ".join(f"{k} {v}" for k, v in (d or {}).items()) or "—"

    def issues(entry: dict[str, Any], key: str) -> str:
        doc = entry.get(key)
        return "not judged" if doc is None else "none" if not doc["count"] else counts(doc["by_code"])

    unsuccessful = ", ".join(f"{n} ({c})" for n, c in sorted(jobs.items()) if c != "success")
    lines = [
        "# Release evidence",
        "",
        "**Generated by `bin/release-evidence collect`; do not edit by hand.** What it means: [README](README.md).",
        "",
        f"- CI run: [{run}]({info['url']}), commit `{info['headSha']}` (branch `{info['headBranch']}`)",
        f"- Jobs not successful: {unsuccessful or 'none'}",
        "",
        "| Platform | Tests | Bound records | Record problems | Samples | Sample problems | Release bar |",
        "| --- | --- | --- | --- | --- | --- | --- |",
    ]
    for platform, entry in summary.items():
        if "error" in entry:
            lines.append(f"| {platform} | {entry['error']} | | | | | |")
            continue
        lines.append(
            f"| {platform} | {counts(entry['tests'])} | {counts(entry['records'])} | "
            f"{issues(entry, 'evidence_problems')} | {counts(entry['samples'])} | "
            f"{issues(entry, 'sample_problems')} | {issues(entry, 'release_problems')} |"
        )
    lines += [
        "",
        "Each platform's problems are listed in `coverage/<platform>.json` (the first 40 of each kind of check).",
    ]
    return "\n".join(lines) + "\n"


if __name__ == "__main__":
    try:
        app()
    except bm.ManifestError as e:
        raise SystemExit(f"error: {e}") from None
