#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["cyclopts>=5.2,<6"]
#
# [tool.uv]
# exclude-newer = "2026-10-21T00:00:00Z"
# ///
"""Build, bundle, inspect and check the RackPy plugin skeleton (RP-08).

Every input is pinned: the Rack SDK by bin/rack-sdk, the bundled CPython by
packaging/inputs.json, and pybind11 and the Python tools by uv.lock. Downloads
and builds stay outside git. Tools from the project environment run through
`uv run --frozen --project <repo>`, so `uv sync --frozen` must work first.

Linux x86_64 and macOS (arm64, x86_64; RP-40). A build with the host compiler is
for development and tests; `--toolchain rack-lin-x64` uses the official Rack
plugin toolchain (bin/rack-toolchain) for a build with the glibc floor of Rack's
own plugins. `--platform mac-arm64 --toolchain zig-macos` cross-compiles the
macOS plugin on Linux to check that it compiles and links: Zig links its own
libc++, so such a build must never be run in Rack or distributed.
"""

import hashlib
import json
import os
import platform as platform_module
import re
import shutil
import statistics
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
from pathlib import Path
from typing import Annotated, Any, Literal

import cyclopts

REPO = Path(__file__).resolve().parent.parent
INPUTS = REPO / "packaging" / "inputs.json"
TOOLCHAIN_FILE = REPO / "cmake" / "toolchains" / "rack-lin-x64.cmake"
ZIG_TOOLCHAIN_FILE = REPO / "cmake" / "toolchains" / "zig-macos.cmake"
WIN_TOOLCHAIN_FILE = REPO / "cmake" / "toolchains" / "rack-win-x64.cmake"
DEFAULT_CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "rackpy" / "build-inputs"
DEFAULT_BUILD = REPO / "build" / "dev"
SLUG = "RackPy"
HOST_EXPORTS = {
    "rackpy_host_init",
    "rackpy_host_destroy",
    "rackpy_host_settings_to_json",
    "rackpy_host_settings_from_json",
}
LINKER_SYMBOLS = {"__bss_start", "_edata", "_end"}
LOADER_EXPORTS = {"init", "destroy", "settingsToJson", "settingsFromJson"}

app = cyclopts.App(help=__doc__)
CacheOpt = Annotated[Path, cyclopts.Parameter(help="Download cache outside git.")]
Toolchain = Literal["host", "rack-lin-x64", "rack-win-x64", "zig-macos"]
Platform = Literal["lin-x64", "mac-x64", "mac-arm64", "win-x64"]
OSX_ARCHITECTURES = {"mac-x64": "x86_64", "mac-arm64": "arm64"}


def host_platform() -> Platform:
    """Rack's name for this computer's platform."""
    if sys.platform == "darwin":
        return "mac-arm64" if platform_module.machine() == "arm64" else "mac-x64"
    if sys.platform == "win32":
        return "win-x64"
    return "lin-x64"


Sanitize = Literal["", "address,undefined", "thread"]


def run(args: list[str | Path], **kwargs: Any) -> str:
    """Run a command, echoing it; return stdout when capture is requested."""
    printable = " ".join(str(a) for a in args)
    print(f"+ {printable}", flush=True)
    proc = subprocess.run([str(a) for a in args], check=False, text=True, **kwargs)
    if proc.returncode:
        detail = f"\n{proc.stderr}" if kwargs.get("capture_output") and proc.stderr else ""
        raise SystemExit(f"command failed with exit status {proc.returncode}: {printable}{detail}")
    return proc.stdout or ""


def capture(args: list[str | Path]) -> str:
    return run(args, capture_output=True).strip()


def bin_tool(name: str) -> list[str | Path]:
    """The command that runs another bin/ script: itself, or on Windows (no shebangs) through uv."""
    path = REPO / "bin" / name
    return ["uv", "run", "--script", path] if sys.platform == "win32" else [path]


def project_tool(*args: str) -> list[str | Path]:
    return ["uv", "run", "--frozen", "--project", REPO, *args]


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def fetch_runtime(entry: dict[str, Any], cache: Path) -> Path:
    archive: Path = cache / "archives" / entry["file"]
    if not archive.exists() or sha256_file(archive) != entry["sha256"]:
        archive.parent.mkdir(parents=True, exist_ok=True)
        partial = archive.with_name(archive.name + ".partial")
        with urllib.request.urlopen(entry["url"], timeout=300) as response, partial.open("wb") as out:
            shutil.copyfileobj(response, out)
        partial.replace(archive)
    if (actual := sha256_file(archive)) != entry["sha256"]:
        raise SystemExit(f"{entry['file']}: sha256 {actual} does not match pinned {entry['sha256']}")
    dest = cache / "extracted" / entry["sha256"][:16]
    if not dest.is_dir():
        cache.mkdir(parents=True, exist_ok=True)
        staging = Path(tempfile.mkdtemp(prefix="extract-", dir=cache))
        with tarfile.open(archive) as tf:
            tf.extractall(staging, filter="data")
        dest.parent.mkdir(parents=True, exist_ok=True)
        staging.replace(dest)
    root: Path = dest / entry["root"]
    return root


def runtime(cache: Path, platform: Platform, minor: str = "3.14") -> Path:
    pins: dict[str, dict[str, Any]] = json.loads(INPUTS.read_text(encoding="utf-8"))["python_runtime"]
    return fetch_runtime(pins[minor][platform], cache)


@app.command
def inputs(*, platform: Platform | None = None, cache: CacheOpt = DEFAULT_CACHE) -> None:
    """Fetch and verify the pinned bundled runtime for PLATFORM (this computer's by default); print its location."""
    target = platform or host_platform()
    print(json.dumps({f"python-3.14-{target}": str(runtime(cache, target))}, indent=2, sort_keys=True))


def cmake_cache_value(build_dir: Path, name: str) -> str:
    for line in (build_dir / "CMakeCache.txt").read_text(encoding="utf-8").splitlines():
        if line.startswith(f"{name}:"):
            return line.split("=", 1)[1]
    raise SystemExit(f"{build_dir} is not a configured RackPy build (no {name} in CMakeCache.txt)")


@app.command
def configure(
    *,
    build_dir: Path = DEFAULT_BUILD,
    toolchain: Toolchain = "host",
    platform: Platform | None = None,
    werror: bool = False,
    test_hooks: bool = False,
    entry: str = "",
    sanitize: Sanitize = "",
    cache: CacheOpt = DEFAULT_CACHE,
) -> None:
    """Configure the CMake build with the pinned SDK, runtime and pybind11, for PLATFORM (this computer's).

    --test-hooks adds the RuntimeProbe module and _rackpy_host._testing for the runtime tests.
    --sanitize builds every native target with AddressSanitizer and UndefinedBehaviorSanitizer
    ("address,undefined") or ThreadSanitizer ("thread"), for the native tests. Never distribute
    either kind of build.
    """
    target = platform or host_platform()
    cross = {"zig-macos": ("mac-x64", "mac-arm64"), "rack-win-x64": ("win-x64",)}
    if target != host_platform() and target not in cross.get(toolchain, ()):
        raise SystemExit(
            f"a {target} build on {host_platform()} needs a cross toolchain: zig-macos (macOS) or rack-win-x64"
        )
    if toolchain in cross and target not in cross[toolchain]:
        raise SystemExit(f"--toolchain {toolchain} builds for {' or '.join(cross[toolchain])}, not {target}")
    sdk = capture([*bin_tool("rack-sdk"), "path", target])
    python = runtime(cache, target)
    pybind11 = capture(project_tool("python", "-m", "pybind11", "--cmakedir"))
    args: list[str | Path] = [
        "cmake",
        "-S",
        REPO,
        "-B",
        build_dir,
        "-G",
        "Ninja",
        f"-DRACK_SDK_DIR={sdk}",
        f"-DRACKPY_PYTHON_HOME={python}",
        f"-Dpybind11_DIR={pybind11}",
        f"-DRACKPY_WERROR={'ON' if werror else 'OFF'}",
        f"-DRACKPY_ENTRY={entry}",
        f"-DRACKPY_TEST_HOOKS={'ON' if test_hooks else 'OFF'}",
        f"-DRACKPY_SANITIZE={sanitize}",
    ]
    if target in OSX_ARCHITECTURES:
        args.append(f"-DCMAKE_OSX_ARCHITECTURES={OSX_ARCHITECTURES[target]}")
    if target == "win-x64" and toolchain == "host":
        # The native tests run outside Rack and need Rack's DLLs beside them.
        args.append(f"-DRACK_HOST_DIR={capture([*bin_tool('rack-sdk'), 'host', target]).splitlines()[-1]}")
    if toolchain == "rack-win-x64":
        bindir = capture([*bin_tool("rack-toolchain"), "path", "--target", "win-x64"])
        args += [
            f"-DCMAKE_TOOLCHAIN_FILE={WIN_TOOLCHAIN_FILE}",
            f"-DRACK_TOOLCHAIN_BIN={bindir}",
            "-DRACKPY_BUILD_TESTS=OFF",
        ]
    if toolchain == "zig-macos":
        # A compile and link check only (see the module docstring); native tests cannot run here.
        args += [f"-DCMAKE_TOOLCHAIN_FILE={ZIG_TOOLCHAIN_FILE}", "-DRACKPY_BUILD_TESTS=OFF"]
    if toolchain == "rack-lin-x64":
        bindir = capture([*bin_tool("rack-toolchain"), "path"])
        # Native tests link libRack's X11/GL/audio dependencies, which the toolchain sysroot lacks.
        args += [
            f"-DCMAKE_TOOLCHAIN_FILE={TOOLCHAIN_FILE}",
            f"-DRACK_TOOLCHAIN_BIN={bindir}",
            "-DRACKPY_BUILD_TESTS=OFF",
        ]
    run(args)


@app.command
def build(
    *,
    build_dir: Path = DEFAULT_BUILD,
    toolchain: Toolchain = "host",
    platform: Platform | None = None,
    werror: bool = False,
    test_hooks: bool = False,
    test: bool = True,
    sanitize: Sanitize = "",
    cache: CacheOpt = DEFAULT_CACHE,
) -> None:
    """Configure, build and run the native unit tests (CTest)."""
    configure(
        build_dir=build_dir,
        toolchain=toolchain,
        platform=platform,
        werror=werror,
        test_hooks=test_hooks,
        sanitize=sanitize,
        cache=cache,
    )
    run(["cmake", "--build", build_dir])
    if test and toolchain == "host":
        run(["ctest", "--test-dir", build_dir, "--output-on-failure"])


@app.command
def bundle(
    dest: Path,
    *,
    build_dir: Path = DEFAULT_BUILD,
    runtime: Literal["link", "copy"] = "link",
    cache: CacheOpt = DEFAULT_CACHE,
) -> None:
    """Install a built tree as DEST/RackPy, a Rack plugin directory, with the runtime as python/.

    `--runtime link` symlinks the cached runtime (fast, for tests on this
    machine; on Windows it copies). `--runtime copy` copies it and strips the binaries.
    """
    plugin = dest / SLUG
    if plugin.exists():
        raise SystemExit(f"{plugin} already exists; choose an empty destination")
    run(["cmake", "--install", build_dir, "--prefix", plugin, *(["--strip"] if runtime == "copy" else [])])
    python = Path(cmake_cache_value(build_dir, "RACKPY_PYTHON_HOME"))  # the runtime this tree was built for
    if runtime == "link" and sys.platform == "win32":
        runtime = "copy"  # a symlink needs administrator rights or Developer Mode on Windows
        print("note: Windows: the runtime is copied, not linked")
    if runtime == "link":
        (plugin / "python").symlink_to(python, target_is_directory=True)
    else:
        shutil.copytree(python, plugin / "python", symlinks=True)
    print(plugin)


def dynamic_facts(path: Path) -> dict[str, Any]:
    dynamic = capture(["readelf", "-d", "-W", path])
    exported = capture(["nm", "-D", "--defined-only", path])
    undefined = capture(["nm", "-D", "--undefined-only", path])
    versions = capture(["objdump", "-T", path])
    glibc = sorted(set(re.findall(r"GLIBC_([0-9.]+)", versions)), key=lambda v: tuple(map(int, v.split("."))))
    return {
        "needed": re.findall(r"\(NEEDED\)\s+Shared library: \[(.+?)\]", dynamic),
        "runpath": re.findall(r"\((?:RUNPATH|RPATH)\)\s+Library (?:runpath|rpath): \[(.+?)\]", dynamic),
        "exports": sorted({line.split()[-1] for line in exported.splitlines()} - LINKER_SYMBOLS),
        "python_references": sorted(
            {line.split()[-1] for line in undefined.splitlines() if line.split()[-1].startswith(("Py", "_Py"))}
        ),
        "max_glibc": glibc[-1] if glibc else None,
    }


# Symbols every Mach-O image defines, which are not part of an ABI.
MACH_O_LINKER_SYMBOLS = {"___dso_handle", "__mh_dylib_header", "__mh_bundle_header", "__mh_execute_header"}


def mach_o_tool(name: str) -> str:
    """Apple's otool or nm on a Mac (Xcode's command line tools); LLVM's elsewhere, whose output is the same."""
    for candidate in (name, f"llvm-{name}") if sys.platform == "darwin" else (f"llvm-{name}",):
        if shutil.which(candidate):
            return candidate
    raise SystemExit(f"no {name}: install Xcode's command line tools (xcode-select --install)")


def load_commands(path: Path) -> list[dict[str, str]]:
    """A Mach-O file's load commands, from otool -l: each command's fields by name (cmd, name, path, minos...)."""
    commands: list[dict[str, str]] = []
    for line in capture([mach_o_tool("otool"), "-l", path]).splitlines():
        fields = line.split(None, 1)
        if line.startswith("Load command"):
            commands.append({})
        elif commands and len(fields) == 2:
            commands[-1].setdefault(fields[0], re.sub(r" \(offset \d+\)$", "", fields[1].strip()))
    return commands


def mach_o_facts(path: Path) -> dict[str, Any]:
    commands = load_commands(path)
    nm = mach_o_tool("nm")
    exported = capture([nm, "-gU", path])
    undefined = capture([nm, "-u", path])

    def c_name(symbol: str) -> str:  # Mach-O prefixes C names with an underscore
        return symbol.removeprefix("_")

    return {
        "needed": [c["name"] for c in commands if c.get("cmd") in {"LC_LOAD_DYLIB", "LC_LOAD_WEAK_DYLIB"}],
        "install_name": next((c["name"] for c in commands if c.get("cmd") == "LC_ID_DYLIB"), None),
        "runpath": [c["path"] for c in commands if c.get("cmd") == "LC_RPATH"],
        "exports": sorted(
            {c_name(line.split()[-1]) for line in exported.splitlines() if line.strip()}
            - {c_name(s) for s in MACH_O_LINKER_SYMBOLS}
        ),
        "python_references": sorted(
            {
                c_name(line.split()[-1])
                for line in undefined.splitlines()
                if c_name(line.strip()).startswith(("Py", "_Py"))
            }
        ),
    }


def inspect_mac(plugin: Path) -> tuple[dict[str, Any], list[str]]:
    """inspect's checks for a macOS bundle: plugin.dylib and rackpy_host.so, as cmake/RackSDK.cmake links them."""
    loader = mach_o_facts(plugin / "plugin.dylib")
    host = mach_o_facts(plugin / "rackpy_host.so")
    found: list[str] = []
    if loader["python_references"]:
        found.append(f"plugin.dylib references Python symbols: {loader['python_references'][:5]}")
    if "libpython" in " ".join(loader["needed"]):
        found.append("plugin.dylib links libpython; the loader must not depend on Python")
    if not set(loader["exports"]) >= LOADER_EXPORTS:
        found.append(f"plugin.dylib does not export {sorted(LOADER_EXPORTS)}")
    if set(host["exports"]) != HOST_EXPORTS:
        found.append(f"rackpy_host.so exports {sorted(set(host['exports']) ^ HOST_EXPORTS)} beyond the host ABI")
    if loader["runpath"]:
        found.append(f"plugin.dylib has rpaths {loader['runpath']}; it needs none")
    if host["runpath"] != ["@loader_path/python/lib"]:
        found.append(f"rackpy_host.so's rpaths are {host['runpath']}, expected ['@loader_path/python/lib']")
    if "@rpath/libpython3.14.dylib" not in host["needed"]:
        found.append("rackpy_host.so does not link @rpath/libpython3.14.dylib, the bundled runtime")
    # Rack symlinks /tmp/Rack2 to its own folder only while it loads plugin.dylib (plugin.mk links plugins
    # so); the host, loaded later, must find Rack's symbols in the loaded libRack instead.
    if "/tmp/Rack2/libRack.dylib" not in loader["needed"]:
        found.append("plugin.dylib does not link /tmp/Rack2/libRack.dylib")
    if any("libRack" in n for n in host["needed"]):
        found.append("rackpy_host.so links libRack; /tmp/Rack2 is gone by the time the loader opens it")
    for name, facts in (("plugin.dylib", loader), ("rackpy_host.so", host)):
        if facts["install_name"] != f"@rpath/{name}":
            found.append(f"{name}'s install name is {facts['install_name']}, expected @rpath/{name}")
    report = {"plugin.dylib": loader, "rackpy_host.so": host}
    report["rackpy_host.so"]["python_references"] = len(host["python_references"])
    return report, found


def pe_facts(path: Path) -> dict[str, Any]:
    """A PE (Windows) DLL's imported DLL names and exported names, read from its import and export tables."""
    import struct

    data = path.read_bytes()
    if data[:2] != b"MZ":
        raise SystemExit(f"{path} is not a PE file")
    pe = struct.unpack_from("<I", data, 0x3C)[0]
    if data[pe : pe + 4] != b"PE\0\0":
        raise SystemExit(f"{path} has no PE signature")
    machine, sections, _, _, _, optional_size, _ = struct.unpack_from("<HHIIIHH", data, pe + 4)
    optional = pe + 24
    if struct.unpack_from("<H", data, optional)[0] != 0x20B:
        raise SystemExit(f"{path} is not PE32+ (64-bit)")
    directories = optional + 112  # PE32+: the data directories follow 112 bytes of fixed fields
    table = optional + optional_size
    spans = [struct.unpack_from("<IIII", data, table + 40 * i + 8) for i in range(sections)]  # vsize, va, rawsize, raw

    def offset(rva: int) -> int:
        for vsize, va, rawsize, raw in spans:
            if va <= rva < va + max(vsize, rawsize):
                return int(raw + rva - va)
        raise SystemExit(f"{path}: RVA {rva:#x} is in no section")

    def text(rva: int) -> str:
        start = offset(rva)
        return data[start : data.index(b"\0", start)].decode("ascii")

    export_rva, export_size = struct.unpack_from("<II", data, directories)
    exports: list[str] = []
    if export_rva and export_size:
        # IMAGE_EXPORT_DIRECTORY: NumberOfNames at 24, AddressOfNames at 32
        names = struct.unpack_from("<I", data, offset(export_rva) + 24)[0]
        names_rva = struct.unpack_from("<I", data, offset(export_rva) + 32)[0]
        exports = sorted(text(struct.unpack_from("<I", data, offset(names_rva) + 4 * i)[0]) for i in range(names))
    import_rva = struct.unpack_from("<I", data, directories + 8)[0]
    needed: list[str] = []
    if import_rva:
        descriptor = offset(import_rva)
        while name_rva := struct.unpack_from("<I", data, descriptor + 12)[0]:
            needed.append(text(name_rva))
            descriptor += 20
    return {"machine": hex(machine), "needed": needed, "exports": exports}


# What RackPy's own DLLs may import on Windows: Rack's DLLs (already loaded by Rack.exe), the C runtime Rack
# uses, Windows itself, and for the host the bundled CPython, which the loader loads first by its full path.
WINDOWS_RACK_DLLS = {"librack.dll", "libgcc_s_seh-1.dll", "libwinpthread-1.dll", "libstdc++-6.dll"}
WINDOWS_SYSTEM_DLLS = {
    "kernel32.dll",
    "msvcrt.dll",
    "user32.dll",
    "advapi32.dll",
    "shell32.dll",
    "ole32.dll",
    "ws2_32.dll",
}


def inspect_windows(plugin: Path) -> tuple[dict[str, Any], list[str]]:
    """inspect's checks for a Windows bundle: plugin.dll and rackpy_host.dll."""
    loader = pe_facts(plugin / "plugin.dll")
    host = pe_facts(plugin / "rackpy_host.dll")
    found: list[str] = []
    for name, facts in (("plugin.dll", loader), ("rackpy_host.dll", host)):
        if facts["machine"] != "0x8664":
            found.append(f"{name} is not an x86-64 DLL ({facts['machine']})")
        allowed = WINDOWS_RACK_DLLS | WINDOWS_SYSTEM_DLLS | ({"python314.dll"} if name == "rackpy_host.dll" else set())
        if extra := sorted(d for d in facts["needed"] if d.lower() not in allowed):
            found.append(f"{name} imports {extra}, outside Rack, Windows and (the host) the bundled python314.dll")
        if any(
            d.lower() in {"ucrtbase.dll", "vcruntime140.dll"} or d.lower().startswith("api-ms-win-crt")
            for d in facts["needed"]
        ):
            found.append(f"{name} uses the UCRT; Rack for Windows and RackPy's DLLs use msvcrt.dll")
    if any("python" in d.lower() for d in loader["needed"]):
        found.append("plugin.dll imports Python; the loader must not depend on Python")
    if set(loader["exports"]) != LOADER_EXPORTS:
        found.append(
            f"plugin.dll exports {sorted(set(loader['exports']) ^ LOADER_EXPORTS)} beyond Rack's plugin entry points"
        )
    if set(host["exports"]) != HOST_EXPORTS:
        found.append(f"rackpy_host.dll exports {sorted(set(host['exports']) ^ HOST_EXPORTS)} beyond the host ABI")
    if "python314.dll" not in [d.lower() for d in host["needed"]]:
        found.append("rackpy_host.dll does not import python314.dll, the bundled runtime")
    return {"plugin.dll": loader, "rackpy_host.dll": host}, found


def version_tuple(version: str) -> tuple[int, ...]:
    return tuple(int(p) for p in version.split("."))


@app.command
def inspect(plugin: Path, *, max_glibc: str | None = None) -> None:
    """Check a bundled plugin directory's loader and host and print their dynamic facts as JSON.

    Fails if the loader references Python, if either library exports more than
    the RackPy ABI, if the RUNPATHs differ from ADR 002, or if a library needs a
    glibc newer than --max-glibc. A macOS bundle (plugin.dylib) gets the same checks
    for Mach-O, with its install names and rpaths, and a Windows bundle (plugin.dll) for PE:
    imports only from Rack, msvcrt and Windows (the host also the bundled python314.dll), and
    exports only the ABI; --max-glibc applies to neither.
    """
    if (plugin / "plugin.dll").is_file():
        win_report, problems = inspect_windows(plugin)
        print(json.dumps(win_report, indent=2))
        if problems:
            raise SystemExit("bundle problems:\n" + "\n".join(f"- {p}" for p in problems))
        return
    if (plugin / "plugin.dylib").is_file():
        mac_report, problems = inspect_mac(plugin)
        print(json.dumps(mac_report, indent=2))
        if problems:
            raise SystemExit("bundle problems:\n" + "\n".join(f"- {p}" for p in problems))
        return
    loader = dynamic_facts(plugin / "plugin.so")
    host = dynamic_facts(plugin / "rackpy_host.so")
    found: list[str] = []
    if loader["python_references"]:
        found.append(f"plugin.so references Python symbols: {loader['python_references'][:5]}")
    if "libpython" in " ".join(loader["needed"]):
        found.append("plugin.so links libpython; the loader must not depend on Python")
    if not set(loader["exports"]) >= LOADER_EXPORTS:
        found.append(f"plugin.so does not export {sorted(LOADER_EXPORTS)}")
    if set(host["exports"]) != HOST_EXPORTS:
        found.append(f"rackpy_host.so exports {sorted(set(host['exports']) ^ HOST_EXPORTS)} beyond the host ABI")
    if loader["runpath"] != ["/tmp/Rack2"]:
        found.append(f"plugin.so RUNPATH is {loader['runpath']}, expected ['/tmp/Rack2']")
    if host["runpath"] != ["/tmp/Rack2:$ORIGIN/python/lib"]:
        found.append(f"rackpy_host.so RUNPATH is {host['runpath']}, expected ['/tmp/Rack2:$ORIGIN/python/lib']")
    for name, facts in (("plugin.so", loader), ("rackpy_host.so", host)):
        if "libRack.so" not in facts["needed"]:
            found.append(f"{name} does not link libRack.so")
        if any("libstdc++" in n or "libgcc_s" in n for n in facts["needed"]):
            found.append(f"{name} links the C++ runtime dynamically; the SDK requires static libstdc++/libgcc")
        if max_glibc and facts["max_glibc"] and version_tuple(facts["max_glibc"]) > version_tuple(max_glibc):
            found.append(f"{name} needs GLIBC_{facts['max_glibc']}, newer than {max_glibc}")
    report = {"plugin.so": loader, "rackpy_host.so": host}
    report["rackpy_host.so"]["python_references"] = len(host["python_references"])
    print(json.dumps(report, indent=2))
    if found:
        raise SystemExit("bundle problems:\n" + "\n".join(f"- {p}" for p in found))


@app.command(name="audio-symbols")
def audio_symbols(objects: list[Path]) -> None:
    """Fail if any object or library references a CPython symbol (ADR 004 audio-path rule)."""
    offenders: dict[str, list[str]] = {}
    for obj in objects:
        if sys.platform == "darwin":  # Apple's nm; Mach-O prefixes C names with one more underscore
            listing = capture(["nm", "-u", "-j", obj])
            names = [s.removeprefix("_") for s in listing.split()]
        else:
            names = capture(["nm", "--undefined-only", "--format=just-symbols", obj]).split()
        refs = sorted({s for s in names if s.startswith(("Py", "_Py"))})
        if refs:
            offenders[str(obj)] = refs
    if offenders:
        raise SystemExit("CPython symbols on the audio path:\n" + json.dumps(offenders, indent=2))
    print(f"ok: {len(objects)} file(s) reference no CPython symbols")


def rack_log_times(log: str) -> dict[str, float]:
    """Seconds since Rack started for each first occurrence of the markers RackPy start-up passes."""
    markers = {
        "load_start": "Loading plugin from",
        "interpreter": "RackPy interpreter started",
        "host_ready": "RackPy host rackpy_host.so ready",
        "loaded": f"Loaded plugin {SLUG} ",
    }
    found: dict[str, float] = {}
    for line in log.splitlines():
        for key, marker in markers.items():
            if key not in found and marker in line and (key != "load_start" or line.rstrip().endswith(f"/{SLUG}")):
                found[key] = float(line[1:].split()[0])
    return found


def measure_rack(rack: Path, plugin: Path | None) -> dict[str, Any]:
    with tempfile.TemporaryDirectory(prefix="rackpy-startup-") as tmp:
        user = Path(tmp)
        if plugin:
            shutil.copytree(plugin, user / "plugins-lin-x64" / SLUG, symlinks=True)
        (user / "autosave").mkdir()
        (user / "autosave" / "patch.json").write_text('{"version": "2.6.6", "modules": [], "cables": []}')
        env = {k: v for k, v in os.environ.items() if k not in {"DISPLAY", "WAYLAND_DISPLAY"}}
        proc = subprocess.Popen(
            [rack / "Rack", "-h", "-u", user],
            cwd=rack,
            stdin=subprocess.PIPE,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            env=env,
        )
        log = user / "log.txt"
        deadline = time.monotonic() + 60
        while time.monotonic() < deadline and not (log.exists() and "Loading autosave" in log.read_text()):
            time.sleep(0.05)
        time.sleep(0.5)
        status = Path(f"/proc/{proc.pid}/status").read_text()
        rss = {
            k: int(v.split()[0])
            for k, v in (line.split(":", 1) for line in status.splitlines())
            if k in {"VmRSS", "VmHWM"}
        }
        assert proc.stdin is not None
        proc.stdin.write(b"\n")
        proc.stdin.close()
        proc.wait(timeout=60)
        text = log.read_text()
        times = rack_log_times(text)
        result: dict[str, Any] = {"rss_kib": rss["VmRSS"], "peak_rss_kib": rss["VmHWM"], "exit": proc.returncode}
        if plugin:
            if "loaded" not in times or "interpreter" not in times:
                raise SystemExit("RackPy did not load:\n" + text[-3000:])
            result["plugin_init_ms"] = round((times["loaded"] - times["load_start"]) * 1000, 1)
        return result


@app.command
def startup(plugin: Path, *, runs: int = 5) -> None:
    """Measure RackPy's start-up cost in headless Rack Free; print the raw runs and medians as JSON.

    Alternates runs without and with PLUGIN (a bundled plugin directory) in
    fresh user directories. plugin_init_ms comes from Rack's log timestamps
    (millisecond resolution) between "Loading plugin from .../RackPy" and
    "Loaded plugin RackPy"; RSS comes from /proc after the patch has loaded.
    """
    rack = Path(capture([*bin_tool("rack-sdk"), "host"]))
    raw: dict[str, list[dict[str, Any]]] = {"without_rackpy": [], "with_rackpy": []}
    for _ in range(runs):
        raw["without_rackpy"].append(measure_rack(rack, None))
        raw["with_rackpy"].append(measure_rack(rack, plugin))

    def median(variant: str, key: str) -> float:
        return float(statistics.median(r[key] for r in raw[variant]))

    summary = {
        "plugin_init_ms_median": median("with_rackpy", "plugin_init_ms"),
        "rss_delta_kib_median": median("with_rackpy", "rss_kib") - median("without_rackpy", "rss_kib"),
        "peak_rss_delta_kib_median": median("with_rackpy", "peak_rss_kib") - median("without_rackpy", "peak_rss_kib"),
    }
    print(json.dumps({"runs": raw, "summary": summary}, indent=2))


def scripts() -> list[Path]:
    """Python utilities in bin/ without a .py suffix (mypy needs one run per __main__ module)."""
    found = []
    for path in sorted((REPO / "bin").iterdir()):
        if path.is_file() and not path.suffix:
            with path.open(encoding="utf-8", errors="replace") as f:
                if "uv run" in f.readline():
                    found.append(path)
    return found


@app.command
def lint() -> None:
    """Ruff lint and format checks over the repository, including bin/ scripts."""
    run(project_tool("ruff", "check", str(REPO)), cwd=REPO)
    run(project_tool("ruff", "format", "--check", str(REPO)), cwd=REPO)


@app.command
def typecheck() -> None:
    """Strict mypy over src/, tests/ and every bin/ utility."""
    run(project_tool("mypy"), cwd=REPO)
    for script in scripts():
        run(project_tool("mypy", "--strict", str(script.relative_to(REPO))), cwd=REPO)


if __name__ == "__main__":
    # This script runs in its own uv environment; project tools must use the project's.
    os.environ.pop("VIRTUAL_ENV", None)
    app()
