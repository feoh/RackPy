#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["cyclopts>=5.2,<6"]
#
# [tool.uv]
# exclude-newer = "2026-10-21T00:00:00Z"
# ///
"""Capture the official VCV Rack manual pages and check them against upstream/examples.json (RP-03).

The manual is a mutable website with no public source repository. Captured
pages stay in a cache outside git; this repository records only hashes and
classifications, never manual text.
"""

import hashlib
import html.parser
import json
import os
import urllib.request
from datetime import UTC, datetime
from pathlib import Path
from typing import Annotated, Any

import cyclopts

REPO = Path(__file__).resolve().parent.parent
EXAMPLES = REPO / "upstream" / "examples.json"
DEFAULT_CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "rackpy" / "manual"
HEADINGS = {"h1", "h2", "h3", "h4"}

app = cyclopts.App(help=__doc__)
CacheOpt = Annotated[Path, cyclopts.Parameter(help="Cache directory outside git.")]


class CodeBlocks(html.parser.HTMLParser):
    """Collect each <pre> element's unescaped text with the nearest heading anchor."""

    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.blocks: list[dict[str, str]] = []
        self._anchor = ""
        self._in_pre = False
        self._buf: list[str] = []

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        if tag in HEADINGS:
            self._anchor = dict(attrs).get("id") or ""
        elif tag == "pre":
            self._in_pre, self._buf = True, []

    def handle_endtag(self, tag: str) -> None:
        if tag == "pre" and self._in_pre:
            self._in_pre = False
            code = "".join(self._buf)
            self.blocks.append({"anchor": self._anchor, "sha256": hashlib.sha256(code.encode()).hexdigest()})

    def handle_data(self, data: str) -> None:
        if self._in_pre:
            self._buf.append(data)


def load_examples() -> dict[str, Any]:
    data: dict[str, Any] = json.loads(EXAMPLES.read_text(encoding="utf-8"))
    return data


def latest_capture(cache: Path) -> Path:
    captures = sorted(p for p in cache.glob("capture-*") if p.is_dir())
    if not captures:
        raise SystemExit(f"no capture in {cache}; run `bin/manual-sources capture` first")
    return captures[-1]


@app.command
def capture(*, cache: CacheOpt = DEFAULT_CACHE) -> None:
    """Download every recorded manual page into a new timestamped cache directory."""
    stamp = datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
    dest = cache / f"capture-{stamp}"
    dest.mkdir(parents=True)
    for name, page in load_examples()["pages"].items():
        with urllib.request.urlopen(page["url"], timeout=60) as response:
            body = response.read()
        (dest / f"{name}.html").write_bytes(body)
        print(f"{name} {hashlib.sha256(body).hexdigest()} {page['url']}")
    print(f"captured into {dest}")


@app.command
def check(capture_dir: Path | None = None, *, cache: CacheOpt = DEFAULT_CACHE) -> None:
    """Compare a capture with upstream/examples.json.

    A changed page hash alone is reported but tolerated, since navigation or
    styling may change. A changed, added or removed code block fails.
    """
    examples = load_examples()
    source = capture_dir or latest_capture(cache)
    recorded: dict[str, list[dict[str, Any]]] = {}
    for sample in examples["samples"]:
        prefix = sample["id"].split("-")[0]
        if prefix in examples["pages"] and "sha256" in sample:
            recorded.setdefault(prefix, []).append(sample)
    failures: list[str] = []
    for name, page in examples["pages"].items():
        body = (source / f"{name}.html").read_bytes()
        if hashlib.sha256(body).hexdigest() != page["sha256"]:
            print(f"note: {name} page bytes changed since {examples['retrieved_at']}")
        parser = CodeBlocks()
        parser.feed(body.decode("utf-8"))
        expected = recorded.get(name, [])
        if len(parser.blocks) != len(expected):
            failures.append(f"{name}: {len(parser.blocks)} code blocks, {len(expected)} recorded")
            continue
        for found, sample in zip(parser.blocks, expected, strict=True):
            if found["sha256"] != sample["sha256"]:
                failures.append(f"{sample['id']}: code changed ({sample['source']})")
    if failures:
        raise SystemExit("manual drift:\n" + "\n".join(failures))
    print(f"ok: {sum(len(v) for v in recorded.values())} code blocks match ({source})")


if __name__ == "__main__":
    app()
