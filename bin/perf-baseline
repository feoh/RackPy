#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["cyclopts>=5.2,<6"]
#
# [tool.uv]
# exclude-newer = "2026-10-21T00:00:00Z"
# ///
"""Reproduce the RP-07 performance and real-time measurements and write benchmarks/baseline.json.

Builds benchmarks/spike and spikes/lifecycle from pinned inputs, then runs:
signal equivalence, the audio-path guard (with injected violations), pinned
microbenchmarks with randomized A/B order, the Python laboratory, real-host
engine-meter sweeps in Rack Free headless, a cable feedback loop, and the
slow-UI and exclusive-stall checks in windowed Rack under Xvfb.

Results are from whatever machine runs this. They gate claims only when that
machine is controlled hardware; the environment block records what it was.
"""

import json
import os
import platform
import random
import shutil
import signal
import statistics
import subprocess
import tempfile
import time
from datetime import UTC, datetime
from pathlib import Path
from typing import Annotated, Any

import cyclopts

REPO = Path(__file__).resolve().parent.parent
SPIKE = REPO / "benchmarks" / "spike"
LIFECYCLE = REPO / "spikes" / "lifecycle"
OUTPUT = REPO / "benchmarks" / "baseline.json"
DEFAULT_BUILD = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "rackpy" / "perf-build"

app = cyclopts.App(help=__doc__)


def sh(*args: str, **kw: Any) -> str:
    out: str = subprocess.run(list(args), capture_output=True, text=True, check=True, **kw).stdout
    return out


def tool(*args: str) -> str:
    return sh(str(REPO / "bin" / args[0]), *args[1:])


def read(path: str) -> str | None:
    try:
        return Path(path).read_text().strip()
    except OSError:
        return None


def environment(cpus: dict[str, str]) -> dict[str, Any]:
    lscpu = sh("lscpu")
    model = next((line.split(":", 1)[1].strip() for line in lscpu.splitlines() if line.startswith("Model name")), "")
    return {
        "host": platform.node(),
        "os": platform.platform(),
        "kernel": platform.release(),
        "cpu_model": model,
        "logical_cpus": os.cpu_count(),
        "performance_cores": read("/sys/devices/cpu_core/cpus"),
        "efficiency_cores": read("/sys/devices/cpu_atom/cpus"),
        "governor": read("/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"),
        "energy_performance_preference": read("/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference"),
        "turbo_disabled": read("/sys/devices/system/cpu/intel_pstate/no_turbo"),
        "load_average_at_start": read("/proc/loadavg"),
        "pinning": cpus,
        "compilers": {"g++": sh("g++", "--version").splitlines()[0]},
        "controlled_hardware": False,
        "note": "Planning machine: governor and turbo were left as found; runs were pinned to performance cores.",
    }


def build(build_dir: Path) -> dict[str, Path]:
    inputs = json.loads(tool("spike-inputs", "paths"))
    sdk = tool("rack-sdk", "path").strip()
    common = [f"RACK_DIR={sdk}", f"PYTHON_HOME={inputs['python-3.14']}", f"PYBIND11_DIR={inputs['pybind11']}"]
    shutil.rmtree(build_dir, ignore_errors=True)
    sh("make", "-C", str(SPIKE), *common, f"BUILD={build_dir / 'bench'}")
    sh("make", "-C", str(LIFECYCLE), *common, f"BUILD={build_dir / 'lifecycle'}")
    return {
        "bench": build_dir / "bench",
        "lifecycle": build_dir / "lifecycle",
        "python": Path(inputs["python-3.14"]),
        "rack": Path(tool("rack-sdk", "host").strip()),
    }


def headless_run(rack: Path, user: Path, seconds: float, taskset: str) -> str:
    env = {k: v for k, v in os.environ.items() if k not in {"DISPLAY", "WAYLAND_DISPLAY"}}
    proc = subprocess.Popen(
        ["taskset", "-c", taskset, str(rack / "Rack"), "-h", "-u", str(user)],
        cwd=rack,
        env=env,
        stdin=subprocess.PIPE,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    time.sleep(seconds)
    try:
        proc.communicate(b"\n", timeout=60)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        raise
    return (user / "log.txt").read_text(errors="replace")


def bench_patch(user: Path, bench: Path, model: str, count: int, rate: float, feedback: bool) -> None:
    plugin = user / "plugins-lin-x64" / "RackPyBench"
    plugin.mkdir(parents=True)
    shutil.copy(bench / "host" / "plugin.so", plugin)
    shutil.copy(SPIKE / "plugin.json", plugin)
    mods = [
        {"id": 100 + i, "plugin": "RackPyBench", "model": model, "version": "2.0.0", "pos": [2 * i, 0]}
        for i in range(count)
    ]
    cables = []
    if feedback:
        cables = [
            {"id": 1, "outputModuleId": 100, "outputId": 0, "inputModuleId": 101, "inputId": 0},
            {"id": 2, "outputModuleId": 101, "outputId": 0, "inputModuleId": 100, "inputId": 0},
        ]
    (user / "autosave").mkdir()
    (user / "autosave" / "patch.json").write_text(json.dumps({"version": "2.6.6", "modules": mods, "cables": cables}))
    (user / "settings.json").write_text(json.dumps({"sampleRate": rate, "threadCount": 1}))


def parse_bench_lines(log: str) -> list[dict[str, Any]]:
    rows = []
    for line in log.splitlines():
        if "RACKPY_BENCH " not in line:
            continue
        fields = dict(part.split("=", 1) for part in line.split("RACKPY_BENCH ", 1)[1].split())
        rows.append({k: (v if k == "model" else float(v)) for k, v in fields.items()})
    return rows


def lifecycle_ui(paths: dict[str, Path]) -> dict[str, str]:
    user = Path(tempfile.mkdtemp(prefix="rackpy-perf-ui-"))
    try:
        plugin = user / "plugins-lin-x64" / "RackPyLifecycle"
        plugin.mkdir(parents=True)
        for name in ("loader/plugin.so", "host_lifecycle.so"):
            shutil.copy(paths["lifecycle"] / name, plugin)
        shutil.copy(LIFECYCLE / "lifecycle_plugin.py", plugin)
        (plugin / "python").symlink_to(paths["python"])
        (plugin / "plugin.json").write_text(
            json.dumps(
                {
                    "slug": "RackPyLifecycle",
                    "name": "RackPy lifecycle probe",
                    "version": "2.0.0",
                    "license": "GPL-3.0-or-later",
                    "brand": "RackPy",
                    "author": "RackPy contributors",
                    "modules": [{"slug": "Probe", "name": "Probe", "tags": []}],
                }
            )
        )
        (plugin / "spike.json").write_text(
            json.dumps(
                {
                    "host": "host_lifecycle.so",
                    "libpython": "lib/libpython3.14.so.1.0",
                    "stdlib_marker": "lib/python3.14/os.py",
                }
            )
        )
        (plugin / "scenario.json").write_text(
            json.dumps(
                {
                    "worker": "none",
                    "resets": 3,
                    "churn": 0,
                    "frames_before_close": 5,
                    "slow_ui_ms": 100,
                    "slow_ui_frames": 20,
                    "exclusive_stall_ms": 50,
                }
            )
        )
        mods = [{"id": 21, "plugin": "RackPyLifecycle", "model": "Probe", "version": "2.0.0", "pos": [0, 0]}]
        (user / "autosave").mkdir()
        (user / "autosave" / "patch.json").write_text(json.dumps({"version": "2.6.6", "modules": mods, "cables": []}))
        env = {k: v for k, v in os.environ.items() if k not in {"DISPLAY", "WAYLAND_DISPLAY"}}
        subprocess.run(
            ["xvfb-run", "-a", "-s", "-screen 0 1600x1000x24", str(paths["rack"] / "Rack"), "-u", str(user)],
            cwd=paths["rack"],
            env=env,
            timeout=120,
            check=True,
            capture_output=True,
        )
        log = (user / "log.txt").read_text(errors="replace")

        def pick(marker: str) -> str:
            return next(line.split(marker, 1)[1].strip() for line in log.splitlines() if marker in line)

        return {
            "slow_ui_python_100ms_per_frame": pick("event=slow ui result "),
            "python_50ms_inside_exclusive_onReset": pick("event=exclusive stall result "),
        }
    finally:
        shutil.rmtree(user, ignore_errors=True)


def summarize(micro: list[dict[str, Any]]) -> list[dict[str, Any]]:
    rows: dict[tuple[str, str], dict[str, list[float]]] = {}
    for run in micro:
        for r in run["data"]["results"]:
            entry = rows.setdefault((r["workload"], r["variant"]), {"p50": [], "p99": []})
            entry["p50"].append(statistics.median(r["p50_per_rep"]))
            entry["p99"].append(statistics.median(r["p99_per_rep"]))
    out = []
    for (workload, variant), v in sorted(rows.items()):
        if variant == "native":
            continue
        n = rows[(workload, "native")]
        p50, p99 = statistics.median(v["p50"]), statistics.median(v["p99"])
        n50, n99 = statistics.median(n["p50"]), statistics.median(n["p99"])
        out.append(
            {
                "workload": workload,
                "variant": variant,
                "native_p50_ns": round(n50, 3),
                "p50_ns": round(p50, 3),
                "overhead_p50_ns": round(p50 - n50, 3),
                "overhead_p50_pct": round((p50 / n50 - 1) * 100, 1),
                "overhead_p99_pct": round((p99 / n99 - 1) * 100, 1),
            }
        )
    return out


@app.command
def run(
    *,
    build_dir: Annotated[Path, cyclopts.Parameter(help="Build directory outside git.")] = DEFAULT_BUILD,
    output: Path = OUTPUT,
    micro_cpus: tuple[str, ...] = ("4", "6", "8"),
    host_cpus: str = "4-7",
    host_seconds: float = 8.0,
    host_reps: int = 3,
) -> None:
    """Run every measurement and write the baseline JSON."""
    started = datetime.now(UTC).isoformat(timespec="seconds")
    paths = build(build_dir)
    bench = paths["bench"]
    guard_env = {**os.environ, "LD_PRELOAD": str(bench / "audio_guard.so")}
    result: dict[str, Any] = {
        "schema_version": 1,
        "generated_at": started,
        "generator": "bin/perf-baseline run",
        "environment": environment({"microbenchmarks": ",".join(micro_cpus), "lab": "4,5", "rack": host_cpus}),
        "inputs": {
            "rack": json.loads((REPO / "upstream" / "versions.json").read_text())["rack"]["commit"],
            "python": json.loads((REPO / "spikes" / "embedding" / "inputs.json").read_text())[
                "python_build_standalone"
            ],
            "pybind11": json.loads((REPO / "spikes" / "embedding" / "inputs.json").read_text())["pybind11"]["version"],
        },
    }
    print("equivalence and guard")
    result["equivalence"] = json.loads(sh(str(bench / "bench"), "equivalence"))
    result["guard"] = json.loads(sh(str(bench / "bench"), "guard", env=guard_env))
    print("microbenchmarks")
    result["microbenchmarks"] = [
        {"cpu": cpu, "data": json.loads(sh("taskset", "-c", cpu, str(bench / "bench"), "time", "21", "2000"))}
        for cpu in micro_cpus
    ]
    result["summary"] = summarize(result["microbenchmarks"])
    print("python laboratory")
    result["laboratory"] = json.loads(
        sh("taskset", "-c", "4,5", str(bench / "bench_lab"), str(paths["python"]), env=guard_env)
    )
    print("real host")
    configs = [(m, n, 48000.0) for m in ("NativeSine", "RackPySine") for n in (1, 16, 64)]
    configs += [(m, 64, r) for m in ("NativeSine", "RackPySine") for r in (44100.0, 96000.0)]
    configs += [(m, 16, 48000.0) for m in ("NativePoly", "RackPyPoly")]
    order = [c for c in configs for _ in range(host_reps)]
    random.Random(20261021).shuffle(order)
    meter: list[dict[str, Any]] = []
    for model, count, rate in order:
        user = Path(tempfile.mkdtemp(prefix="rackpy-perf-"))
        try:
            bench_patch(user, bench, model, count, rate, feedback=False)
            rows = parse_bench_lines(headless_run(paths["rack"], user, host_seconds, host_cpus))
            meter.append(
                {
                    "model": model,
                    "modules": count,
                    "sample_rate": rate,
                    "seconds": host_seconds,
                    "meter_avg": rows[0]["meter_avg"],
                    "meter_max": rows[0]["meter_max"],
                    "processed_per_module": statistics.median(r["processed"] for r in rows),
                    "modules_reported": len(rows),
                }
            )
        finally:
            shutil.rmtree(user, ignore_errors=True)
    feedback = []
    for model in ("NativeFeedback", "RackPyFeedback"):
        user = Path(tempfile.mkdtemp(prefix="rackpy-perf-"))
        try:
            bench_patch(user, bench, model, 2, 48000.0, feedback=True)
            rows = parse_bench_lines(headless_run(paths["rack"], user, 4.0, host_cpus))
            feedback += [
                {"model": model, "processed": r["processed"], "connected_out": r["connected_out"]} for r in rows
            ]
        finally:
            shutil.rmtree(user, ignore_errors=True)
    result["host"] = {"meter_runs": meter, "feedback": feedback}
    print("ui checks")
    result["ui"] = lifecycle_ui(paths)
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(result, indent=1, sort_keys=True) + "\n")
    print(f"wrote {output}")


if __name__ == "__main__":
    app()
