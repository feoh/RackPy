#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["cyclopts>=5.2,<6"]
#
# [tool.uv]
# exclude-newer = "2026-10-21T00:00:00Z"
# ///
"""Build and check the official Rack plugin toolchain for distributable Linux builds (RP-08).

A host-compiler build needs the host's glibc, so it is not distributable
(docs/compatibility.md, finding 1). This builds the official
rack-plugin-toolchain Linux toolchain (crosstool-ng x86_64-ubuntu16.04-linux-gnu)
from the commit pinned in upstream/versions.json, inside the pinned Docker
image packaging/toolchain/lin-x64.Dockerfile. The toolchain lives in a cache
directory outside git. It takes about an hour on a fast machine.
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import urllib.request
from pathlib import Path
from typing import Annotated, Any

import cyclopts

REPO = Path(__file__).resolve().parent.parent
VERSIONS = REPO / "upstream" / "versions.json"
DOCKERFILE = REPO / "packaging" / "toolchain" / "lin-x64.Dockerfile"
DEFAULT_CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "rackpy" / "toolchain"
TRIPLE = "x86_64-ubuntu16.04-linux-gnu"

app = cyclopts.App(help=__doc__)
CacheOpt = Annotated[Path, cyclopts.Parameter(help="Cache directory outside git.")]


def pins() -> dict[str, Any]:
    data: dict[str, Any] = json.loads(VERSIONS.read_text(encoding="utf-8"))["official_toolchain"]
    return data


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def workdir(cache: Path) -> Path:
    commit: str = pins()["commit"]
    return cache / commit[:12]


def toolchain_root(cache: Path) -> Path:
    return workdir(cache) / "local" / TRIPLE


def image_tag() -> str:
    return "rackpy-toolchain-builder:" + sha256_bytes(DOCKERFILE.read_bytes())[:12]


@app.command
def build(*, cache: CacheOpt = DEFAULT_CACHE, jobs: int = os.cpu_count() or 4) -> None:
    """Build the Linux toolchain in Docker; a no-op when it already exists."""
    pin = pins()
    work = workdir(cache)
    if toolchain_root(cache).is_dir():
        print(f"already built: {toolchain_root(cache)}")
        return
    if shutil.which("docker") is None:
        raise SystemExit("docker is required to build the toolchain")
    work.mkdir(parents=True, exist_ok=True)
    url = f"https://raw.githubusercontent.com/VCVRack/rack-plugin-toolchain/{pin['commit']}/Makefile"
    with urllib.request.urlopen(url, timeout=60) as response:
        makefile = response.read()
    if sha256_bytes(makefile) != pin["makefile_sha256"]:
        raise SystemExit(f"toolchain Makefile sha256 {sha256_bytes(makefile)} does not match the pin")
    (work / "Makefile").write_bytes(makefile)
    subprocess.run(["docker", "build", "-t", image_tag(), "-f", str(DOCKERFILE), str(DOCKERFILE.parent)], check=True)
    home = work / "home"  # crosstool-ng keeps downloaded tarballs in $HOME/src
    home.mkdir(exist_ok=True)
    # Mount at the same path so that paths baked into the toolchain stay valid outside.
    subprocess.run(
        [
            "docker",
            "run",
            "--rm",
            f"--user={os.getuid()}:{os.getgid()}",
            f"--volume={work}:{work}",
            f"--workdir={work}",
            f"--env=HOME={home}",
            f"--env=PWD={work}",  # the official Makefile derives LOCAL_DIR from $PWD
            image_tag(),
            "make",
            "toolchain-lin",
            f"JOBS={jobs}",
        ],
        check=True,
    )
    check(cache=cache)


def run(args: list[str]) -> str:
    return subprocess.run(args, capture_output=True, text=True, check=True).stdout


@app.command
def path(*, cache: CacheOpt = DEFAULT_CACHE) -> None:
    """Print the toolchain's bin directory, or fail with setup instructions."""
    root = toolchain_root(cache)
    if not (root / "bin" / f"{TRIPLE}-g++").exists():
        raise SystemExit(f"Rack Linux toolchain not found at {root}. Build it with: bin/rack-toolchain build")
    print(root / "bin")


@app.command
def check(*, cache: CacheOpt = DEFAULT_CACHE) -> None:
    """Report the compiler version and the sysroot glibc version; fail if glibc is newer than 2.23."""
    root = toolchain_root(cache)
    gxx = root / "bin" / f"{TRIPLE}-g++"
    if not gxx.exists():
        raise SystemExit(f"Rack Linux toolchain not found at {root}. Build it with: bin/rack-toolchain build")
    version = run([str(gxx), "-dumpfullversion"]).strip()
    libc = next((root / TRIPLE / "sysroot").glob("lib*/libc-*.so"), None)
    match = re.search(r"libc-(\d+)\.(\d+)\.so$", str(libc))
    if not match:
        raise SystemExit(f"cannot find libc-<version>.so in {root / TRIPLE / 'sysroot'}")
    glibc = (int(match[1]), int(match[2]))
    print(json.dumps({"triple": TRIPLE, "gcc": version, "sysroot_glibc": f"{glibc[0]}.{glibc[1]}", "root": str(root)}))
    if glibc > (2, 23):
        raise SystemExit(f"sysroot glibc {glibc} is newer than the Ubuntu 16.04 floor (2.23)")


if __name__ == "__main__":
    app()
