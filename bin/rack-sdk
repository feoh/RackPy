#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["cyclopts>=5.2,<6"]
#
# [tool.uv]
# exclude-newer = "2026-10-21T00:00:00Z"
# ///
"""Fetch, verify and survey the pinned VCV Rack SDK (RP-02).

Downloads and extraction live in a cache outside git. Pins come from
upstream/versions.json; recorded results live in
tests/fixtures/sdk-provenance.json.

The survey command is a preliminary, lexical/AST navigation aid for RP-05.
Its lists are not an API inventory and must not be read as coverage.
"""

import hashlib
import json
import os
import platform
import re
import shutil
import subprocess
import tempfile
import urllib.request
import zipfile
from pathlib import Path
from typing import Annotated, Any

import cyclopts

REPO = Path(__file__).resolve().parent.parent
VERSIONS = REPO / "upstream" / "versions.json"
FIXTURE = REPO / "tests" / "fixtures" / "sdk-provenance.json"
PROBE = REPO / "tests" / "fixtures" / "sdk-probe"
DEFAULT_CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "rackpy" / "sdk"
# Finder metadata shipped in some macOS archives; not SDK content.
IGNORED_NAMES = {".DS_Store"}
PRIVATE_MESSAGE = "Using internal Rack function or symbol"
PLATFORM_RE = re.compile(
    r"^\s*#\s*(if|ifdef|ifndef|elif)\b.*\b(ARCH_\w+|_WIN32|__APPLE__|__linux__"
    r"|__x86_64__|__aarch64__|__SSE\w*|__ARM_NEON\w*)"
)
TEMPLATE_KINDS = {
    "ClassTemplateDecl",
    "FunctionTemplateDecl",
    "TypeAliasTemplateDecl",
    "VarTemplateDecl",
    "ClassTemplatePartialSpecializationDecl",
}

app = cyclopts.App(help=__doc__)
CacheOpt = Annotated[Path, cyclopts.Parameter(help="Cache directory outside git.")]


def load_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def write_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def tree_digest(root: Path, subdir: str) -> str:
    """Digest equal to `find SUBDIR -type f | LC_ALL=C sort | xargs sha256sum | sha256sum`."""
    files = sorted(
        (p for p in (root / subdir).rglob("*") if p.is_file() and p.name not in IGNORED_NAMES),
        key=lambda p: p.relative_to(root).as_posix().encode(),
    )
    listing = "".join(f"{sha256_file(p)}  {p.relative_to(root).as_posix()}\n" for p in files)
    return hashlib.sha256(listing.encode()).hexdigest()


def archives(platforms: list[str] | None, section: str = "sdk") -> list[dict[str, Any]]:
    entries: list[dict[str, Any]] = load_json(VERSIONS)[section]["archives"]
    if platforms:
        unknown = set(platforms) - {a["platform"] for a in entries}
        if unknown:
            raise SystemExit(f"no pinned {section} archive for: {', '.join(sorted(unknown))}")
        entries = [a for a in entries if a["platform"] in platforms]
    return entries


def download(url: str, dest: Path) -> None:
    dest.parent.mkdir(parents=True, exist_ok=True)
    partial = dest.with_suffix(dest.suffix + ".partial")
    with urllib.request.urlopen(url, timeout=120) as response, partial.open("wb") as out:
        shutil.copyfileobj(response, out)
    partial.replace(dest)


def fetch_archive(entry: dict[str, Any], cache: Path, fresh: bool) -> Path:
    name: str = entry["url"].rsplit("/", 1)[1]
    cache.mkdir(parents=True, exist_ok=True)
    dest = (Path(tempfile.mkdtemp(prefix="fresh-", dir=cache)) if fresh else cache / "archives") / name
    if not dest.exists() or sha256_file(dest) != entry["sha256"]:
        download(entry["url"], dest)
    actual = sha256_file(dest)
    if actual != entry["sha256"]:
        raise SystemExit(f"{name}: sha256 {actual} does not match pinned {entry['sha256']}")
    return dest


def extract_pkg(archive: Path, staging: Path) -> None:
    """A macOS installer package: a xar archive whose Payload is a gzipped cpio. On a Mac, pkgutil expands
    both; elsewhere libarchive's bsdtar reads both, refusing members outside the target by default. (macOS's
    own bsdtar did not expand the Payload where bsdtar elsewhere does, RP-40.)"""
    expanded = staging / "expanded"
    if platform.system() == "Darwin":
        subprocess.run(["pkgutil", "--expand-full", str(archive), str(expanded)], check=True)
        payloads = list(expanded.glob("*.pkg/Payload"))
        if len(payloads) != 1 or not payloads[0].is_dir():
            raise SystemExit(f"{archive.name}: expected one expanded *.pkg/Payload, found {_listing(expanded)}")
        for item in payloads[0].iterdir():
            item.rename(staging / item.name)
    else:
        tar = shutil.which("bsdtar")
        if tar is None:
            raise SystemExit("extracting the macOS Rack package needs bsdtar (libarchive)")
        expanded.mkdir()
        subprocess.run([tar, "-xf", str(archive), "-C", str(expanded)], check=True)
        payloads = list(expanded.glob("*.pkg/Payload"))
        if len(payloads) != 1:
            raise SystemExit(f"{archive.name}: expected one *.pkg/Payload, found {_listing(expanded)}")
        subprocess.run([tar, "-xf", str(payloads[0]), "-C", str(staging)], check=True)
    shutil.rmtree(expanded)
    for apple_double in staging.rglob("._*"):  # extended attributes, as files when not on macOS
        apple_double.unlink()


def _listing(root: Path) -> list[str]:
    return sorted(p.relative_to(root).as_posix() for p in root.rglob("*"))[:40]


def extract(archive: Path, entry: dict[str, Any], cache: Path) -> Path:
    """Extract into a directory keyed by the archive digest; returns the SDK root."""
    dest = cache / "extracted" / f"{entry['platform']}-{entry['sha256'][:16]}"
    root: Path = dest / str(entry["root"])
    if root.is_dir():
        return root
    if dest.exists():
        shutil.rmtree(dest)  # An interrupted earlier extraction; it is keyed by digest, so redo it.
    staging = Path(tempfile.mkdtemp(prefix="extract-", dir=cache))
    if entry.get("format") == "pkg":
        extract_pkg(archive, staging)
        dest.parent.mkdir(parents=True, exist_ok=True)
        staging.replace(dest)
        return root
    with zipfile.ZipFile(archive) as zf:
        for member in zf.namelist():
            target = (staging / member).resolve()
            if not target.is_relative_to(staging.resolve()):
                raise SystemExit(f"{archive.name}: refusing member outside archive root: {member}")
        zf.extractall(staging)
        for info in zf.infolist():
            # zipfile drops Unix modes; restore permission bits so executables run.
            mode = (info.external_attr >> 16) & 0o777
            if mode and not info.is_dir():
                (staging / info.filename).chmod(mode)
    dest.parent.mkdir(parents=True, exist_ok=True)
    staging.replace(dest)
    return root


def prepare(platforms: list[str] | None, cache: Path, fresh: bool = False) -> dict[str, Path]:
    cache.mkdir(parents=True, exist_ok=True)
    return {e["platform"]: extract(fetch_archive(e, cache, fresh), e, cache) for e in archives(platforms)}


@app.command
def path(platform: str = "lin-x64", *, cache: CacheOpt = DEFAULT_CACHE) -> None:
    """Print the root of the verified, extracted SDK for PLATFORM."""
    print(prepare([platform], cache)[platform])


@app.command
def host(platform: str = "lin-x64", *, cache: CacheOpt = DEFAULT_CACHE) -> None:
    """Fetch and verify a pinned Rack Free host; extract it and print its directory (on macOS the .app)."""
    (entry,) = archives([platform], "host")
    archive = fetch_archive(entry, cache / "host", fresh=False)
    if "root" not in entry:
        print(archive)
        return
    print(extract(archive, entry, cache / "host"))


def sdk_flags(sdk: Path) -> list[str]:
    """Linux x64 preprocessing flags from the SDK's compile.mk/plugin.mk (warnings omitted)."""
    return [
        "-std=c++11",
        "-march=nehalem",
        "-fPIC",
        "-funsafe-math-optimizations",
        f"-I{sdk / 'include'}",
        f"-I{sdk / 'dep' / 'include'}",
    ]


def run_tu(args: list[str]) -> str:
    return subprocess.run(args, input="#include <rack.hpp>\n", capture_output=True, text=True, check=True).stdout


def tool_version(tool: str) -> str:
    return subprocess.run([tool, "--version"], capture_output=True, text=True, check=True).stdout.splitlines()[0]


def relative_header(path: str | None, sdk: Path) -> str | None:
    if not path:
        return None
    resolved = Path(path).resolve()
    for prefix, base in (("include/", sdk / "include"), ("dep/include/", sdk / "dep" / "include")):
        if resolved.is_relative_to(base):
            return prefix + resolved.relative_to(base).as_posix()
    return None


def split_comments(lines: list[str]) -> list[tuple[str, str]]:
    """Split each line into (code, comment) text, tracking /* */ across lines.

    Good enough for Rack's headers, which do not put comment markers in string literals.
    """
    result, in_block = [], False
    for line in lines:
        code, comment, i = [], [], 0
        while i < len(line):
            if in_block:
                end = line.find("*/", i)
                comment.append(line[i:] if end < 0 else line[i:end])
                if end < 0:
                    break
                in_block, i = False, end + 2
            elif line.startswith("//", i):
                comment.append(line[i + 2 :])
                break
            elif line.startswith("/*", i):
                in_block, i = True, i + 2
            else:
                code.append(line[i])
                i += 1
        result.append(("".join(code), "".join(comment)))
    return result


def next_code_line(split: list[tuple[str, str]], after: int) -> str:
    """First non-comment code after 1-based line `after`, for labelling comment annotations."""
    for code, _ in split[after:]:
        if code.strip():
            return code.strip()
    return ""


@app.command
def fetch(
    platforms: list[str] | None = None,
    *,
    cache: CacheOpt = DEFAULT_CACHE,
    fresh: bool = False,
) -> None:
    """Download pinned SDK archives and check their SHA-256.

    With --fresh, download into a new empty directory even if cached.
    """
    for entry in archives(platforms):
        path = fetch_archive(entry, cache, fresh)
        print(f"ok {entry['platform']} {entry['sha256']} {path}")


@app.command
def verify(platforms: list[str] | None = None, *, cache: CacheOpt = DEFAULT_CACHE) -> None:
    """Verify archive, header-tree and library digests against the provenance fixture."""
    recorded = load_json(FIXTURE)["archives"]
    failures: list[str] = []
    for name, root in prepare(platforms, cache).items():
        before = len(failures)
        expected = recorded[name]
        actual = {
            "include_tree_sha256": tree_digest(root, "include"),
            "dep_include_tree_sha256": tree_digest(root, "dep/include"),
            "library": {
                "name": expected["library"]["name"],
                "sha256": sha256_file(root / expected["library"]["name"]),
            },
        }
        for key, value in actual.items():
            if expected[key] != value:
                failures.append(f"{name} {key}: expected {expected[key]}, got {value}")
        print(f"{'FAIL' if len(failures) > before else 'ok'} {name}")
    if failures:
        raise SystemExit("\n".join(failures))


@app.command
def closure(*, cache: CacheOpt = DEFAULT_CACHE, cxx: str = "g++", write: bool = False) -> None:
    """Compute the Linux x64 rack.hpp include closure and compare it to the fixture.

    With --write, replace the fixture's closure section instead.
    """
    sdk = prepare(["lin-x64"], cache)["lin-x64"]
    deps = run_tu([cxx, *sdk_flags(sdk), "-x", "c++", "-M", "-MT", "tu", "-"])
    paths = {relative_header(p, sdk) for p in deps.replace("\\\n", " ").split()[1:] if p != "-"}
    reached = sorted(p for p in paths if p)
    rack = [p for p in reached if p.startswith("include/")]
    shipped = sorted(
        f"include/{p.relative_to(sdk / 'include').as_posix()}"
        for p in (sdk / "include").rglob("*")
        if p.is_file() and p.suffix in {".h", ".hpp"}
    )
    result = {
        "entry": "include/rack.hpp",
        "flags": [f for f in sdk_flags(sdk) if not f.startswith("-I")],
        "rack_headers": {p: sha256_file(sdk / p) for p in rack},
        "dep_headers": {p: sha256_file(sdk / p) for p in reached if p.startswith("dep/include/")},
        "shipped_rack_headers_not_reached": sorted(set(shipped) - set(rack)),
    }
    fixture = load_json(FIXTURE)
    if write:
        fixture["closure"] = result
        write_json(FIXTURE, fixture)
    elif fixture.get("closure") != result:
        raise SystemExit("include closure differs from tests/fixtures/sdk-provenance.json")
    print(
        f"{len(rack)} Rack headers and {len(result['dep_headers'])} dependency headers reached; "
        f"{len(result['shipped_rack_headers_not_reached'])} shipped Rack headers not reached"
    )


@app.command
def probe(*, cache: CacheOpt = DEFAULT_CACHE, make: str = "make") -> None:
    """Build the rack.hpp-only probe plugin with the SDK's own plugin.mk (Linux x64)."""
    sdk = prepare(["lin-x64"], cache)["lin-x64"]
    with tempfile.TemporaryDirectory(prefix="rackpy-probe-") as tmp:
        work = Path(tmp) / "probe"
        shutil.copytree(PROBE, work)
        build = subprocess.run([make, "-C", str(work), f"RACK_DIR={sdk}"], capture_output=True, text=True, check=False)
        print(build.stdout + build.stderr)
        if build.returncode:
            raise SystemExit(f"probe build failed with exit status {build.returncode}")
        warnings = [line for line in build.stderr.splitlines() if "warning:" in line]
        plugin = work / "plugin.so"
        dynamic = subprocess.run(["readelf", "-d", str(plugin)], capture_output=True, text=True, check=True).stdout
        symbols = subprocess.run(["objdump", "-T", str(plugin)], capture_output=True, text=True, check=True).stdout
        glibc = sorted(set(re.findall(r"GLIBC_([0-9.]+)", symbols)), key=lambda v: tuple(map(int, v.split("."))))
        print(f"warnings: {len(warnings)}")
        print("dynamic:", ", ".join(re.findall(r"\((?:NEEDED|RUNPATH|RPATH)\)\s+\S.*?\[(.*?)\]", dynamic)))
        exported = subprocess.run(
            ["nm", "-D", "--defined-only", str(plugin)], capture_output=True, text=True, check=True
        )
        print(f"exports init: {any(line.split()[-1:] == ['init'] for line in exported.stdout.splitlines())}")
        print(f"highest GLIBC symbol version required: {glibc[-1] if glibc else 'none'}")


@app.command
def survey(*, cache: CacheOpt = DEFAULT_CACHE, clang: str = "clang++", write: bool = False) -> None:
    """Preliminary PRIVATE/deprecation/template/platform survey of the rack.hpp TU.

    Uses clang's JSON AST plus lexical scans for comment-only annotations. With
    --write, replace the fixture's preliminary_survey section; otherwise compare.
    """
    sdk = prepare(["lin-x64"], cache)["lin-x64"]
    ast = json.loads(
        run_tu(
            [
                clang,
                *sdk_flags(sdk),
                "-Wno-vla-cxx-extension",
                "-fsyntax-only",
                "-Xclang",
                "-ast-dump=json",
                "-x",
                "c++",
                "-",
            ]
        )
    )
    private: set[tuple[str, str, str]] = set()
    deprecated: set[tuple[str, str, str]] = set()
    templates: set[tuple[str, str, str]] = set()
    declared: dict[str, str] = {}
    defined: set[str] = set()
    last_file: list[str | None] = [None]

    def note_file(node: dict[str, Any]) -> None:
        # Clang omits "file" when unchanged from the previous location, so track it in document order.
        loc, rng = node.get("loc", {}), node.get("range", {})
        for part in (loc, rng.get("begin", {}), rng.get("end", {})):
            for cand in (part, part.get("spellingLoc", {}), part.get("expansionLoc", {})):
                if "file" in cand:
                    last_file[0] = cand["file"]

    def spec_name(node: dict[str, Any]) -> str:
        args = []
        for child in node.get("inner", []):
            if child.get("kind") == "TemplateArgument":
                args.append(child.get("type", {}).get("qualType") or str(child.get("value", "?")))
        return f"{node['name']}<{', '.join(args)}>"

    def walk(node: dict[str, Any], scope: list[str], parent_kind: str | None) -> None:
        note_file(node)
        kind: str = node.get("kind", "")
        name: str | None = node.get("name")
        header = relative_header(last_file[0], sdk)
        child_scope = scope
        if kind == "ClassTemplateSpecializationDecl" and parent_kind == "ClassTemplateDecl":
            return  # Instantiation listings; explicit specializations are visited at namespace scope.
        if kind == "UsingShadowDecl":
            return  # Imports such as `using plugin::Model;` nest their target; not new declarations.
        if kind == "NamespaceDecl" and name:
            child_scope = [*scope, name]
        elif kind == "ClassTemplateSpecializationDecl" and name:
            child_scope = [*scope, spec_name(node)]
        elif kind == "CXXRecordDecl" and name and not node.get("isImplicit"):
            qual = "::".join([*scope, name])
            if qual.startswith("rack::") and header:
                declared.setdefault(qual, header)
                if node.get("completeDefinition"):
                    defined.add(qual)
            child_scope = [*scope, name]
        if scope[:1] == ["rack"] and header and header.startswith("include/") and name and not node.get("isImplicit"):
            qual = "::".join([*scope, name])
            if kind in TEMPLATE_KINDS:
                templates.add((qual, kind, header))
            for attr in node.get("inner", []):
                if attr.get("kind") == "DeprecatedAttr":
                    target = private if attr.get("message") == PRIVATE_MESSAGE else deprecated
                    target.add((qual, kind, header))
        for child in node.get("inner", []):
            walk(child, child_scope, kind)

    walk(ast, [], None)

    closure_headers = sorted(load_json(FIXTURE)["closure"]["rack_headers"])
    comment_deprecations: list[dict[str, Any]] = []
    unstable: list[dict[str, Any]] = []
    conditionals: list[dict[str, Any]] = []
    for rel in closure_headers:
        split = split_comments((sdk / rel).read_text(encoding="utf-8").splitlines())
        for number, (text, comment) in enumerate(split, 1):
            following = text.strip() or next_code_line(split, number)
            if re.search(r"\bDEPRECATED\b|\bDeprecated\b", comment) and not following.startswith("#define"):
                comment_deprecations.append({"header": rel, "line": number, "declaration": following})
            if "Unstable API" in comment:
                unstable.append({"header": rel, "line": number, "declaration": following})
            if PLATFORM_RE.search(text):
                conditionals.append({"header": rel, "line": number, "directive": text.strip()})

    def as_records(items: set[tuple[str, str, str]]) -> list[dict[str, str]]:
        return [{"name": n, "kind": k, "header": h} for n, k, h in sorted(items)]

    result = {
        "note": "Preliminary RP-02 navigation data. Not an inventory or coverage count; RP-05 supersedes it.",
        "private_declarations": as_records(private),
        "deprecated_attribute_declarations": as_records(deprecated),
        "comment_only_deprecations": comment_deprecations,
        "unstable_api_mentions": unstable,
        "incomplete_rack_records": [{"name": q, "header": declared[q]} for q in sorted(declared) if q not in defined],
        "templates": as_records(templates),
        "platform_conditionals": conditionals,
    }
    fixture = load_json(FIXTURE)
    if write:
        fixture["preliminary_survey"] = result
        fixture.setdefault("recorded_with", {})["survey"] = {"clang": tool_version(clang)}
        write_json(FIXTURE, fixture)
    elif fixture.get("preliminary_survey") != result:
        raise SystemExit("survey differs from tests/fixtures/sdk-provenance.json")
    print(
        f"PRIVATE declarations: {len(result['private_declarations'])}; "
        f"deprecated (attribute): {len(result['deprecated_attribute_declarations'])}; "
        f"doc comments mentioning deprecation: {len(comment_deprecations)}; "
        f"incomplete rack records: {len(result['incomplete_rack_records'])}; "
        f"template declarations: {len(result['templates'])}"
    )


@app.command
def environment() -> None:
    """Print host facts to record alongside a validation run."""
    facts = {"os": platform.platform(), "machine": platform.machine(), "python": platform.python_version()}
    for tool in ("g++", "clang++", "make", "ldd"):
        if shutil.which(tool):
            facts[tool] = tool_version(tool)
    print(json.dumps(facts, indent=2))


if __name__ == "__main__":
    app()
