#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.14"
# dependencies = ["cyclopts>=5.2,<6"]
#
# [tool.uv]
# exclude-newer = "2026-10-21T00:00:00Z"
# ///
"""Build, verify and compare RackPy's release-candidate artifacts for this computer's platform.

Linux x86_64 (RP-39) and macOS arm64 or x86_64 (RP-40), each built natively: a Mac
builds the architecture it runs, with Xcode's AppleClang.

build    from a clean checkout (on Linux with the official Rack plugin toolchain):
         the runtime bundle, every example as a .vcvplugin, the developer wheel,
         the GPL source archive, license notices, a manifest and SHA256SUMS
verify   install the artifacts on a clean machine and run them in Rack Free: on
         Linux a container with no checkout, no Python and no network; on a Mac
         fresh Rack user folders, run with an empty environment
compare  explain every difference between two builds of the same commit

Nothing is ever uploaded or published: the artifacts stay in DEST, outside git.
"""

import gzip
import hashlib
import html
import json
import os
import platform as platform_module
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request
import zipfile
from fnmatch import fnmatchcase
from pathlib import Path
from typing import Any, Literal

import cyclopts

REPO = Path(__file__).resolve().parent.parent
BIN = REPO / "bin"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "rackpy" / "build-inputs"
DEFAULT_DEST = REPO / "build" / "release"
if sys.platform == "darwin":
    PLATFORM = "mac-arm64" if platform_module.machine() == "arm64" else "mac-x64"
else:
    PLATFORM = "lin-x64"
MACOS = PLATFORM.startswith("mac-")
GLIBC_FLOOR = "2.23"  # the official toolchain's sysroot (Ubuntu 16.04)
# The oldest macOS each architecture claims: CMakeLists.txt's deployment targets, which are the pinned
# runtime's (CPython's minos; libRack's is 10.9 on x86_64, 11.0 on arm64).
MACOS_FLOORS = {"mac-arm64": "11.0", "mac-x64": "10.15"}
MACOS_FLOOR = MACOS_FLOORS.get(PLATFORM, "")
MACH_O_CPUS = {0x01000007: "mac-x64", 0x0100000C: "mac-arm64"}
LOADER = "plugin.dylib" if MACOS else "plugin.so"
LIBPYTHON = "libpython3.14.dylib" if MACOS else "libpython3.14.so.1.0"
_SHARED = ".dylib" if MACOS else ".so"
_EXTENSION = ".cpython-314-darwin.so" if MACOS else ".cpython-314-x86_64-linux-gnu.so"
# Shared libraries an artifact's ELF files may need from the system or from Rack. Anything else fails the build.
SYSTEM_LIBRARIES = {
    "libc.so.6",
    "libm.so.6",
    "libdl.so.2",
    "libpthread.so.0",
    "librt.so.1",
    "libutil.so.1",
    "libcrypt.so.1",
    "ld-linux-x86-64.so.2",
    "libRack.so",
}
# Shared extension modules of the bundled CPython left out of every artifact (RP-39), with why.
EXCLUDED_RUNTIME = {
    f"lib/python3.14/lib-dynload/_dbm{_EXTENSION}": "Berkeley DB: the Sleepycat license adds "
    "its own source obligations, and Rack plugins have no use for it",
    f"lib/python3.14/lib-dynload/_tkinter{_EXTENSION}": "Tk's GUI event loop cannot run in Rack",
    f"lib/libtcl9.0{_SHARED}": "Tcl, needed only by _tkinter",
    f"lib/libtcl9tk9.0{_SHARED}": "Tk, needed only by _tkinter",
    "lib/tcl9": "Tcl's library, needed only by _tkinter",
    "lib/tcl9.0": "Tcl's library, needed only by _tkinter",
    "lib/itcl4.3.8": "Tcl's library, needed only by _tkinter",
    "lib/thread3.0.6": "Tcl's thread extension, needed only by _tkinter",
    "lib/tk9.0": "Tk's library, needed only by _tkinter",
    "lib/python3.14/tkinter": "imports _tkinter",
    "lib/python3.14/idlelib": "IDLE, a Tk application",
    "lib/python3.14/turtledemo": "Tk demonstrations",
    "lib/python3.14/turtle.py": "imports tkinter",
    "bin/idle3": "starts IDLE",
    "bin/idle3.14": "starts IDLE",
    "lib/python3.14/site-packages/pip": "pip cannot install into a running Rack; it vendors other libraries",
    "lib/python3.14/site-packages/pip-26.2.2.dist-info": "pip's metadata",
    "lib/python3.14/ensurepip": "bundles a pip wheel",
    "bin/pip": "starts pip",
    "bin/pip3": "starts pip",
    "bin/pip3.14": "starts pip",
}
EXCLUDED_EXTENSIONS = {"_dbm", "_tkinter"}
# Library search paths an artifact may have: Rack's, which it symlinks to its own folder while it loads a plugin
# (the Rack SDK's plugin.mk adds it to every plugin), and the plugin's own runtime.
ALLOWED_SEARCH_PATHS = {"/tmp/Rack2", "$ORIGIN/python/lib", "$ORIGIN/../lib", "$ORIGIN"}
# On macOS: the host's search path for the bundled libpython, and the bundled interpreter's own.
ALLOWED_MAC_SEARCH_PATHS = {"@loader_path/python/lib", "@executable_path/../lib"}
# What a Mach-O file may load from outside its plugin: the OS's libraries and frameworks, and Rack, which
# plugin.mk links through /tmp/Rack2 (Rack symlinks it to its own folder while it loads plugins).
MAC_SYSTEM_PREFIXES = ("/usr/lib/", "/System/Library/Frameworks/")
MAC_RACK_LIBRARY = "/tmp/Rack2/libRack.dylib"
# Tracked files that are not RackPy's to license under the GPL: kept out of the source archive (docs/licensing.md).
RESTRICTED_SOURCES = ["docs/_static/examples"]

app = cyclopts.App(help=__doc__)


def run(
    args: list[str | Path], cwd: Path | None = None, capture: bool = False, env: dict[str, str] | None = None
) -> str:
    printable = " ".join(str(a) for a in args)
    print(f"+ {printable}", flush=True)
    proc = subprocess.run([str(a) for a in args], cwd=cwd, check=False, text=True, capture_output=capture, env=env)
    if proc.returncode:
        detail = f"\n{proc.stdout}\n{proc.stderr}" if capture else ""
        raise SystemExit(f"command failed with exit status {proc.returncode}: {printable}{detail}")
    return proc.stdout or ""


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def fetch(entry: dict[str, Any]) -> Path:
    archive: Path = CACHE / "archives" / entry["file"]
    if not archive.exists() or sha256_file(archive) != entry["sha256"]:
        archive.parent.mkdir(parents=True, exist_ok=True)
        partial = archive.with_name(archive.name + ".partial")
        with urllib.request.urlopen(entry["url"], timeout=600) as response, partial.open("wb") as out:
            shutil.copyfileobj(response, out)
        partial.replace(archive)
    if (actual := sha256_file(archive)) != entry["sha256"]:
        raise SystemExit(f"{entry['file']}: sha256 {actual} does not match the pin {entry['sha256']}")
    return archive


def checkout_facts() -> dict[str, Any]:
    """The commit being released; the checkout must match it exactly, so the artifacts are that commit."""
    status = run(["git", "-C", REPO, "status", "--porcelain", "--untracked-files=normal"], capture=True)
    if status.strip():
        raise SystemExit("the checkout has uncommitted or untracked files; release only a commit:\n" + status)
    commit = run(["git", "-C", REPO, "rev-parse", "HEAD"], capture=True).strip()
    epoch = int(run(["git", "-C", REPO, "show", "-s", "--format=%ct", commit], capture=True).strip())
    version = re.search(r'^version = "(.+?)"', (REPO / "pyproject.toml").read_text(), re.MULTILINE)
    assert version is not None
    return {"commit": commit, "source_date_epoch": epoch, "version": f"{version[1]}+g{commit[:9]}"}


def elf_files(root: Path) -> list[Path]:
    found = []
    for path in sorted(root.rglob("*")):
        if path.is_file() and not path.is_symlink():
            with path.open("rb") as f:
                if f.read(4) == b"\x7fELF":
                    found.append(path)
    return found


def elf_facts(path: Path) -> dict[str, Any]:
    dynamic = run(["readelf", "-d", "-W", path], capture=True)
    versions = run(["objdump", "-T", path], capture=True)
    glibc = sorted(set(re.findall(r"GLIBC_([0-9.]+)", versions)), key=lambda v: tuple(map(int, v.split("."))))
    return {
        "needed": re.findall(r"\(NEEDED\)\s+Shared library: \[(.+?)\]", dynamic),
        "runpath": re.findall(r"\((?:RUNPATH|RPATH)\)\s+Library (?:runpath|rpath): \[(.+?)\]", dynamic),
        "max_glibc": glibc[-1] if glibc else None,
    }


MH_MAGIC_64 = b"\xcf\xfa\xed\xfe"  # a thin 64-bit Mach-O, little-endian
FAT_MAGICS = {b"\xca\xfe\xba\xbe", b"\xca\xfe\xba\xbf"}  # universal binaries


def mach_o_files(root: Path) -> list[Path]:
    found = []
    for path in sorted(root.rglob("*")):
        if path.is_file() and not path.is_symlink():
            with path.open("rb") as f:
                if (magic := f.read(4)) == MH_MAGIC_64 or magic in FAT_MAGICS:
                    found.append(path)
    return found


def mach_o_tool(name: str) -> str:
    """Apple's otool, nm or strip on a Mac (Xcode's command line tools); LLVM's elsewhere, for inspection."""
    for candidate in (name, f"llvm-{name}") if sys.platform == "darwin" else (f"llvm-{name}",):
        if shutil.which(candidate):
            return candidate
    raise SystemExit(f"no {name}: install Xcode's command line tools (xcode-select --install)")


def load_commands(path: Path) -> list[dict[str, str]]:
    """A Mach-O file's load commands, from otool -l: each command's fields by name (cmd, name, path, minos...)."""
    commands: list[dict[str, str]] = []
    for line in run([mach_o_tool("otool"), "-l", path], capture=True).splitlines():
        fields = line.split(None, 1)
        if line.startswith("Load command"):
            commands.append({})
        elif commands and len(fields) == 2:
            commands[-1].setdefault(fields[0], re.sub(r" \(offset \d+\)$", "", fields[1].strip()))
    return commands


def code_signature(path: Path) -> dict[str, Any]:
    """codesign's view of a file: whether its signature verifies, and what kind it is (adhoc, linker-signed)."""
    if not shutil.which("codesign"):
        return {"checked": False}
    verify = subprocess.run(["codesign", "--verify", "--strict", path], check=False, capture_output=True, text=True)
    detail = subprocess.run(["codesign", "-d", "--verbose=2", path], check=False, capture_output=True, text=True)
    pairs = [line.split("=", 1) for line in detail.stderr.splitlines() if "=" in line]
    flags = re.search(r"\bflags=(\S+)", detail.stderr)
    return {
        "checked": True,
        "valid": verify.returncode == 0,
        "error": verify.stderr.strip() or None,
        "signature": next((v for k, v in pairs if k == "Signature"), None),  # "adhoc": signed by no identity
        "flags": flags[1] if flags else None,  # e.g. 0x2(adhoc); linker-signed when the linker signed it
        "authority": [v for k, v in pairs if k == "Authority"],  # a Developer ID signature's chain; none ad hoc
        "team": next((v for k, v in pairs if k == "TeamIdentifier"), None),
    }


def mach_o_facts(path: Path) -> dict[str, Any]:
    with path.open("rb") as f:
        header = f.read(8)
    cpu = (
        MACH_O_CPUS.get(int.from_bytes(header[4:8], "little"), "unknown") if header[:4] == MH_MAGIC_64 else "universal"
    )
    commands = load_commands(path)
    build = next((c for c in commands if c.get("cmd") == "LC_BUILD_VERSION"), None)
    legacy = next((c for c in commands if c.get("cmd") == "LC_VERSION_MIN_MACOSX"), None)
    return {
        "cpu": cpu,
        "needed": [c["name"] for c in commands if c.get("cmd") in {"LC_LOAD_DYLIB", "LC_LOAD_WEAK_DYLIB"}],
        "install_name": next((c["name"] for c in commands if c.get("cmd") == "LC_ID_DYLIB"), None),
        "runpath": [c["path"] for c in commands if c.get("cmd") == "LC_RPATH"],
        "minos": build["minos"] if build else legacy["version"] if legacy else None,
        "sdk": build.get("sdk") if build else legacy.get("sdk") if legacy else None,
        "code_signature": code_signature(path),
    }


def finish_mach_o(path: Path) -> None:
    """Strip a Mach-O library as plugin.mk's dist does (debug symbols, and local symbols), then sign it ad hoc:
    editing a file invalidates its signature, and arm64 macOS loads no unsigned code."""
    path.chmod(path.stat().st_mode | 0o200)
    run([mach_o_tool("strip"), "-S", "-x", path])
    run(["codesign", "--force", "--sign", "-", path])


def toolchain_bin() -> Path:
    return Path(run([BIN / "rack-toolchain", "path"], capture=True).strip().splitlines()[-1])


def build_tools() -> dict[str, str]:
    """The build machine's tools whose versions can change the bytes of an artifact."""
    import compression.zstd
    import zlib

    git = run(["git", "--version"], capture=True).strip()
    return {
        "python": sys.version.split()[0],
        "zlib": zlib.ZLIB_RUNTIME_VERSION,
        "zstd": ".".join(map(str, compression.zstd.zstd_version_info)),
        "git": git,
        "uv": run(["uv", "--version"], capture=True).strip(),
    }


def content_digest(path: Path) -> str:
    """A digest of an archive's members and their contents, whatever compressed them."""
    members = archive_members(path)
    return hashlib.sha256("".join(f"{n}\t{members[n]}\n" for n in sorted(members)).encode()).hexdigest()


def toolchain_id() -> dict[str, str]:
    """The official toolchain by its recipe's hash and target, not by where this machine keeps it; on a Mac,
    Xcode's compiler and SDK, and the macOS version."""
    if MACOS:
        return {
            "compiler": run(["xcrun", "clang", "--version"], capture=True).splitlines()[0],
            "sdk": run(["xcrun", "--show-sdk-version"], capture=True).strip(),
            "macos": run(["sw_vers", "-productVersion"], capture=True).strip(),
            "machine": platform_module.machine(),
        }
    bindir = toolchain_bin()
    recipe = REPO / "packaging" / "toolchain" / "lin-x64.Dockerfile"
    return {"build": bindir.parents[2].name, "target": bindir.parent.name, "recipe_sha256": sha256_file(recipe)}


def machine_paths(root: Path) -> list[tuple[Path, str]]:
    """Files under root that name this machine: its home, the checkout or the build caches."""
    needles = sorted({str(Path.home()), str(REPO), str(CACHE.parent)}, key=len, reverse=True)
    found = []
    for path in sorted(root.rglob("*")):
        if path.is_file() and not path.is_symlink():
            data = path.read_bytes()
            found += [(path, n) for n in needles if n.encode() in data][:1]
    return found


def version_tuple(version: str) -> tuple[int, ...]:
    return tuple(int(p) for p in version.split("."))


def prepare_runtime(python: Path, finish: Any) -> dict[str, str]:
    """Remove the excluded modules from a copied runtime and strip its shared libraries with FINISH (on a Mac,
    signing them again); return what was removed."""
    removed = {}
    for rel, why in EXCLUDED_RUNTIME.items():
        target = python / rel
        if target.is_dir():
            shutil.rmtree(target)
        elif target.exists() or target.is_symlink():
            target.unlink()
        else:
            raise SystemExit(f"the runtime has no {rel}: update EXCLUDED_RUNTIME for this runtime")
        removed[rel] = why
    # Only the shared libraries: strip warns on, and may break, the patchelf-edited executable, which Rack never runs.
    for path in mach_o_files(python) if MACOS else elf_files(python):
        if ".so" in path.name or path.suffix == ".dylib":
            path.chmod(path.stat().st_mode | 0o200)
            finish(path)
    return removed


def third_party_notices(licenses_dir: Path, version: str) -> list[dict[str, Any]]:
    """Copy the bundled CPython's license texts from its full archive, and pybind11's; write the notices."""
    pins = json.loads((REPO / "packaging" / "inputs.json").read_text())
    archive = fetch(pins["python_licenses"]["3.14"][PLATFORM])
    python_licenses = licenses_dir / "python"
    python_licenses.mkdir(parents=True)
    meta: dict[str, Any] = {}
    with tarfile.open(archive, "r:zst") as tf:
        texts: dict[str, bytes] = {}
        for member in tf:
            if member.name == "python/PYTHON.json":
                f = tf.extractfile(member)
                assert f is not None
                meta = json.load(f)
            elif member.name.startswith("python/licenses/") and member.isreg():
                f = tf.extractfile(member)
                assert f is not None
                texts[member.name.removeprefix("python/")] = f.read()
    runtime = pins["python_runtime"]["3.14"][PLATFORM]["version"]
    if meta.get("python_version") != runtime:
        raise SystemExit(f"the license archive is CPython {meta.get('python_version')}, the runtime {runtime}")
    components: list[dict[str, Any]] = [
        {
            "component": f"CPython {runtime}",
            "licenses": meta["licenses"],
            "text": "licenses/python/" + Path(meta["license_path"]).name,
            "used_by": "the interpreter",
        }
    ]
    used: dict[str, set[str]] = {meta["license_path"]: {"CPython"}}
    for name, variants in sorted(meta["build_info"]["extensions"].items()):
        if name in EXCLUDED_EXTENSIONS:
            continue
        for variant in variants:
            for path in variant.get("license_paths") or []:
                used.setdefault(path, set()).add(name)
            linked = [link["name"] for link in variant.get("links", []) if not link.get("system")]
            if variant.get("licenses"):
                components.append(
                    {
                        "component": f"libraries of the {name} module ({', '.join(linked)})",
                        "licenses": variant["licenses"],
                        "text": ", ".join(
                            "licenses/python/" + Path(p).name for p in variant.get("license_paths") or []
                        ),
                        "used_by": name,
                    }
                )
            elif variant.get("license_public_domain"):
                components.append(
                    {
                        "component": f"libraries of the {name} module",
                        "licenses": ["public domain"],
                        "text": "",
                        "used_by": name,
                    }
                )
    for path in sorted(used):
        (python_licenses / Path(path).name).write_bytes(texts[path])
    pybind11 = next((REPO / ".venv").glob("lib/python3.*/site-packages/pybind11-*.dist-info"))
    (licenses_dir / "pybind11-LICENSE").write_bytes((pybind11 / "licenses" / "LICENSE").read_bytes())
    components.append(
        {
            "component": f"pybind11 {pybind11.name.removesuffix('.dist-info').split('-')[1]}",
            "licenses": ["BSD-3-Clause"],
            "text": "licenses/pybind11-LICENSE",
            "used_by": "compiled into rackpy_host.so",
        }
    )
    lines = [
        f"# Third-party notices for RackPy {version} ({PLATFORM})",
        "",
        "RackPy itself is GPL-3.0-or-later (LICENSE, NOTICE). It is compiled against the headers of the VCV Rack",
        "SDK 2.6.6, also GPL-3.0-or-later, and runs inside VCV Rack; it contains no Rack binaries or artwork.",
        "These are the third-party components this artifact contains, and where their license texts are:",
        "",
        "| Component | Licenses | Text | Used by |",
        "| --- | --- | --- | --- |",
    ]
    for c in components:
        lines.append(f"| {c['component']} | {', '.join(c['licenses'])} | {c['text'] or '-'} | {c['used_by']} |")
    lines += [
        "",
        "Left out of this runtime, and not distributed: "
        + ", ".join(sorted(EXCLUDED_EXTENSIONS))
        + " (Berkeley DB, whose Sleepycat license adds its own source obligations; Tcl/Tk, whose GUI loop"
        " cannot run in Rack), and pip and ensurepip (pip cannot install into a running Rack, and vendors"
        " other libraries).",
        "",
        "licenses/rack-sdk-headers.txt has the notices of the third-party code in the Rack SDK's headers, and",
        "licenses/FILES.json lists every file of this plugin with its SHA-256 and what it is made from.",
        "",
        "The corresponding source of RackPy is the rackpy-*-source archive published with this artifact;",
        "CPython's is at https://github.com/python/cpython (v" + runtime + ") and the build of this runtime at",
        "https://github.com/astral-sh/python-build-standalone (release "
        + pins["python_runtime"]["3.14"][PLATFORM]["release"]
        + ").",
        "",
    ]
    (licenses_dir / "THIRD-PARTY-NOTICES.md").write_text("\n".join(lines))
    return components


def sdk_header_notices(licenses_dir: Path, sdk: Path) -> None:
    """The notices of the third-party header code that compiling against the Rack SDK can put in a binary."""
    dist = (sdk / "LICENSE-dist.html").read_text(encoding="utf-8")
    parts = [
        "Third-party code in the VCV Rack SDK 2.6.6's headers, which can be compiled into RackPy's",
        "binaries and the kernel libraries of plugins: jansson's inline functions, SIMDe and sse_mathfun.",
        "The texts are copied from the SDK's LICENSE-dist.html and include/simd/ headers.",
    ]
    for name in ("jansson", "simde"):
        section = re.search(rf"<h2>{name}</h2>(.*?)(?=<h2>|\Z)", dist, re.DOTALL)
        if section is None:
            raise SystemExit(f"the SDK's LICENSE-dist.html has no {name} section")
        text = html.unescape(re.sub(r"<[^>]+>", "", section[1])).strip()
        parts += ["", f"## {name}", "", text]
    for header in ("sse_mathfun.h", "sse_mathfun_extension.h"):
        source = (sdk / "include" / "simd" / header).read_text(encoding="utf-8")
        comments = re.match(r"\s*((?:/\*.*?\*/\s*)+)", source, re.DOTALL)
        if comments is None or ("zlib" not in comments[1] and "Permission is granted" not in comments[1]):
            raise SystemExit(f"{header} has no license comment where expected")
        parts += ["", f"## include/simd/{header}", "", comments[1].strip()]
    (licenses_dir / "rack-sdk-headers.txt").write_text("\n".join(parts) + "\n", encoding="utf-8")


# What each file of an artifact is, by the first pattern its path matches: the components (keys of
# COMPONENTS) it is made from. A file no pattern matches fails the build, so the list stays exact.
COMPONENTS = {
    "rackpy": "RackPy, GPL-3.0-or-later: LICENSE, NOTICE",
    "rack-sdk-headers": "VCV Rack SDK 2.6.6 header code, GPL-3.0-or-later, with jansson (MIT), SIMDe (MIT) and "
    "sse_mathfun (zlib): licenses/rack-sdk-headers.txt",
    "pybind11": "pybind11, BSD-3-Clause: licenses/pybind11-LICENSE",
    "cpython": "CPython, PSF-2.0: licenses/python/LICENSE.cpython.txt",
    "cpython-libraries": "the libraries linked into libpython: licenses/THIRD-PARTY-NOTICES.md, licenses/python/",
    "plugin": "the plugin's own files, under the license its plugin.json names",
    "notices": "license texts and this manifest",
}
FILE_RULES = [
    (["LICENSE", "NOTICE", "licenses/*", "*-LICENSE", "*-LICENSE.md", "*-LICENSE.txt"], ["notices"]),
    (["plugin.json"], ["plugin"]),
    (["rackpy-loader.json", "pythonpath/rackpy/*"], ["rackpy"]),
    ([LOADER], ["rackpy", "rack-sdk-headers"]),
    (["rackpy_host.so"], ["rackpy", "rack-sdk-headers", "pybind11"]),
    ([f"python/lib/{LIBPYTHON}"], ["cpython", "cpython-libraries"]),
    (["python/*"], ["cpython"]),
    (["kernels/*"], ["plugin", "rack-sdk-headers"]),
    (["pythonpath/*", "res/*", "presets/*"], ["plugin"]),
]


def file_manifest(root: Path, build: dict[str, Any]) -> list[str]:
    """Write root/licenses/FILES.json: every file's SHA-256 and components; return the files no rule covers."""
    manifest = json.loads((root / "plugin.json").read_text())
    files: dict[str, Any] = {}
    unmatched = []
    for path in sorted(root.rglob("*"), key=lambda p: p.relative_to(root).as_posix()):
        rel = path.relative_to(root).as_posix()
        # As bin/rackpy-plugin pack leaves out bytecode caches, so does the list.
        if path.is_dir() or rel == "licenses/FILES.json" or "__pycache__" in rel.split("/") or path.suffix == ".pyc":
            continue
        rule = next((c for patterns, c in FILE_RULES if any(fnmatchcase(rel, p) for p in patterns)), None)
        if rule is None:
            unmatched.append(f"{root.name}/{rel}")
            continue
        entry: dict[str, Any] = {"components": rule}
        if path.is_symlink():
            entry["symlink"] = str(path.readlink())
        else:
            entry["sha256"] = sha256_file(path)
        files[rel] = entry
    data = {
        "plugin": {"slug": manifest["slug"], "version": manifest["version"], "license": manifest.get("license")},
        "build": build,
        "components": COMPONENTS,
        "files": files,
    }
    (root / "licenses" / "FILES.json").write_text(json.dumps(data, indent=1, sort_keys=True) + "\n")
    return unmatched


RECORDED: dict[str, Any] = {}  # each kernel library's facts, from every plugin, as well as the bundle's


def elf_problems(root: Path, work: Path, facts: dict[str, Any] | None) -> list[str]:
    """What is wrong with root's ELF files; their facts go in FACTS (the bundle's) or, for kernels, RECORDED."""
    found: list[str] = []
    recorded = facts if facts is not None else RECORDED
    files = elf_files(root)
    bundled = {p.name for p in files} | {"libpython3.14.so.1.0"}
    for path in files:
        rel = path.relative_to(work).as_posix()
        fact = elf_facts(path)
        if facts is not None or path.parent.name == "kernels":
            recorded[rel] = fact
        unexpected = [
            n
            for n in fact["needed"]
            if n not in SYSTEM_LIBRARIES | bundled
            and not (
                n.startswith("$ORIGIN/") and (path.parent / n.removeprefix("$ORIGIN/")).resolve().is_relative_to(root)
            )
        ]
        if unexpected:
            found.append(f"{rel} needs {unexpected}")
        for entry in fact["runpath"]:
            if any(d not in ALLOWED_SEARCH_PATHS for d in entry.split(":")):
                found.append(f"{rel} searches {entry}")
        if fact["max_glibc"] and version_tuple(fact["max_glibc"]) > version_tuple(GLIBC_FLOOR):
            found.append(f"{rel} needs GLIBC_{fact['max_glibc']}, newer than {GLIBC_FLOOR}")
    return found


def mach_o_problems(root: Path, work: Path, facts: dict[str, Any] | None) -> list[str]:
    """What is wrong with root's Mach-O files; their facts go in FACTS (the bundle's) or, for kernels, RECORDED."""
    found: list[str] = []
    recorded = facts if facts is not None else RECORDED
    files = mach_o_files(root)
    bundled = {p.name for p in files}
    for path in files:
        rel = path.relative_to(work).as_posix()
        fact = mach_o_facts(path)
        if facts is not None or path.parent.name == "kernels":
            recorded[rel] = fact
        if fact["cpu"] != PLATFORM:
            found.append(f"{rel} is a {fact['cpu']} binary, not {PLATFORM}: build one package per architecture")
        unexpected = [
            n
            for n in fact["needed"]
            if not n.startswith(MAC_SYSTEM_PREFIXES)
            and n != MAC_RACK_LIBRARY
            and not (n.startswith("@rpath/") and n.removeprefix("@rpath/") in bundled)
        ]
        if unexpected:
            found.append(f"{rel} needs {unexpected}")
        found += [f"{rel} searches {entry}" for entry in fact["runpath"] if entry not in ALLOWED_MAC_SEARCH_PATHS]
        if fact["minos"] is None or version_tuple(fact["minos"]) > version_tuple(MACOS_FLOOR):
            found.append(f"{rel} needs macOS {fact['minos']}, newer than {MACOS_FLOOR}")
        signature = fact["code_signature"]
        if not signature["checked"] or not signature["valid"]:
            found.append(f"{rel}: its code signature does not verify ({signature.get('error')})")
    return found


@app.command
def build(dest: Path = DEFAULT_DEST, *, allow_dirty: bool = False) -> None:
    """Build every release-candidate artifact of this commit for this computer's platform into DEST (emptied first).

    --allow-dirty is for trying the tool only: the manifest then says the checkout was dirty, and such
    artifacts must never leave this machine.
    """
    try:
        facts = checkout_facts()
        dirty = False
    except SystemExit:
        if not allow_dirty:
            raise
        commit = run(["git", "-C", REPO, "rev-parse", "HEAD"], capture=True).strip()
        facts = {"commit": commit, "source_date_epoch": int(time.time()), "version": "0.0.0.dev0+dirty"}
        dirty = True
    version, epoch = facts["version"], facts["source_date_epoch"]
    if dest.exists():
        shutil.rmtree(dest)
    work, out = dest / "work", dest / "artifacts"
    work.mkdir(parents=True)
    out.mkdir()
    tree = dest / "build-tree"

    # 1. The plugin skeleton and the example kernels: on Linux with the official toolchain (glibc floor 2.23),
    # on a Mac with Xcode's AppleClang for this Mac's architecture (CMakeLists.txt sets the deployment target).
    # The runtime is a fresh extraction of the pinned archive, not the build cache's copy that local runs touch.
    toolchain = [] if MACOS else ["--toolchain", "rack-lin-x64"]
    run([BIN / "rackpy-dev", "build", "--build-dir", tree, *toolchain, "--werror"])
    run([BIN / "rackpy-dev", "bundle", work, "--build-dir", tree, "--runtime", "copy"])
    bundle = work / "RackPy"
    shutil.rmtree(bundle / "python")
    pin = json.loads((REPO / "packaging" / "inputs.json").read_text())["python_runtime"]["3.14"][PLATFORM]
    staging = work / "runtime"
    with tarfile.open(fetch(pin)) as tf:
        tf.extractall(staging, filter="data")
    (staging / pin["root"]).rename(bundle / "python")
    staging.rmdir()
    if MACOS:
        finish = finish_mach_o
    else:
        # The toolchain's strip, not the build machine's: binutils versions strip the same file differently.
        strip = toolchain_bin() / "x86_64-ubuntu16.04-linux-gnu-strip"

        def finish(path: Path) -> None:
            run([strip, "--strip-unneeded", path])

    removed = prepare_runtime(bundle / "python", finish)
    if MACOS:  # cmake --install --strip edited them after the linker signed them
        for name in (LOADER, "rackpy_host.so"):
            finish(bundle / name)
    components = third_party_notices(bundle / "licenses", version)
    sdk = Path(run([BIN / "rack-sdk", "path", PLATFORM], capture=True).strip().splitlines()[-1])
    sdk_header_notices(bundle / "licenses", sdk)
    versions = json.loads((REPO / "upstream" / "versions.json").read_text())
    build_info = {
        "rackpy_version": version,
        "commit": facts["commit"],
        "dirty": dirty,
        "rack": {"version": versions["rack"]["version"], "commit": versions["rack"]["commit"]},
        "rack_sdk": next(a for a in versions["sdk"]["archives"] if a["platform"] == PLATFORM),
        "python_runtime": pin,
        "toolchain": toolchain_id(),
        **({"macos_floor": MACOS_FLOOR} if MACOS else {"glibc_floor": GLIBC_FLOOR}),
    }

    # 2. Every example as a plugin directory, its kernel libraries stripped as cmake --install strips RackPy's.
    plugins = work / "plugins"
    examples = []
    for project in sorted(p.parent for p in (REPO / "examples").glob("*/plugin.json")):
        manifest = json.loads((project / "plugin.json").read_text())
        config = json.loads((project / "rackpy-plugin.json").read_text())
        args: list[str | Path] = [BIN / "rackpy-plugin", "build", project, "--bundle", bundle, "--dest", plugins]
        if config.get("kernels"):
            args += ["--kernels", tree / "examples" / project.name / "kernels"]
        run(args)
        for kernel in sorted((plugins / manifest["slug"] / "kernels").glob("*.so")):
            finish(kernel)
        examples.append((project, manifest))

    # 3. What every binary needs, and that no file names this machine. On Linux: only the system's C library
    # family, Rack and the bundled runtime, at most glibc 2.23, and no search path but Rack's /tmp/Rack2 and the
    # plugin's own. On a Mac: one architecture, this Mac's; only the OS's libraries, Rack and the bundled
    # runtime; the deployment target at most the claimed macOS; and a signature that verifies.
    binaries: dict[str, Any] = {}
    problems = []
    for root in [bundle, *(plugins / m["slug"] for _, m in examples)]:
        check = mach_o_problems if MACOS else elf_problems
        problems += check(root, work, binaries if root == bundle else None)
        problems += [f"{f}: no license rule covers it" for f in file_manifest(root, build_info)]
        problems += [f"{p.relative_to(work)} names {m}" for p, m in machine_paths(root)]
        floor = [] if MACOS else ["--max-glibc", GLIBC_FLOOR]
        run([BIN / "rackpy-dev", "inspect", root, *floor], capture=True)
    if problems:
        raise SystemExit("artifact problems:\n" + "\n".join(f"- {p}" for p in problems))

    artifacts: list[dict[str, Any]] = []

    def record(path: Path, role: str, **more: Any) -> None:
        artifacts.append(
            {
                "file": path.name,
                "role": role,
                "sha256": sha256_file(path),
                "content_sha256": content_digest(path),
                "size": path.stat().st_size,
                **more,
            }
        )

    # 4. The runtime bundle, what bin/rackpy-plugin build combines with a plugin project, and every example as
    # a plugin package, Rack's own format.
    runtime_archive = out / f"rackpy-runtime-{version}-{PLATFORM}.tar.zst"
    pack: list[str | Path] = [BIN / "rackpy-plugin", "pack", "--source-date-epoch", str(epoch)]
    run([*pack, bundle, "--output", runtime_archive])
    record(runtime_archive, "runtime bundle: input to bin/rackpy-plugin build; not itself a plugin to install")
    for project, manifest in examples:
        package = out / f"{manifest['slug']}-{manifest['version']}-{PLATFORM}.vcvplugin"
        run([*pack, plugins / manifest["slug"], "--output", package])
        record(
            package,
            "example plugin: copy into Rack's plugins folder",
            slug=manifest["slug"],
            models=[m["slug"] for m in manifest["modules"]],
            example=project.name,
        )

    # 5. The developer package: the rackpy Python package, for typing, offline graphs and tests; not a plugin.
    wheels = work / "wheel"
    run(["uv", "build", "--wheel", "--out-dir", wheels], cwd=REPO, env={**os.environ, "SOURCE_DATE_EPOCH": str(epoch)})
    (wheel,) = wheels.glob("*.whl")  # its name and metadata keep the package version; the manifest has the commit
    shutil.copy(wheel, out / wheel.name)
    record(
        out / wheel.name,
        "developer package: pip/uv-installable rackpy for editors, type checkers and offline "
        "graph tests; runs nothing in Rack",
    )

    # 6. The GPL corresponding source: the commit, without the files that are not RackPy's to license.
    # git archive's tar, compressed here: git's own gzip output changes with its version.
    source = out / f"rackpy-{version}-source.tar.gz"
    pathspec = ["."] + [f":(exclude){p}" for p in RESTRICTED_SOURCES]
    tar = work / "source.tar"
    run(["git", "-C", REPO, "archive", "--format=tar", f"--prefix=rackpy-{version}/", "-o", tar, facts["commit"],
         "--", *pathspec])  # fmt: skip
    with tar.open("rb") as raw, source.open("wb") as f, gzip.GzipFile("", "wb", 9, f, mtime=0) as gz:
        shutil.copyfileobj(raw, gz)
    record(source, "corresponding source (GPL-3.0-or-later)")

    manifest_data = {
        "schema_version": 1,
        "note": "RackPy release candidate. Not published: nothing here may be distributed without owner approval.",
        "rackpy_version": version,
        "commit": facts["commit"],
        "dirty": dirty,
        "source_date_epoch": epoch,
        "platform": PLATFORM,
        **({"macos_floor": MACOS_FLOOR} if MACOS else {"glibc_floor": GLIBC_FLOOR}),
        "inputs": {**build_info, "uv_lock_sha256": sha256_file(REPO / "uv.lock"), "build_tools": build_tools()},
        "excluded_from_runtime": removed,
        "restricted_sources_excluded": RESTRICTED_SOURCES,
        "third_party": components,
        ("mach_o" if MACOS else "elf"): binaries | RECORDED,
        "artifacts": artifacts,
    }
    (out / "manifest.json").write_text(json.dumps(manifest_data, indent=2, sort_keys=True) + "\n")
    sums = "".join(f"{sha256_file(p)}  {p.name}\n" for p in sorted(out.iterdir()) if p.name != "SHA256SUMS")
    (out / "SHA256SUMS").write_text(sums)
    print(f"\n{len(artifacts)} artifacts in {out}" + ("  (DIRTY CHECKOUT: do not distribute)" if dirty else ""))


def archive_members(path: Path) -> dict[str, str]:
    """Each file in an archive, by name: its SHA-256 and mode, or a symlink's target."""
    out: dict[str, str] = {}
    if path.suffix == ".whl":
        with zipfile.ZipFile(path) as zf:
            return {n: hashlib.sha256(zf.read(n)).hexdigest() for n in zf.namelist()}
    with tarfile.open(path, "r:gz") if path.name.endswith(".tar.gz") else tarfile.open(path, "r:zst") as tf:
        for member in tf:
            if member.issym():
                out[member.name] = f"-> {member.linkname}"
            elif member.isreg():
                f = tf.extractfile(member)
                assert f is not None
                out[member.name] = f"{hashlib.sha256(f.read()).hexdigest()} {member.mode:o}"
    return out


@app.command
def compare(first: Path, second: Path) -> None:
    """Compare two artifact folders (DEST/artifacts) of the same commit: list every file that differs, by member."""
    report: dict[str, Any] = {}
    names = sorted({p.name for p in first.iterdir()} | {p.name for p in second.iterdir()})
    for name in names:
        a, b = first / name, second / name
        if not a.exists() or not b.exists():
            report[name] = "only in " + (str(first) if a.exists() else str(second))
            continue
        if sha256_file(a) == sha256_file(b):
            report[name] = "identical"
            continue
        if name in {"SHA256SUMS", "manifest.json"}:
            report[name] = "differs (it records the others' hashes)"
            continue
        ma, mb = archive_members(a), archive_members(b)
        differing = sorted(n for n in set(ma) | set(mb) if ma.get(n) != mb.get(n))
        report[name] = {"differing_members": differing} if differing else "differs only in archive metadata"
    print(json.dumps(report, indent=2))


VERIFY_SCRIPT = REPO / "packaging" / "linux" / "verify-in-container.sh"
VERIFY_MAC_SCRIPT = REPO / "packaging" / "macos" / "verify.sh"
# Clean machines to install on: the oldest Linux claimed (glibc 2.23, the toolchain's floor) and a later one.
VERIFY_IMAGES = {name: REPO / "packaging" / "linux" / f"{name}.Dockerfile" for name in ("ubuntu-20.04", "ubuntu-16.04")}


@app.command
def verify(
    artifacts: Path, *, rack: Path, logs: Path, image: Literal["ubuntu-20.04", "ubuntu-16.04"] = "ubuntu-20.04"
) -> None:
    """Install ARTIFACTS on a clean machine with Rack Free at RACK, and run every example; logs go to LOGS.

    On Linux, a container: the image (packaging/linux/IMAGE.Dockerfile) has Rack's system libraries and
    Xvfb, but no Python and no RackPy checkout; the run itself has no network, as an offline machine would.
    ubuntu-16.04 has glibc 2.23, the oldest the artifacts claim.

    On a Mac, RACK is "VCV Rack 2 Free.app" and --image does not apply: packaging/macos/verify.sh installs
    the artifacts in fresh Rack user folders and runs Rack with an empty environment (no PATH beyond the
    system's, no PYTHON*, DYLD_* or developer variables), and records which libraries Rack mapped.
    """
    if MACOS:
        verify_mac(artifacts, rack, logs)
        return
    dockerfile = VERIFY_IMAGES[image]
    tag = f"rackpy-verify-{image}:" + hashlib.sha256(dockerfile.read_bytes()).hexdigest()[:12]
    run(["docker", "build", "-t", tag, "-f", dockerfile, dockerfile.parent])
    if logs.exists():
        shutil.rmtree(logs)
    logs.mkdir(parents=True)
    # A copy, so that editing the script cannot change a run under way (bash reads it as it goes).
    script = Path(tempfile.mkdtemp(prefix="rackpy-verify-")) / "verify.sh"
    shutil.copy(VERIFY_SCRIPT, script)
    try:
        run([
            "docker", "run", "--rm", "--network", "none",
            "--user", f"{os.getuid()}:{os.getgid()}", "--env", "HOME=/tmp",  # the logs stay the caller's
            "-v", f"{artifacts.resolve()}:/artifacts:ro",
            "-v", f"{rack.resolve()}:/opt/Rack2Free:ro",
            "-v", f"{script}:/verify.sh:ro",
            "-v", f"{logs.resolve()}:/logs",
            tag, "bash", "/verify.sh",
        ])  # fmt: skip
    finally:
        shutil.rmtree(script.parent)
        if (logs / "summary.txt").exists():
            print((logs / "summary.txt").read_text())


def verify_mac(artifacts: Path, rack: Path, logs: Path) -> None:
    if logs.exists():
        shutil.rmtree(logs)
    logs.mkdir(parents=True)
    scratch = Path(tempfile.mkdtemp(prefix="rackpy-verify-"))
    script = scratch / "verify.sh"  # a copy, so that editing the script cannot change a run under way
    shutil.copy(VERIFY_MAC_SCRIPT, script)
    # For the wrong-architecture case: a library for the other Mac CPU, the other pinned runtime's libpython.
    other = "mac-x64" if PLATFORM == "mac-arm64" else "mac-arm64"
    pin = json.loads((REPO / "packaging" / "inputs.json").read_text())["python_runtime"]["3.14"][other]
    alien = scratch / f"libpython-{other}.dylib"
    with tarfile.open(fetch(pin)) as tf:
        member = tf.extractfile(f"{pin['root']}/lib/{LIBPYTHON}")
        assert member is not None
        alien.write_bytes(member.read())
    home = scratch / "home"
    home.mkdir()
    env = {
        "PATH": "/usr/bin:/bin:/usr/sbin:/sbin",
        "HOME": str(home),
        "TMPDIR": "/tmp/",
        "LANG": "en_US.UTF-8",
        "JQ": shutil.which("jq") or "/usr/bin/jq",
        "ALIEN_LOADER": str(alien),
    }
    try:
        run(["/bin/bash", script, artifacts.resolve(), rack.resolve(), logs.resolve()], env=env)
    finally:
        shutil.rmtree(scratch)
        if (logs / "summary.txt").exists():
            print((logs / "summary.txt").read_text())


if __name__ == "__main__":
    app()
