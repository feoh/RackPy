def archive_directory_to_bytes(dir_path: str | os.PathLike[str], compression_level: int = 1) -> bytes: ...
def unarchive_to_directory(archive: str | os.PathLike[str] | bytes, dir_path: str | os.PathLike[str]) -> None: ...
