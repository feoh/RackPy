def get_operating_system_info() -> str: ...
def open_browser(url: str) -> None: ...
def open_directory(path: str | os.PathLike[str]) -> None: ...
def run_process_detached(path: str | os.PathLike[str]) -> None: ...
def get_fpu_flags() -> int: ...
def set_fpu_flags(flags: int) -> None: ...
def reset_fpu_flags() -> None: ...
