) -> str: ...
def get_entries(dir_path: str | os.PathLike[str], depth: int = 0) -> list[str]: ...
def exists(path: str | os.PathLike[str]) -> bool: ...
def is_file(path: str | os.PathLike[str]) -> bool: ...
def is_directory(path: str | os.PathLike[str]) -> bool: ...
def get_file_size(path: str | os.PathLike[str]) -> int: ...
def rename(src_path: str | os.PathLike[str], dest_path: str | os.PathLike[str]) -> bool: ...
def copy(src_path: str | os.PathLike[str], dest_path: str | os.PathLike[str]) -> bool: ...
def create_directory(path: str | os.PathLike[str]) -> bool: ...
def create_directories(path: str | os.PathLike[str]) -> bool: ...
def create_symbolic_link(target: str | os.PathLike[str], link: str | os.PathLike[str]) -> bool: ...
def remove(path: str | os.PathLike[str]) -> bool: ...
def remove_recursively(path: str | os.PathLike[str]) -> int: ...
def get_working_directory() -> str: ...
def set_working_directory(path: str | os.PathLike[str]) -> None: ...
def get_temp_directory() -> str: ...
def get_absolute(path: str | os.PathLike[str]) -> str: ...
def get_canonical(path: str | os.PathLike[str]) -> str: ...
def get_directory(path: str | os.PathLike[str]) -> str: ...
def get_filename(path: str | os.PathLike[str]) -> str: ...
def get_stem(path: str | os.PathLike[str]) -> str: ...
def get_extension(path: str | os.PathLike[str]) -> str: ...
def read_file(path: str | os.PathLike[str]) -> bytes: ...
def write_file(path: str | os.PathLike[str], data: bytes | bytearray | memoryview) -> None: ...
