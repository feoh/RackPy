class SharedMutex:
    """Rack's SharedMutex: many readers or one writer, with misuse refused."""

    def __init__(self) -> None: ...
    def lock(self) -> None: ...
    def try_lock(self) -> bool: ...
    def unlock(self) -> None: ...
    def lock_shared(self) -> None: ...
    def try_lock_shared(self) -> bool: ...
    def unlock_shared(self) -> None: ...
    def __enter__(self) -> SharedMutex: ...
    def __exit__(self, *exc: object) -> None: ...

class SharedLock:
    """Rack's SharedLock<TMutex>: holds a SharedMutex shared until release()."""

    def __init__(self, m: SharedMutex) -> None: ...
    @property
    def m(self) -> SharedMutex: ...
    @property
    def held(self) -> bool: ...
    def release(self) -> None: ...
    def __enter__(self) -> SharedLock: ...
    def __exit__(self, *exc: object) -> None: ...

class WeakHandle:
    """Rack's WeakHandle: the object its WeakPtrs share."""

    @property
    def ptr(self) -> Any: ...
    @property
    def count(self) -> int: ...

class WeakPtr:
    """Rack's WeakPtr<T>, for widgets: get() is None once Rack deleted the widget."""

    def __init__(self, ptr: Any = ...) -> None: ...
    def get(self) -> Any: ...
    def set(self, ptr: Any) -> None: ...
    def __bool__(self) -> bool: ...
    def __copy__(self) -> WeakPtr: ...
    @property
    def weak_handle(self) -> WeakHandle | None: ...
