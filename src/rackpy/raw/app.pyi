    def from_json(self, data: Any) -> None: ...

@final
class HostPlugWidget(HostWidget):
    def get_cable(self) -> HostCableWidget | CableWidget | None: ...
    def get_type(self) -> Any: ...

class CableWidget(Widget):
    """Rack's cable widget, made by Python: set its ports, RackWidget.add_cable it, then update_cable or set_cable."""

    color: NVGcolor
    @property
    def input_plug(self) -> HostPlugWidget: ...
    @property
    def output_plug(self) -> HostPlugWidget: ...
    input_port: PortWidget | HostWidget | None
    output_port: PortWidget | HostWidget | None
    hovered_input_port: PortWidget | HostWidget | None
    hovered_output_port: PortWidget | HostWidget | None
    @property
    def cable(self) -> _engine.Cable | None: ...
    def is_complete(self) -> bool: ...
    def update_cable(self) -> None: ...
    def set_cable(self, cable: _engine.Cable | None) -> None: ...
    def get_cable(self) -> _engine.Cable | None: ...
    def release_cable(self) -> _engine.Cable | None: ...
    def get_plug(self, type: Any) -> HostPlugWidget: ...
    def get_port(self, type: Any) -> PortWidget | HostWidget | None: ...
    def get_hovered_port(self, type: Any) -> PortWidget | HostWidget | None: ...
    def get_input_pos(self) -> Vec: ...
    def get_output_pos(self) -> Vec: ...
    def merge_json(self, data: Any) -> Any: ...
    def from_json(self, data: Any) -> None: ...

