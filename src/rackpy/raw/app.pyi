"""rack::app: Rack's controls, ports, lights and panels (RP-28A)."""

from typing import Any, overload

from rackpy.raw.engine import (
    Input,
    Light,
    LightInfo,
    LightInfoView,
    Module,
    Output,
    ParamQuantity,
    ParamQuantityView,
    PortInfo,
    PortInfoView,
)
from rackpy.raw.engine import Port as _Port
from rackpy.raw.math import Rect, Vec
from rackpy.raw.nanovg import NVGcolor
from rackpy.raw.plugin import Model
from rackpy.raw.ui import Menu
from rackpy.raw.widget import (
    HostCircularShadow,
    HostFramebufferWidget,
    HostSvgWidget,
    HostTransformWidget,
    HostWidget,
    OpaqueWidget,
    TransparentWidget,
    Widget,
)
from rackpy.raw.window import Svg

RACK_GRID_WIDTH: float
RACK_GRID_HEIGHT: float
RACK_GRID_SIZE: Vec
RACK_OFFSET: Vec

class ParamWidget(OpaqueWidget):
    module: Module | None
    param_id: int
    def init_param_quantity(self) -> None: ...
    def append_context_menu(self, menu: Menu | HostWidget) -> None: ...
    def get_param_quantity(self) -> ParamQuantityView | ParamQuantity | None: ...
    def create_tooltip(self) -> None: ...
    def destroy_tooltip(self) -> None: ...
    def create_context_menu(self) -> None: ...
    def reset_action(self) -> None: ...

class Knob(ParamWidget):
    horizontal: bool
    smooth: bool
    snap: bool
    speed: float
    force_linear: bool
    min_angle: float
    max_angle: float

class SliderKnob(Knob): ...

class Switch(ParamWidget):
    momentary: bool

class PortWidget(OpaqueWidget):
    module: Module | None
    type: _Port.Type
    port_id: int
    def get_port(self) -> Input | Output | None: ...
    def get_port_info(self) -> PortInfoView | PortInfo | None: ...
    def create_tooltip(self) -> None: ...
    def destroy_tooltip(self) -> None: ...
    def create_context_menu(self) -> None: ...
    def append_context_menu(self, menu: Menu | HostWidget) -> None: ...
    def delete_top_cable_action(self) -> None: ...

class LightWidget(TransparentWidget):
    bg_color: NVGcolor
    color: NVGcolor
    border_color: NVGcolor
    def draw_background(self, args: Any) -> None: ...
    def draw_light(self, args: Any) -> None: ...
    def draw_halo(self, args: Any) -> None: ...

class MultiLightWidget(LightWidget):
    base_colors: list[NVGcolor]
    def get_num_colors(self) -> int: ...
    def add_base_color(self, base_color: NVGcolor) -> None: ...
    def set_brightnesses(self, brightnesses: list[float]) -> None: ...

class ModuleLightWidget(MultiLightWidget):
    module: Module | None
    first_light_id: int
    def get_light(self, color_id: int) -> Light | None: ...
    def get_light_info(self) -> LightInfoView | LightInfo | None: ...
    def create_tooltip(self) -> None: ...
    def destroy_tooltip(self) -> None: ...

class CircularShadow(TransparentWidget):
    blur_radius: float
    opacity: float

class SvgKnob(Knob):
    @property
    def fb(self) -> HostFramebufferWidget: ...
    @property
    def sw(self) -> HostSvgWidget: ...
    @property
    def shadow(self) -> HostCircularShadow: ...
    @property
    def tw(self) -> HostTransformWidget: ...
    def set_svg(self, svg: Svg | None) -> None: ...
    def set_svg_legacy(self, svg: Svg | None) -> None: ...

class SvgSlider(SliderKnob):
    @property
    def fb(self) -> HostFramebufferWidget: ...
    @property
    def background(self) -> HostSvgWidget: ...
    @property
    def handle(self) -> HostSvgWidget: ...
    min_handle_pos: Vec
    max_handle_pos: Vec
    def set_background_svg(self, svg: Svg | None) -> None: ...
    def set_handle_svg(self, svg: Svg | None) -> None: ...
    def set_handle_pos(self, min_handle_pos: Vec, max_handle_pos: Vec) -> None: ...
    def set_handle_pos_centered(self, min_handle_pos_centered: Vec, max_handle_pos_centered: Vec) -> None: ...
    def set_background_svg_legacy(self, svg: Svg | None) -> None: ...
    def set_handle_svg_legacy(self, svg: Svg | None) -> None: ...
    def set_svgs(self, background_svg: Svg | None, handle_svg: Svg | None) -> None: ...

class SvgSwitch(Switch):
    @property
    def fb(self) -> HostFramebufferWidget: ...
    @property
    def sw(self) -> HostSvgWidget: ...
    @property
    def shadow(self) -> HostCircularShadow: ...
    frames: list[Svg]
    latch: bool
    def add_frame(self, svg: Svg) -> None: ...

class SvgButton(OpaqueWidget):
    @property
    def fb(self) -> HostFramebufferWidget: ...
    @property
    def sw(self) -> HostSvgWidget: ...
    @property
    def shadow(self) -> HostCircularShadow: ...
    frames: list[Svg]
    def add_frame(self, svg: Svg) -> None: ...

class SvgPort(PortWidget):
    @property
    def fb(self) -> HostFramebufferWidget: ...
    @property
    def sw(self) -> HostSvgWidget: ...
    @property
    def shadow(self) -> HostCircularShadow: ...
    def set_svg(self, svg: Svg | None) -> None: ...
    def set_svg_legacy(self, svg: Svg | None) -> None: ...

class ThemedSvgPort(SvgPort):
    light_svg: Svg | None
    dark_svg: Svg | None
    def set_svg(self, light_svg: Svg | None, dark_svg: Svg | None) -> None: ...  # type: ignore[override]

class SvgScrew(Widget):
    @property
    def fb(self) -> HostFramebufferWidget: ...
    @property
    def sw(self) -> HostSvgWidget: ...
    def set_svg(self, svg: Svg | None) -> None: ...

class ThemedSvgScrew(SvgScrew):
    light_svg: Svg | None
    dark_svg: Svg | None
    def set_svg(self, light_svg: Svg | None, dark_svg: Svg | None) -> None: ...  # type: ignore[override]

class PanelBorder(TransparentWidget): ...

class SvgPanel(Widget):
    @property
    def fb(self) -> HostFramebufferWidget: ...
    @property
    def sw(self) -> HostSvgWidget: ...
    @property
    def panel_border(self) -> HostWidget: ...
    svg: Svg | None
    def set_background(self, svg: Svg | None) -> None: ...

class ThemedSvgPanel(SvgPanel):
    light_svg: Svg | None
    dark_svg: Svg | None
    def set_background(self, light_svg: Svg | None, dark_svg: Svg | None) -> None: ...  # type: ignore[override]

class RailWidget(TransparentWidget): ...

class ModuleWidget(OpaqueWidget):
    """Rack's module widget; a widget factory makes one for a model's module (or None, a browser preview)."""

    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, module: Module | None) -> None: ...  # deprecated
    @property
    def model(self) -> Model | None: ...
    @property
    def module(self) -> Module | None: ...
    def get_model(self) -> Model | None: ...
    def set_model(self, model: Model) -> None: ...
    def get_module(self) -> Module | None: ...
    def set_module(self, module: Module | None) -> None: ...
    def get_panel(self) -> Widget | HostWidget | None: ...
    def set_panel(self, panel: Widget | Svg | None) -> None: ...
    def add_param(self, param: ParamWidget) -> None: ...
    def add_input(self, input: PortWidget) -> None: ...
    def add_output(self, output: PortWidget) -> None: ...
    def get_param(self, param_id: int) -> ParamWidget | HostWidget | None: ...
    def get_input(self, port_id: int) -> PortWidget | HostWidget | None: ...
    def get_output(self, port_id: int) -> PortWidget | HostWidget | None: ...
    def get_params(self) -> list[ParamWidget | HostWidget]: ...
    def get_ports(self) -> list[PortWidget | HostWidget]: ...
    def get_inputs(self) -> list[PortWidget | HostWidget]: ...
    def get_outputs(self) -> list[PortWidget | HostWidget]: ...
    def append_context_menu(self, menu: Menu | HostWidget) -> None: ...
    def to_json(self) -> Any: ...
    def from_json(self, data: Any) -> None: ...
    def paste_json_action(self, data: Any) -> bool: ...
    def copy_clipboard(self) -> None: ...
    def paste_clipboard_action(self) -> bool: ...
    def load(self, filename: str) -> None: ...
    def load_action(self, filename: str) -> None: ...
    def load_template(self) -> None: ...
    def load_dialog(self) -> None: ...
    def save(self, filename: str) -> None: ...
    def save_template(self) -> None: ...
    def save_template_dialog(self) -> None: ...
    def has_template(self) -> bool: ...
    def clear_template(self) -> None: ...
    def clear_template_dialog(self) -> None: ...
    def save_dialog(self) -> None: ...
    def disconnect(self) -> None: ...
    def reset_action(self) -> None: ...
    def randomize_action(self) -> None: ...
    def disconnect_action(self) -> None: ...
    def clone_action(self, clone_cables: bool = True) -> None: ...
    def bypass_action(self, bypassed: bool) -> None: ...
    def remove_action(self) -> None: ...
    def create_context_menu(self) -> None: ...
    def get_grid_position(self) -> Vec: ...
    def set_grid_position(self, pos: Vec) -> None: ...
    def get_grid_size(self) -> Vec: ...
    def get_grid_box(self) -> Rect: ...

# Rack's deprecated typedefs: the same classes; using one warns.
SVGKnob = SvgKnob
SVGSlider = SvgSlider
SVGSwitch = SvgSwitch
SVGButton = SvgButton
SVGPort = SvgPort
SVGScrew = SvgScrew
SVGPanel = SvgPanel
