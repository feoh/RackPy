class HostCableWidget(HostWidget):
    """A cable widget Rack made, a borrowed view."""

    color: NVGcolor
    @property
    def input_plug(self) -> HostPlugWidget: ...
    @property
    def output_plug(self) -> HostPlugWidget: ...
    @property
    def input_port(self) -> PortWidget | HostWidget | None: ...
    @property
    def output_port(self) -> PortWidget | HostWidget | None: ...
    @property
    def hovered_input_port(self) -> PortWidget | HostWidget | None: ...
    @property
    def hovered_output_port(self) -> PortWidget | HostWidget | None: ...
    def is_complete(self) -> bool: ...
    def update_cable(self) -> None: ...
    def get_plug(self, type: Any) -> HostPlugWidget: ...
    def get_port(self, type: Any) -> PortWidget | HostWidget | None: ...
    def get_hovered_port(self, type: Any) -> PortWidget | HostWidget | None: ...
    def get_input_pos(self) -> Vec: ...
    def get_output_pos(self) -> Vec: ...
