RACK_GRID_WIDTH: float
RACK_GRID_HEIGHT: float
RACK_GRID_SIZE: Vec
RACK_OFFSET: Vec

class ParamWidget(OpaqueWidget):
    module: Module | None
    param_id: int
    def init_param_quantity(self) -> None: ...
    def append_context_menu(self, menu: Menu | HostWidget) -> None: ...
    def get_param_quantity(self) -> ParamQuantityView | ParamQuantity | None: ...
    def create_tooltip(self) -> None: ...
    def destroy_tooltip(self) -> None: ...
    def create_context_menu(self) -> None: ...
    def reset_action(self) -> None: ...

class Knob(ParamWidget):
    horizontal: bool
    smooth: bool
    snap: bool
    speed: float
    force_linear: bool
    min_angle: float
    max_angle: float

class SliderKnob(Knob): ...

class Switch(ParamWidget):
    momentary: bool

class PortWidget(OpaqueWidget):
    module: Module | None
    type: _Port.Type
    port_id: int
    def get_port(self) -> Input | Output | None: ...
    def get_port_info(self) -> PortInfoView | PortInfo | None: ...
    def create_tooltip(self) -> None: ...
    def destroy_tooltip(self) -> None: ...
    def create_context_menu(self) -> None: ...
    def append_context_menu(self, menu: Menu | HostWidget) -> None: ...
    def delete_top_cable_action(self) -> None: ...

class LightWidget(TransparentWidget):
    bg_color: NVGcolor
    color: NVGcolor
    border_color: NVGcolor
    def draw_background(self, args: Any) -> None: ...
    def draw_light(self, args: Any) -> None: ...
    def draw_halo(self, args: Any) -> None: ...

class MultiLightWidget(LightWidget):
    base_colors: list[NVGcolor]
    def get_num_colors(self) -> int: ...
    def add_base_color(self, base_color: NVGcolor) -> None: ...
    def set_brightnesses(self, brightnesses: list[float]) -> None: ...

class ModuleLightWidget(MultiLightWidget):
    module: Module | None
    first_light_id: int
    def get_light(self, color_id: int) -> Light | None: ...
    def get_light_info(self) -> LightInfoView | LightInfo | None: ...
    def create_tooltip(self) -> None: ...
    def destroy_tooltip(self) -> None: ...

class CircularShadow(TransparentWidget):
    blur_radius: float
    opacity: float

class SvgKnob(Knob):
    @property
    def fb(self) -> HostFramebufferWidget: ...
    @property
    def sw(self) -> HostSvgWidget: ...
    @property
    def shadow(self) -> HostCircularShadow: ...
    @property
    def tw(self) -> HostTransformWidget: ...
    def set_svg(self, svg: Svg | None) -> None: ...
    def set_svg_legacy(self, svg: Svg | None) -> None: ...

class SvgSlider(SliderKnob):
    @property
    def fb(self) -> HostFramebufferWidget: ...
    @property
    def background(self) -> HostSvgWidget: ...
    @property
    def handle(self) -> HostSvgWidget: ...
    min_handle_pos: Vec
    max_handle_pos: Vec
    def set_background_svg(self, svg: Svg | None) -> None: ...
    def set_handle_svg(self, svg: Svg | None) -> None: ...
    def set_handle_pos(self, min_handle_pos: Vec, max_handle_pos: Vec) -> None: ...
    def set_handle_pos_centered(self, min_handle_pos_centered: Vec, max_handle_pos_centered: Vec) -> None: ...
    def set_background_svg_legacy(self, svg: Svg | None) -> None: ...
    def set_handle_svg_legacy(self, svg: Svg | None) -> None: ...
    def set_svgs(self, background_svg: Svg | None, handle_svg: Svg | None) -> None: ...

class SvgSwitch(Switch):
    @property
    def fb(self) -> HostFramebufferWidget: ...
    @property
    def sw(self) -> HostSvgWidget: ...
    @property
    def shadow(self) -> HostCircularShadow: ...
    frames: list[Svg]
