    def get_touched_param(self) -> ParamWidget | HostWidget | None: ...
    def set_touched_param(self, param_widget: ParamWidget | HostWidget | None) -> None: ...
    def get_module_container(self) -> HostWidget: ...
    def get_plug_container(self) -> HostWidget: ...
    def get_cable_container(self) -> HostWidget: ...
    def get_mouse_pos(self) -> Vec: ...
    def clear(self) -> None: ...
    def merge_json(self, data: Any) -> Any: ...
    def from_json(self, data: Any) -> None: ...
    def paste_json_action(self, data: Any) -> None: ...
    def paste_module_json_action(self, data: Any) -> None: ...
    def paste_clipboard_action(self) -> None: ...
    def add_module(self, module_widget: ModuleWidget | ForeignModuleWidget) -> None: ...
    def add_module_at_mouse(self, module_widget: ModuleWidget | ForeignModuleWidget) -> None: ...
    def remove_module(self, module_widget: ModuleWidget) -> None: ...
    def get_module(self, module_id: int) -> ModuleWidget | HostWidget | None: ...
    def get_modules(self) -> list[ModuleWidget | HostWidget]: ...
    def has_modules(self) -> bool: ...
    def request_module_pos(self, module_widget: ModuleWidget | HostWidget, pos: Vec) -> bool: ...
    def set_module_pos_nearest(self, module_widget: ModuleWidget | HostWidget, pos: Vec) -> None: ...
    def set_module_pos_force(self, module_widget: ModuleWidget | HostWidget, pos: Vec) -> None: ...
    def set_module_pos_squeeze(self, module_widget: ModuleWidget | HostWidget, pos: Vec) -> None: ...
    def update_module_old_positions(self) -> None: ...
    def add_cable(self, cable_widget: CableWidget) -> None: ...
    def remove_cable(self, cable_widget: CableWidget) -> None: ...
    def get_module_drag_action(self) -> _history.ComplexAction: ...
    def update_selection_from_rect(self) -> None: ...
    def select_all(self) -> None: ...
    def deselect_all(self) -> None: ...
    def select(self, module_widget: ModuleWidget | HostWidget, selected: bool = True) -> None: ...
    def has_selection(self) -> bool: ...
    def get_selected(self) -> list[ModuleWidget | HostWidget]: ...
    def is_selected(self, module_widget: ModuleWidget | HostWidget) -> bool: ...
    def selection_to_json(self, cables: bool = True) -> Any: ...
    def load_selection(self, path: str) -> None: ...
    def load_selection_dialog(self) -> None: ...
    def save_selection(self, path: str) -> None: ...
    def save_selection_dialog(self) -> None: ...
    def copy_clipboard_selection(self) -> None: ...
    def reset_selection_action(self) -> None: ...
    def randomize_selection_action(self) -> None: ...
    def disconnect_selection_action(self) -> None: ...
    def clone_selection_action(self, clone_cables: bool = True) -> None: ...
    def bypass_selection_action(self, bypassed: bool) -> None: ...
    def is_selection_bypassed(self) -> bool: ...
    def delete_selection_action(self) -> None: ...
    def request_selection_pos(self, delta: Vec) -> bool: ...
    def set_selection_pos_nearest(self, delta: Vec) -> None: ...
    def append_selection_context_menu(self, menu: Menu | HostWidget) -> None: ...
    def clear_cables(self) -> None: ...
    def clear_cables_action(self) -> None: ...
    def clear_cables_on_port(self, port: PortWidget | HostWidget) -> None: ...
    def get_incomplete_cable(self) -> HostCableWidget | CableWidget | None: ...
    def get_top_plug(self, port: PortWidget | HostWidget) -> HostPlugWidget | None: ...
    def get_top_cable(self, port: PortWidget | HostWidget) -> HostCableWidget | CableWidget | None: ...
    @overload
    def get_cable(self, cable_id: int) -> HostCableWidget | CableWidget | None: ...
    @overload
    def get_cable(
        self, output_port: PortWidget | HostWidget, input_port: PortWidget | HostWidget
    ) -> HostCableWidget | CableWidget | None: ...
    def get_cables(self) -> list[HostCableWidget | CableWidget]: ...
    def get_complete_cables(self) -> list[HostCableWidget | CableWidget]: ...
    def get_incomplete_cables(self) -> list[HostCableWidget | CableWidget]: ...
