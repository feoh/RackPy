# SDK quantities with weak module links and UI-safe virtuals, owned by Python
# until a class factory (config_param(..., quantity_type=...)) moves one into a
# module slot (RP-14B2b6).
class ParamQuantity(Quantity):
    param_id: int
    min_value: float
    max_value: float
    default_value: float
    name: str
    unit: str
    display_base: float
    display_multiplier: float
    display_offset: float
    display_precision: int
    description: str
    reset_enabled: bool
    randomize_enabled: bool
    smooth_enabled: bool
    snap_enabled: bool
    def __init__(self) -> None: ...
    @property
    def alive(self) -> bool: ...
    @property
    def module(self) -> Module | None: ...
    @module.setter
    def module(self, value: Module | None) -> None: ...
    def get_param(self) -> Param | None: ...
    def get_immediate_value(self) -> float: ...
    def set_immediate_value(self, value: float) -> None: ...
    def get_description(self) -> str: ...
    def set_smooth_value(self, value: float) -> None: ...
    def get_smooth_value(self) -> float: ...
    # Rack's toJson/fromJson; a subclass may override both (RP-15A). An override
    # returns a dict: Rack's paramsToJson adds "id" to it (RP-15C).
    def to_json(self) -> dict[str, Any]: ...
    def from_json(self, data: Any) -> None: ...

class SwitchQuantity(ParamQuantity):
    @property
    def labels(self) -> SwitchLabels: ...
    @labels.setter
    def labels(self, value: Sequence[str] | SwitchLabels) -> None: ...

# T is what reading returns, V what a raw edit takes (RP-14B2b7): a component
# value, or for metadata vectors a Python-created object or None. Inside the
# constructor callback a raw edit can leave a metadata slot None until the seal
# checks it; the item types describe the sealed module.
class Components[T, V]:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> T: ...
    def __iter__(self) -> Iterator[T]: ...
    def __setitem__(self, index: int, value: V) -> None: ...
    def __delitem__(self, index: int) -> None: ...
    def insert(self, index: int, value: V) -> None: ...
    def append(self, value: V) -> None: ...
    def clear(self) -> None: ...
    def resize(self, size: int) -> None: ...

class Module:
    class BypassRoute:
        input_id: int
        output_id: int
        def __init__(self) -> None: ...

    # Rack's event records (RP-14C3): plain values.
    class AddEvent:
        def __init__(self) -> None: ...

    class RemoveEvent:
        def __init__(self) -> None: ...

    class BypassEvent:
        def __init__(self) -> None: ...

    class UnBypassEvent:
        def __init__(self) -> None: ...

    class ResetEvent:
        def __init__(self) -> None: ...

    class RandomizeEvent:
        def __init__(self) -> None: ...

    class SaveEvent:
        def __init__(self) -> None: ...

    class SetMasterEvent:
        def __init__(self) -> None: ...

    class UnsetMasterEvent:
        def __init__(self) -> None: ...

    class PortChangeEvent:
        connecting: bool
        type: Port.Type
        port_id: int
        def __init__(self, connecting: bool = False, type: Port.Type = ..., port_id: int = 0) -> None: ...

    class SampleRateChangeEvent:
        sample_rate: float
        sample_time: float
        def __init__(self, sample_rate: float = 44100.0, sample_time: float = ...) -> None: ...

    type LifecycleEvent = (
        AddEvent
        | RemoveEvent
        | BypassEvent
        | UnBypassEvent
        | PortChangeEvent
        | ResetEvent
        | RandomizeEvent
        | SampleRateChangeEvent
        | SaveEvent
        | SetMasterEvent
        | UnsetMasterEvent
    )
    # Native kernels (RP-17A): the module's audio path; see rackpy.dsp.kernel.
    def set_kernel(self, kernel: _dsp.Kernel) -> None: ...
    @property
    def kernel(self) -> _dsp.Kernel | None: ...
    @property
    def kernel_failed(self) -> bool: ...
    # JSON (RP-15A). JSON values: None, bool, int, float, str, list, tuple, dict.
    def set_data_handlers(
        self,
        to_json: Callable[[], object] | None = None,
        from_json: Callable[[Any], object] | None = None,
    ) -> None: ...  # only inside the constructor callback
    def to_json(self) -> dict[str, Any]: ...
    def from_json(self, data: dict[str, Any]) -> None: ...
    def params_to_json(self) -> list[dict[str, Any]]: ...
    def params_from_json(self, data: list[dict[str, Any]]) -> None: ...
    def data_to_json(self) -> Any: ...
    def data_from_json(self, data: object) -> None: ...
    # Patch storage (RP-15B): needs an engine ID and Rack's live context.
    def get_patch_storage_directory(self) -> str: ...
    def create_patch_storage_directory(self) -> str: ...
    def patch_storage(self, create: bool = True) -> pathlib.Path: ...
    def lifecycle_events(self) -> list[tuple[int, Module.LifecycleEvent]]: ...
    @property
    def dropped_lifecycle_events(self) -> int: ...
    # Direct dispatch of Rack's handlers; Python-owned, sealed modules only.
    @overload
    def on_add(self, e: AddEvent) -> None: ...
    @overload
    def on_add(self) -> None: ...  # deprecated in Rack
    @overload
    def on_remove(self, e: RemoveEvent) -> None: ...
    @overload
    def on_remove(self) -> None: ...  # deprecated in Rack
    def on_bypass(self, e: BypassEvent) -> None: ...
    def on_un_bypass(self, e: UnBypassEvent) -> None: ...
    def on_port_change(self, e: PortChangeEvent) -> None: ...
    @overload
    def on_reset(self, e: ResetEvent) -> None: ...
    @overload
    def on_reset(self) -> None: ...  # deprecated in Rack
    @overload
    def on_randomize(self, e: RandomizeEvent) -> None: ...
    @overload
    def on_randomize(self) -> None: ...  # deprecated in Rack
    @overload
    def on_sample_rate_change(self, e: SampleRateChangeEvent) -> None: ...
    @overload
    def on_sample_rate_change(self) -> None: ...  # deprecated in Rack
    def on_save(self, e: SaveEvent) -> None: ...
    def on_set_master(self, e: SetMasterEvent) -> None: ...
    def on_unset_master(self, e: UnsetMasterEvent) -> None: ...
    @overload
    @staticmethod
    def create(configure: Callable[[Module], object] | None = None) -> Module: ...
    # Rack's deprecated counting constructor: warns DeprecationWarning.
    @overload
    @staticmethod
    def create(
        num_params: int,
        num_inputs: int,
        num_outputs: int,
        num_lights: int = 0,
        configure: Callable[[Module], object] | None = None,
    ) -> Module: ...
    @property
    def id(self) -> int: ...
    @id.setter
    def id(self, value: int) -> None: ...  # only inside the constructor callback
    def get_id(self) -> int: ...
    def is_bypassed(self) -> bool: ...
    def close(self) -> None: ...
    @property
    def alive(self) -> bool: ...
    def config(self, num_params: int, num_inputs: int, num_outputs: int, num_lights: int = 0) -> None: ...
    @overload
    def config_param(
        self,
        param_id: int,
        min_value: float,
        max_value: float,
        default_value: float,
        name: str = "",
        unit: str = "",
        display_base: float = 0.0,
        display_multiplier: float = 1.0,
        display_offset: float = 0.0,
        quantity_type: None = None,
    ) -> ParamQuantityView: ...
    @overload
    def config_param[Q: ParamQuantity](
        self,
        param_id: int,
        min_value: float,
        max_value: float,
        default_value: float,
        name: str = "",
        unit: str = "",
        display_base: float = 0.0,
        display_multiplier: float = 1.0,
        display_offset: float = 0.0,
        *,
        quantity_type: type[Q],
    ) -> Q: ...
    @overload
    def config_switch(
        self,
        param_id: int,
        min_value: float,
        max_value: float,
        default_value: float,
        name: str = "",
        labels: Sequence[str] = (),
        quantity_type: None = None,
    ) -> SwitchQuantityView: ...
    @overload
    def config_switch[S: SwitchQuantity](
        self,
        param_id: int,
        min_value: float,
        max_value: float,
        default_value: float,
        name: str = "",
        labels: Sequence[str] = (),
        *,
        quantity_type: type[S],
    ) -> S: ...
    @overload
    def config_button(self, param_id: int, name: str = "", quantity_type: None = None) -> SwitchQuantityView: ...
    @overload
    def config_button[S: SwitchQuantity](self, param_id: int, name: str = "", *, quantity_type: type[S]) -> S: ...
    def get_param_quantity(self, index: int) -> ParamQuantityView | ParamQuantity: ...
    @property
    def param_quantities(self) -> Components[ParamQuantityView | ParamQuantity, ParamQuantity | None]: ...
    @overload
    def config_input(self, port_id: int, name: str = "", info_type: None = None) -> PortInfoView: ...
    @overload
    def config_input[P: PortInfo](self, port_id: int, name: str = "", *, info_type: type[P]) -> P: ...
    @overload
    def config_output(self, port_id: int, name: str = "", info_type: None = None) -> PortInfoView: ...
    @overload
    def config_output[P: PortInfo](self, port_id: int, name: str = "", *, info_type: type[P]) -> P: ...
    @overload
    def config_light(self, light_id: int, name: str = "", info_type: None = None) -> LightInfoView: ...
    @overload
    def config_light[L: LightInfo](self, light_id: int, name: str = "", *, info_type: type[L]) -> L: ...
    def get_input_info(self, index: int) -> PortInfoView | PortInfo: ...
    def get_output_info(self, index: int) -> PortInfoView | PortInfo: ...
    def get_light_info(self, index: int) -> LightInfoView | LightInfo | None: ...
    @property
    def input_infos(self) -> Components[PortInfoView | PortInfo, PortInfo | None]: ...
    @property
    def output_infos(self) -> Components[PortInfoView | PortInfo, PortInfo | None]: ...
    @property
    def light_infos(self) -> Components[LightInfoView | LightInfo | None, LightInfo | None]: ...
    def config_bypass(self, input_id: int, output_id: int) -> None: ...
    def get_num_params(self) -> int: ...
    def get_num_inputs(self) -> int: ...
    def get_num_outputs(self) -> int: ...
    def get_num_lights(self) -> int: ...
    def get_param(self, index: int) -> Param: ...
    def get_input(self, index: int) -> Input: ...
    def get_output(self, index: int) -> Output: ...
    def get_light(self, index: int) -> Light: ...
    @property
    def params(self) -> Components[Param, Param]: ...
    @property
    def inputs(self) -> Components[Input, Input]: ...
    @property
    def outputs(self) -> Components[Output, Output]: ...
    @property
    def lights(self) -> Components[Light, Light]: ...
    @property
    def bypass_routes(self) -> Components[Module.BypassRoute, Module.BypassRoute]: ...

