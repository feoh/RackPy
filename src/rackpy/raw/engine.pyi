    def get_description(self) -> str: ...

# Built-in borrowed adapters, deliberately distinct from standalone subclassable
# PortInfo/LightInfo, which config_* transfers when given info_type (RP-14B2b5).
# Raw identity-field/vector mutation: RP-14B2b.
