# Built-in borrowed adapters, deliberately distinct from standalone subclassable
# PortInfo/LightInfo, which config_* transfers when given info_type (RP-14B2b5).
# Raw identity-field/vector mutation: RP-14B2b.
class PortInfoView:
    name: str
    description: str
    # Identity fields: assignable only inside the constructor callback.
    type: Port.Type
    port_id: int
    @property
    def alive(self) -> bool: ...
    @property
    def module(self) -> Module | None: ...
    @module.setter
    def module(self, value: Module | None) -> None: ...
    def get_name(self) -> str: ...
    def get_full_name(self) -> str: ...
    def get_description(self) -> str: ...

