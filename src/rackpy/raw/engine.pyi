    def get_brightness(self) -> float: ...
    @overload
    def set_brightness_smooth(self, brightness: float, frames: int = 1) -> None: ...
    @overload
    def set_brightness_smooth(self, brightness: float, delta_time: float, lambda_: float = 30.0) -> None: ...
    def set_smooth_brightness(self, brightness: float, delta_time: float) -> None: ...
