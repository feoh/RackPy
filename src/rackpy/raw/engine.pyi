# SDK quantities with weak module links and UI-safe virtuals, owned by Python
# until a class factory (config_param(..., quantity_type=...)) moves one into a
# module slot (RP-14B2b6).
class ParamQuantity(Quantity):
    param_id: int
    min_value: float
    max_value: float
    default_value: float
    name: str
    unit: str
    display_base: float
    display_multiplier: float
    display_offset: float
    display_precision: int
    description: str
    reset_enabled: bool
    randomize_enabled: bool
    smooth_enabled: bool
    snap_enabled: bool
    def __init__(self) -> None: ...
    @property
    def alive(self) -> bool: ...
    @property
    def module(self) -> Module | None: ...
    @module.setter
    def module(self, value: Module | None) -> None: ...
    def get_param(self) -> Param | None: ...
    def get_immediate_value(self) -> float: ...
    def set_immediate_value(self, value: float) -> None: ...
    def get_description(self) -> str: ...
    def set_smooth_value(self, value: float) -> None: ...
    def get_smooth_value(self) -> float: ...

class SwitchQuantity(ParamQuantity):
    @property
    def labels(self) -> SwitchLabels: ...
    @labels.setter
    def labels(self, value: Sequence[str] | SwitchLabels) -> None: ...

class Components[T]:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> T: ...
    def __iter__(self) -> Iterator[T]: ...

class Module:
    class BypassRoute:
        input_id: int
        output_id: int
        def __init__(self) -> None: ...

    @staticmethod
    def create(configure: Callable[[Module], object] | None = None) -> Module: ...
    def close(self) -> None: ...
    @property
    def alive(self) -> bool: ...
    def config(self, num_params: int, num_inputs: int, num_outputs: int, num_lights: int = 0) -> None: ...
    @overload
    def config_param(
        self,
        param_id: int,
        min_value: float,
        max_value: float,
        default_value: float,
        name: str = "",
        unit: str = "",
        display_base: float = 0.0,
        display_multiplier: float = 1.0,
        display_offset: float = 0.0,
        quantity_type: None = None,
    ) -> ParamQuantityView: ...
    @overload
    def config_param[Q: ParamQuantity](
        self,
        param_id: int,
        min_value: float,
        max_value: float,
        default_value: float,
        name: str = "",
        unit: str = "",
        display_base: float = 0.0,
        display_multiplier: float = 1.0,
        display_offset: float = 0.0,
        *,
        quantity_type: type[Q],
    ) -> Q: ...
    @overload
    def config_switch(
        self,
        param_id: int,
        min_value: float,
        max_value: float,
        default_value: float,
        name: str = "",
        labels: Sequence[str] = (),
        quantity_type: None = None,
    ) -> SwitchQuantityView: ...
    @overload
    def config_switch[S: SwitchQuantity](
        self,
        param_id: int,
        min_value: float,
        max_value: float,
        default_value: float,
        name: str = "",
        labels: Sequence[str] = (),
        *,
        quantity_type: type[S],
    ) -> S: ...
    @overload
    def config_button(self, param_id: int, name: str = "", quantity_type: None = None) -> SwitchQuantityView: ...
    @overload
    def config_button[S: SwitchQuantity](self, param_id: int, name: str = "", *, quantity_type: type[S]) -> S: ...
    def get_param_quantity(self, index: int) -> ParamQuantityView | ParamQuantity: ...
    @property
    def param_quantities(self) -> Components[ParamQuantityView | ParamQuantity]: ...
    @overload
    def config_input(self, port_id: int, name: str = "", info_type: None = None) -> PortInfoView: ...
    @overload
    def config_input[P: PortInfo](self, port_id: int, name: str = "", *, info_type: type[P]) -> P: ...
    @overload
    def config_output(self, port_id: int, name: str = "", info_type: None = None) -> PortInfoView: ...
    @overload
    def config_output[P: PortInfo](self, port_id: int, name: str = "", *, info_type: type[P]) -> P: ...
    @overload
    def config_light(self, light_id: int, name: str = "", info_type: None = None) -> LightInfoView: ...
    @overload
    def config_light[L: LightInfo](self, light_id: int, name: str = "", *, info_type: type[L]) -> L: ...
    def get_input_info(self, index: int) -> PortInfoView | PortInfo: ...
    def get_output_info(self, index: int) -> PortInfoView | PortInfo: ...
    def get_light_info(self, index: int) -> LightInfoView | LightInfo | None: ...
    @property
    def input_infos(self) -> Components[PortInfoView | PortInfo]: ...
    @property
    def output_infos(self) -> Components[PortInfoView | PortInfo]: ...
    @property
    def light_infos(self) -> Components[LightInfoView | LightInfo | None]: ...
    def config_bypass(self, input_id: int, output_id: int) -> None: ...
    def get_num_params(self) -> int: ...
    def get_num_inputs(self) -> int: ...
    def get_num_outputs(self) -> int: ...
    def get_num_lights(self) -> int: ...
    def get_param(self, index: int) -> Param: ...
    def get_input(self, index: int) -> Input: ...
    def get_output(self, index: int) -> Output: ...
    def get_light(self, index: int) -> Light: ...
    @property
    def params(self) -> Components[Param]: ...
    @property
    def inputs(self) -> Components[Input]: ...
    @property
    def outputs(self) -> Components[Output]: ...
    @property
    def lights(self) -> Components[Light]: ...
    @property
    def bypass_routes(self) -> tuple[BypassRoute, ...]: ...

