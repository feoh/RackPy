class Voltages:
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> float: ...
    def __setitem__(self, i: int, value: float) -> None: ...
    def __iter__(self) -> Iterator[float]: ...
    def __buffer__(self, flags: int) -> memoryview: ...
    def tolist(self) -> list[float]: ...
    def snapshot(self) -> array.array[float]: ...

class Port:
    class Type(enum.Enum):
        INPUT = 0
        OUTPUT = 1

    value: float
    channels: int
    active: int
    voltage: float
    channel_count: int
    def __init__(self) -> None: ...
    def set_voltage(self, voltage: float, channel: int = 0) -> None: ...
    def get_voltage(self, channel: int = 0) -> float: ...
    def get_poly_voltage(self, channel: int) -> float: ...
    def get_normal_voltage(self, normal_voltage: float, channel: int = 0) -> float: ...
    def get_normal_poly_voltage(self, normal_voltage: float, channel: int) -> float: ...
    def get_voltages(self, first_channel: int = 0) -> Voltages: ...
    def read_voltages(self) -> list[float]: ...
    def write_voltages(self, voltages: Sequence[float]) -> None: ...
    def clear_voltages(self) -> None: ...
    def get_voltage_sum(self) -> float: ...
    def get_voltage_rms(self) -> float: ...
    def set_channels(self, channels: int) -> None: ...
    def get_channels(self) -> int: ...
    def is_connected(self) -> bool: ...
    def is_monophonic(self) -> bool: ...
    def is_polyphonic(self) -> bool: ...
    def normalize(self, normal_voltage: float) -> float: ...
    @property
    def voltages(self) -> Voltages: ...
    @property
    def plug_lights(self) -> tuple[Light, Light, Light]: ...
    @property
    def connected(self) -> bool: ...
    @property
    def monophonic(self) -> bool: ...
    @property
    def polyphonic(self) -> bool: ...
    @property
    def alive(self) -> bool: ...

class Input(Port): ...
class Output(Port): ...

class PortInfo:
    module: Module | None
