# Stub for the native rackpy.raw.engine (native/bindings/engine/).
import array
import enum
from collections.abc import Callable, Iterator, Sequence
from typing import overload

PORT_MAX_CHANNELS: int

class Light:
    value: float
    brightness: float
    def __init__(self) -> None: ...
    def set_brightness(self, brightness: float) -> None: ...
    def get_brightness(self) -> float: ...
    @overload
    def set_brightness_smooth(self, brightness: float, frames: int = 1) -> None: ...
    @overload
    def set_brightness_smooth(self, brightness: float, delta_time: float, lambda_: float = 30.0) -> None: ...
    def set_smooth_brightness(self, brightness: float, delta_time: float) -> None: ...
    @property
    def alive(self) -> bool: ...

class Param:
    value: float
    def __init__(self) -> None: ...
    def get_value(self) -> float: ...
    def set_value(self, value: float) -> None: ...
    @property
    def alive(self) -> bool: ...

class Voltages:
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> float: ...
    def __setitem__(self, i: int, value: float) -> None: ...
    def __iter__(self) -> Iterator[float]: ...
    def __buffer__(self, flags: int) -> memoryview: ...
    def tolist(self) -> list[float]: ...
    def snapshot(self) -> array.array[float]: ...

class Port:
    class Type(enum.Enum):
        INPUT = 0
        OUTPUT = 1

    value: float
    channels: int
    active: int
    voltage: float
    channel_count: int
    def __init__(self) -> None: ...
    def set_voltage(self, voltage: float, channel: int = 0) -> None: ...
    def get_voltage(self, channel: int = 0) -> float: ...
    def get_poly_voltage(self, channel: int) -> float: ...
    def get_normal_voltage(self, normal_voltage: float, channel: int = 0) -> float: ...
    def get_normal_poly_voltage(self, normal_voltage: float, channel: int) -> float: ...
    def get_voltages(self, first_channel: int = 0) -> Voltages: ...
    def read_voltages(self) -> list[float]: ...
    def write_voltages(self, voltages: Sequence[float]) -> None: ...
    def clear_voltages(self) -> None: ...
    def get_voltage_sum(self) -> float: ...
    def get_voltage_rms(self) -> float: ...
    def set_channels(self, channels: int) -> None: ...
    def get_channels(self) -> int: ...
    def is_connected(self) -> bool: ...
    def is_monophonic(self) -> bool: ...
    def is_polyphonic(self) -> bool: ...
    def normalize(self, normal_voltage: float) -> float: ...
    @property
    def voltages(self) -> Voltages: ...
    @property
    def plug_lights(self) -> tuple[Light, Light, Light]: ...
    @property
    def connected(self) -> bool: ...
    @property
    def monophonic(self) -> bool: ...
    @property
    def polyphonic(self) -> bool: ...
    @property
    def alive(self) -> bool: ...

class Input(Port): ...
class Output(Port): ...

class PortInfo:
    type: Port.Type
    port_id: int
    name: str
    description: str
    def __init__(self) -> None: ...
    def get_name(self) -> str: ...
    def get_full_name(self) -> str: ...
    def get_description(self) -> str: ...

# Built-in borrowed adapters, deliberately distinct from standalone subclassable
# PortInfo/LightInfo. Factory/subclass transfer and raw identity mutation: RP-14B2.
class PortInfoView:
    name: str
    description: str
    @property
    def alive(self) -> bool: ...
    @property
    def module(self) -> Module: ...
    @property
    def type(self) -> Port.Type: ...
    @property
    def port_id(self) -> int: ...
    def get_name(self) -> str: ...
    def get_full_name(self) -> str: ...
    def get_description(self) -> str: ...

class LightInfoView:
    name: str
    description: str
    @property
    def alive(self) -> bool: ...
    @property
    def module(self) -> Module: ...
    @property
    def light_id(self) -> int: ...
    def get_name(self) -> str: ...
    def get_description(self) -> str: ...

# Checked built-ins only: no standalone constructor or Python virtual dispatch.
class ParamQuantityView:
    min_value: float
    max_value: float
    default_value: float
    name: str
    unit: str
    display_base: float
    display_multiplier: float
    display_offset: float
    display_precision: int
    description: str
    reset_enabled: bool
    randomize_enabled: bool
    smooth_enabled: bool
    snap_enabled: bool
    @property
    def alive(self) -> bool: ...
    @property
    def module(self) -> Module: ...
    @property
    def param_id(self) -> int: ...
    def get_param(self) -> Param: ...
    def get_min_value(self) -> float: ...
    def get_max_value(self) -> float: ...
    def get_default_value(self) -> float: ...
    def get_display_precision(self) -> int: ...
    def get_label(self) -> str: ...
    def get_unit(self) -> str: ...
    def get_description(self) -> str: ...
    def get_value(self) -> float: ...
    def set_value(self, value: float) -> None: ...
    def get_immediate_value(self) -> float: ...
    def set_immediate_value(self, value: float) -> None: ...
    def get_display_value(self) -> float: ...
    def set_display_value(self, display_value: float) -> None: ...
    def get_display_value_string(self) -> str: ...
    def set_display_value_string(self, s: str) -> None: ...
    def reset(self) -> None: ...
    def randomize(self) -> None: ...
    def set_smooth_value(self, value: float) -> None: ...
    def get_smooth_value(self) -> float: ...

class SwitchQuantityView(ParamQuantityView):
    labels: list[str]

class Components[T]:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> T: ...
    def __iter__(self) -> Iterator[T]: ...

class Module:
    class BypassRoute:
        input_id: int
        output_id: int
        def __init__(self) -> None: ...

    @staticmethod
    def create(configure: Callable[[Module], object] | None = None) -> Module: ...
    def close(self) -> None: ...
    @property
    def alive(self) -> bool: ...
    def config(self, num_params: int, num_inputs: int, num_outputs: int, num_lights: int = 0) -> None: ...
    def config_param(
        self,
        param_id: int,
        min_value: float,
        max_value: float,
        default_value: float,
        name: str = "",
        unit: str = "",
        display_base: float = 0.0,
        display_multiplier: float = 1.0,
        display_offset: float = 0.0,
    ) -> ParamQuantityView: ...
    def config_switch(
        self,
        param_id: int,
        min_value: float,
        max_value: float,
        default_value: float,
        name: str = "",
        labels: Sequence[str] = (),
    ) -> SwitchQuantityView: ...
    def config_button(self, param_id: int, name: str = "") -> SwitchQuantityView: ...
    def get_param_quantity(self, index: int) -> ParamQuantityView: ...
    @property
    def param_quantities(self) -> Components[ParamQuantityView]: ...
    def config_input(self, port_id: int, name: str = "") -> PortInfoView: ...
    def config_output(self, port_id: int, name: str = "") -> PortInfoView: ...
    def config_light(self, light_id: int, name: str = "") -> LightInfoView: ...
    def get_input_info(self, index: int) -> PortInfoView: ...
    def get_output_info(self, index: int) -> PortInfoView: ...
    def get_light_info(self, index: int) -> LightInfoView | None: ...
    @property
    def input_infos(self) -> Components[PortInfoView]: ...
    @property
    def output_infos(self) -> Components[PortInfoView]: ...
    @property
    def light_infos(self) -> Components[LightInfoView | None]: ...
    def config_bypass(self, input_id: int, output_id: int) -> None: ...
    def get_num_params(self) -> int: ...
    def get_num_inputs(self) -> int: ...
    def get_num_outputs(self) -> int: ...
    def get_num_lights(self) -> int: ...
    def get_param(self, index: int) -> Param: ...
    def get_input(self, index: int) -> Input: ...
    def get_output(self, index: int) -> Output: ...
    def get_light(self, index: int) -> Light: ...
    @property
    def params(self) -> Components[Param]: ...
    @property
    def inputs(self) -> Components[Input]: ...
    @property
    def outputs(self) -> Components[Output]: ...
    @property
    def lights(self) -> Components[Light]: ...
    @property
    def bypass_routes(self) -> tuple[BypassRoute, ...]: ...

class LightInfo:
    light_id: int
    name: str
    description: str
    def __init__(self) -> None: ...
    def get_name(self) -> str: ...
    def get_description(self) -> str: ...
