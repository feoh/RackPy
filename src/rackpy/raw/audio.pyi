"""rack::audio: Rack's audio drivers and devices, and Python-owned audio ports."""

from typing import Any, final

from rackpy.raw import Context

@final
class Driver:
    """One of Rack's audio drivers, by its ID."""

    @property
    def id(self) -> int: ...
    def get_name(self) -> str: ...
    def get_device_ids(self) -> list[int]: ...
    def get_default_device_id(self) -> int: ...
    def get_device_name(self, device_id: int) -> str: ...
    def get_device_num_inputs(self, device_id: int) -> int: ...
    def get_device_num_outputs(self, device_id: int) -> int: ...
    def subscribe(self, device_id: int, port: Port) -> Device | None: ...
    def unsubscribe(self, device_id: int, port: Port) -> None: ...

@final
class PortView:
    """A port Python did not make (a module's), listed by a device's subscribers; read-only."""

    @property
    def alive(self) -> bool: ...
    @property
    def driver_id(self) -> int: ...
    @property
    def device_id(self) -> int: ...
    @property
    def input_offset(self) -> int: ...
    @property
    def output_offset(self) -> int: ...
    @property
    def max_inputs(self) -> int: ...
    @property
    def max_outputs(self) -> int: ...

@final
class Device:
    """An audio device, through the Python port that holds it."""

    @property
    def alive(self) -> bool: ...
    def get_name(self) -> str: ...
    def get_num_inputs(self) -> int: ...
    def get_num_outputs(self) -> int: ...
    def get_sample_rates(self) -> list[float]: ...
    def get_sample_rate(self) -> float: ...
    def set_sample_rate(self, sample_rate: float) -> None: ...
    def get_block_sizes(self) -> list[int]: ...
    def get_block_size(self) -> int: ...
    def set_block_size(self, block_size: int) -> None: ...
    @property
    def subscribed(self) -> list[Port | PortView]: ...
    def subscribe(self, port: Port) -> None: ...
    def unsubscribe(self, port: Port) -> None: ...

class Port:
    """Rack's audio port. Python owns it; main thread, in Rack's live UI context."""

    input_offset: int
    output_offset: int
    max_inputs: int
    max_outputs: int
    def __init__(self) -> None: ...
    @property
    def driver_id(self) -> int: ...
    @property
    def device_id(self) -> int: ...
    @property
    def driver(self) -> Driver | None: ...
    @property
    def device(self) -> Device | None: ...
    @property
    def context(self) -> Context | None: ...
    def reset(self) -> None: ...
    def get_driver(self) -> Driver | None: ...
    def get_driver_id(self) -> int: ...
    def set_driver_id(self, driver_id: int) -> None: ...
    def get_driver_name(self) -> str: ...
    def get_device(self) -> Device | None: ...
    def get_device_ids(self) -> list[int]: ...
    def get_device_id(self) -> int: ...
    def set_device_id(self, device_id: int) -> None: ...
    def get_device_num_inputs(self, device_id: int) -> int: ...
    def get_device_num_outputs(self, device_id: int) -> int: ...
    def get_device_name(self, device_id: int) -> str: ...
    def get_sample_rates(self) -> list[float]: ...
    def get_sample_rate(self) -> float: ...
    def set_sample_rate(self, sample_rate: float) -> None: ...
    def get_block_sizes(self) -> list[int]: ...
    def get_block_size(self) -> int: ...
    def set_block_size(self, block_size: int) -> None: ...
    def get_num_inputs(self) -> int: ...
    def get_num_outputs(self) -> int: ...
    def to_json(self) -> Any: ...
    def from_json(self, data: Any) -> None: ...
    def process_buffer(self, input: Any, input_stride: int, output: Any, output_stride: int, frames: int) -> None: ...
    def process_input(self, input: Any, input_stride: int, frames: int) -> None: ...
    def process_output(self, output: Any, output_stride: int, frames: int) -> None: ...
    def on_start_stream(self) -> None: ...
    def on_stop_stream(self) -> None: ...
    @property
    def stream_stats(self) -> dict[str, int]: ...

def get_driver_ids() -> list[int]: ...
def get_driver(driver_id: int) -> Driver | None: ...
