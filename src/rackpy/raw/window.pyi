"""rack::window: the OS window, its NanoVG resources (Font, Image, Svg) and unit helpers."""

from typing import final, overload

from rackpy.raw.math import Vec
from rackpy.raw.widget import GraphicsContext

SVG_DPI: float
MM_PER_IN: float

@overload
def in2px(inches: float) -> float: ...
@overload
def in2px(inches: Vec) -> Vec: ...
@overload
def mm2px(mm: float) -> float: ...
@overload
def mm2px(mm: Vec) -> Vec: ...

@final
class NativeHandle:
    @property
    def kind(self) -> str: ...
    @property
    def alive(self) -> bool: ...

class Svg:
    def __init__(self) -> None: ...
    @staticmethod
    def load(filename: str) -> Svg | None: ...
    def load_file(self, filename: str) -> None: ...
    def load_string(self, data: str) -> None: ...
    def get_size(self) -> Vec: ...
    def get_num_shapes(self) -> int: ...
    def get_num_paths(self) -> int: ...
    def get_num_points(self) -> int: ...
    def draw(self, graphics: GraphicsContext) -> None: ...
    @property
    def handle(self) -> NativeHandle | None: ...

SVG = Svg  # deprecated: using it warns

def svg_draw(vg: GraphicsContext, svg: NativeHandle) -> None: ...

@final
class Font:
    def __init__(self) -> None: ...
    @property
    def alive(self) -> bool: ...
    @property
    def handle(self) -> int: ...
    @property
    def vg(self) -> NativeHandle | None: ...
    def load_file(self, filename: str, vg: NativeHandle | GraphicsContext) -> None: ...
    @staticmethod
    def load(filename: str) -> Font | None: ...

@final
class Image:
    def __init__(self) -> None: ...
    @property
    def alive(self) -> bool: ...
    @property
    def handle(self) -> int: ...
    @property
    def vg(self) -> NativeHandle | None: ...
    def load_file(self, filename: str, vg: NativeHandle | GraphicsContext) -> None: ...
    @staticmethod
    def load(filename: str) -> Image | None: ...

@final
class Window:
    @property
    def alive(self) -> bool: ...
    @property
    def win(self) -> NativeHandle: ...
    @property
    def vg(self) -> NativeHandle | None: ...
    @property
    def fb_vg(self) -> NativeHandle | None: ...
    pixel_ratio: float
    window_ratio: float
    @property
    def ui_font(self) -> Font | None: ...
    @ui_font.setter
    def ui_font(self, font: Font) -> None: ...
    def get_size(self) -> Vec: ...
    def set_size(self, size: Vec) -> None: ...
    def close(self) -> None: ...
    def cursor_lock(self) -> None: ...
    def cursor_unlock(self) -> None: ...
    def is_cursor_locked(self) -> bool: ...
    def get_mods(self) -> int: ...
    def set_full_screen(self, full_screen: bool) -> None: ...
    def is_full_screen(self) -> bool: ...
    def get_monitor_refresh_rate(self) -> float: ...
    def get_frame_time(self) -> float: ...
    def get_last_frame_duration(self) -> float: ...
    def get_frame_duration_remaining(self) -> float: ...
    def load_font(self, filename: str) -> Font | None: ...
    def load_font_without_fallbacks(self, filename: str) -> Font | None: ...
    def load_image(self, filename: str) -> Image | None: ...
    def load_svg(self, filename: str) -> Svg | None: ...
