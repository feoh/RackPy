"""rack::midi: MIDI messages, Rack's MIDI drivers and devices, and Python-owned ports."""

from typing import Any, final

from rackpy.raw import Context

class Message:
    """Rack's MIDI message: bytes (three zeros at first) and the engine frame it belongs to (-1: now)."""

    bytes: list[int]
    frame: int
    def __init__(self) -> None: ...
    def get_size(self) -> int: ...
    def set_size(self, size: int) -> None: ...
    def get_channel(self) -> int: ...
    def set_channel(self, channel: int) -> None: ...
    def get_status(self) -> int: ...
    def set_status(self, status: int) -> None: ...
    def get_note(self) -> int: ...
    def set_note(self, note: int) -> None: ...
    def get_value(self) -> int: ...
    def set_value(self, value: int) -> None: ...
    def to_string(self) -> str: ...
    def get_frame(self) -> int: ...
    def set_frame(self, frame: int) -> None: ...

@final
class Driver:
    """One of Rack's MIDI drivers, by its ID."""

    @property
    def id(self) -> int: ...
    def get_name(self) -> str: ...
    def get_input_device_ids(self) -> list[int]: ...
    def get_default_input_device_id(self) -> int: ...
    def get_input_device_name(self, device_id: int) -> str: ...
    def get_output_device_ids(self) -> list[int]: ...
    def get_default_output_device_id(self) -> int: ...
    def get_output_device_name(self, device_id: int) -> str: ...
    def subscribe_input(self, device_id: int, input: Input) -> InputDevice | None: ...
    def unsubscribe_input(self, device_id: int, input: Input) -> None: ...
    def subscribe_output(self, device_id: int, output: Output) -> OutputDevice | None: ...
    def unsubscribe_output(self, device_id: int, output: Output) -> None: ...

class Device:
    """A MIDI device, through the Python port that holds it."""

    @property
    def alive(self) -> bool: ...
    def get_name(self) -> str: ...

@final
class PortView:
    """A port Python did not make (a module's), listed by a device's subscribers; read-only."""

    @property
    def alive(self) -> bool: ...
    @property
    def driver_id(self) -> int: ...
    @property
    def device_id(self) -> int: ...
    @property
    def channel(self) -> int: ...

class InputDevice(Device):
    @property
    def subscribed(self) -> list[Input | PortView]: ...
    def subscribe(self, input: Input) -> None: ...
    def unsubscribe(self, input: Input) -> None: ...
    def on_message(self, message: Message) -> None: ...

class OutputDevice(Device):
    @property
    def subscribed(self) -> list[Output | PortView]: ...
    def subscribe(self, output: Output) -> None: ...
    def unsubscribe(self, output: Output) -> None: ...
    def send_message(self, message: Message) -> None: ...

class Port:
    """Rack's MIDI port: make an Input, InputQueue or Output."""

    channel: int
    @property
    def driver_id(self) -> int: ...
    @property
    def device_id(self) -> int: ...
    @property
    def driver(self) -> Driver | None: ...
    @property
    def device(self) -> Device | None: ...
    @property
    def context(self) -> Context | None: ...
    def get_driver(self) -> Driver | None: ...
    def get_driver_id(self) -> int: ...
    def set_driver_id(self, driver_id: int) -> None: ...
    def get_device(self) -> Device | None: ...
    def get_device_id(self) -> int: ...
    def set_device_id(self, device_id: int) -> None: ...
    def get_device_ids(self) -> list[int]: ...
    def get_default_device_id(self) -> int: ...
    def get_device_name(self, device_id: int) -> str: ...
    def get_channels(self) -> list[int]: ...
    def get_channel(self) -> int: ...
    def set_channel(self, channel: int) -> None: ...
    def get_channel_name(self, channel: int) -> str: ...
    def to_json(self) -> Any: ...
    def from_json(self, data: Any) -> None: ...

class Input(Port):
    """Rack's MIDI input. Override on_message: RackPy calls it on the UI thread (queued)."""

    def __init__(self) -> None: ...
    @property
    def input_device(self) -> InputDevice | None: ...
    def reset(self) -> None: ...
    def on_message(self, message: Message) -> None: ...
    @property
    def dropped(self) -> int: ...

@final
class InputQueue(Input):
    def try_pop(self, max_frame: int) -> Message | None: ...
    def size(self) -> int: ...

class Output(Port):
    def __init__(self) -> None: ...
    @property
    def output_device(self) -> OutputDevice | None: ...
    def reset(self) -> None: ...
    def send_message(self, message: Message) -> None: ...

@final
class PythonInputDevice:
    """An input device of a PythonDriver: Python pushes messages into it."""

    @property
    def id(self) -> int: ...
    @property
    def alive(self) -> bool: ...
    @property
    def removed(self) -> bool: ...
    name: str
    @property
    def subscribed(self) -> list[Input | PortView]: ...
    def push_message(self, message: Message) -> None: ...

@final
class PythonOutputDevice:
    """An output device of a PythonDriver: what Rack's ports send is queued for Python."""

    @property
    def id(self) -> int: ...
    @property
    def alive(self) -> bool: ...
    @property
    def removed(self) -> bool: ...
    name: str
    @property
    def subscribed(self) -> list[Output | PortView]: ...
    def take_sent(self) -> list[Message]: ...
    @property
    def dropped(self) -> int: ...

@final
class PythonDriver:
    """A MIDI driver Python configures; add_driver gives it to Rack."""

    def __init__(self, name: str) -> None: ...
    @property
    def registered_id(self) -> int: ...
    name: str
    def add_input_device(self, name: str) -> PythonInputDevice: ...
    def add_output_device(self, name: str) -> PythonOutputDevice: ...
    def remove_input_device(self, device: PythonInputDevice) -> None: ...
    def remove_output_device(self, device: PythonOutputDevice) -> None: ...

def add_driver(driver_id: int, driver: PythonDriver) -> None: ...
def get_driver_ids() -> list[int]: ...
def get_driver(driver_id: int) -> Driver | None: ...
