# Stub for the native rackpy.raw.dsp (native/bindings/dsp/) and its Python part (_dsp.py).
from collections.abc import Buffer, Callable, Iterator, Sequence
from typing import Any, ClassVar, overload

from rackpy.raw.simd import Template, float_4

FREQ_C4: float
FREQ_A4: float
FREQ_SEMITONE: float

# Element-type templates: a float is T = float, a float_4 is T = float_4, and a float mixed with a
# float_4 broadcasts.
@overload
def sinc(x: float) -> float: ...
@overload
def sinc(x: float_4) -> float_4: ...
@overload
def amplitude_to_db(amp: float) -> float: ...
@overload
def amplitude_to_db(amp: float_4) -> float_4: ...
@overload
def db_to_amplitude(db: float) -> float: ...
@overload
def db_to_amplitude(db: float_4) -> float_4: ...
@overload
def quadratic_bipolar(x: float) -> float: ...
@overload
def quadratic_bipolar(x: float_4) -> float_4: ...
@overload
def cubic(x: float) -> float: ...
@overload
def cubic(x: float_4) -> float_4: ...
@overload
def quartic_bipolar(x: float) -> float: ...
@overload
def quartic_bipolar(x: float_4) -> float_4: ...
@overload
def quintic(x: float) -> float: ...
@overload
def quintic(x: float_4) -> float_4: ...
@overload
def sqrt_bipolar(x: float) -> float: ...
@overload
def sqrt_bipolar(x: float_4) -> float_4: ...
@overload
def exponential_bipolar(b: float, x: float) -> float: ...  # type: ignore[overload-overlap]
@overload
def exponential_bipolar(b: float_4 | float, x: float_4 | float) -> float_4: ...
@overload
def poly_direct(a: Sequence[float], x: float) -> float: ...  # type: ignore[overload-overlap]
@overload
def poly_direct(a: Sequence[float_4 | float], x: float_4 | float) -> float_4: ...
@overload
def poly_horner(a: Sequence[float], x: float) -> float: ...  # type: ignore[overload-overlap]
@overload
def poly_horner(a: Sequence[float_4 | float], x: float_4 | float) -> float_4: ...
@overload
def poly_estrin(a: Sequence[float], x: float) -> float: ...  # type: ignore[overload-overlap]
@overload
def poly_estrin(a: Sequence[float_4 | float], x: float_4 | float) -> float_4: ...
@overload
def exp2_floor(x: float) -> tuple[float, float]: ...
@overload
def exp2_floor(x: float_4) -> tuple[float_4, float_4]: ...
@overload
def approx_exp2_floor(x: float) -> tuple[float, float]: ...
@overload
def approx_exp2_floor(x: float_4) -> tuple[float_4, float_4]: ...
@overload
def exp2_taylor5(x: float) -> float: ...
@overload
def exp2_taylor5(x: float_4) -> float_4: ...
@overload
def approx_exp2_taylor5(x: float) -> float: ...
@overload
def approx_exp2_taylor5(x: float_4) -> float_4: ...
@overload
def hann(p: float) -> float: ...
@overload
def hann(p: float_4) -> float_4: ...
@overload
def blackman(alpha: float, p: float) -> float: ...  # type: ignore[overload-overlap]
@overload
def blackman(alpha: float_4 | float, p: float_4 | float) -> float_4: ...
@overload
def blackman_nuttall(p: float) -> float: ...
@overload
def blackman_nuttall(p: float_4) -> float_4: ...
@overload
def blackman_harris(p: float) -> float: ...
@overload
def blackman_harris(p: float_4) -> float_4: ...
def hann_window(x: Buffer, len: int) -> None: ...
def blackman_window(alpha: float, x: Buffer, len: int) -> None: ...
def blackman_nuttall_window(x: Buffer, len: int) -> None: ...
def blackman_harris_window(x: Buffer, len: int) -> None: ...

# f(t, x, dxdt): x is a read-only copy, dxdt a zeroed array('f') (or list of float_4) to fill.
@overload
def step_euler(t: float, dt: float, x: Buffer, len: int, f: Callable[[float, memoryview, Any], object]) -> None: ...
@overload
def step_euler(
    t: float_4 | float, dt: float_4 | float, x: list[float_4], len: int, f: Callable[[float_4, Any, Any], object]
) -> None: ...
@overload
def step_rk2(t: float, dt: float, x: Buffer, len: int, f: Callable[[float, memoryview, Any], object]) -> None: ...
@overload
def step_rk2(
    t: float_4 | float, dt: float_4 | float, x: list[float_4], len: int, f: Callable[[float_4, Any, Any], object]
) -> None: ...
@overload
def step_rk4(t: float, dt: float, x: Buffer, len: int, f: Callable[[float, memoryview, Any], object]) -> None: ...
@overload
def step_rk4(
    t: float_4 | float, dt: float_4 | float, x: list[float_4], len: int, f: Callable[[float_4, Any, Any], object]
) -> None: ...

class Int24:
    i: int
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, i: int) -> None: ...
    def __int__(self) -> int: ...
    def __copy__(self) -> Int24: ...
    def __deepcopy__(self, memo: dict[int, Any]) -> Int24: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]

# convert[To, From] is a specialization: f(x) for one sample, f(in_, out, len) for buffers.
convert: Template

class Float4Samples:
    def __len__(self) -> int: ...
    def __getitem__(self, i: int) -> float_4: ...
    def __setitem__(self, i: int, value: float_4 | float) -> None: ...
    def __iter__(self) -> Iterator[float_4]: ...

class _FrameMeta(type):
    # At run time Frame uses __class_getitem__; typed here as indexing the class.
    def __getitem__(cls, args: Any) -> type[Frame]: ...

class Frame(metaclass=_FrameMeta):
    CHANNELS: ClassVar[int]
    type: ClassVar[type[float] | type[float_4]]
    def __init__(self) -> None: ...
    @property
    def samples(self) -> Any: ...  # a memoryview for T = float, a Float4Samples for T = float_4
    def __buffer__(self, flags: int, /) -> memoryview: ...
    def __copy__(self) -> Frame: ...
    def __deepcopy__(self, memo: dict[int, Any]) -> Frame: ...
    __hash__: ClassVar[None]  # type: ignore[assignment]
