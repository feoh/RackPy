from collections.abc import Callable, Iterator, Sequence
from typing import Any, final, overload

from rackpy.raw import app as _app
from rackpy.raw import ui as _ui
from rackpy.raw.engine import EngineModule, Module

@final
class LibraryHandle: ...

@final
class PluginList(Sequence[Plugin]):
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> Plugin: ...
    @overload
    def __getitem__(self, index: slice) -> tuple[Plugin, ...]: ...
    def __iter__(self) -> Iterator[Plugin]: ...
    def __contains__(self, value: object) -> bool: ...

@final
class Plugin:
    def __init__(self) -> None:
        """Make an isolated plugin, not registered with Rack; close it on the main thread."""
    def close(self) -> None:
        """Destroy an isolated plugin; loaded Rack plugins cannot be closed from Python."""
    @property
    def alive(self) -> bool: ...
    slug: str  # writable only on isolated plugins before models are attached; loaded slugs are registered identities
    name: str
    version: str
    license: str
    brand: str
    description: str
    author: str
    author_email: str
    author_url: str
    plugin_url: str
    manual_url: str
    source_url: str
    donate_url: str
    changelog_url: str
    @property
    def path(self) -> str: ...
    @property
    def modified_timestamp(self) -> float: ...
    @property
    def handle(self) -> LibraryHandle | None: ...
    @property
    def models(self) -> tuple[Model, ...]: ...
    def add_model(self, model: Model) -> None: ...
    def get_model(self, slug: str) -> Model | None: ...
    def get_brand(self) -> str: ...
    def from_json(self, data: dict[str, Any]) -> None: ...
    def modules_from_json(self, data: list[dict[str, Any]]) -> None: ...

@final
class Model:
    @property
    def alive(self) -> bool: ...
    slug: str
    @property
    def plugin(self) -> Plugin | None: ...
    name: str
    description: str
    manual_url: str
    modular_grid_url: str
    hidden: bool
    tag_ids: list[int]
    def get_full_name(self) -> str: ...
    def get_factory_preset_directory(self) -> str: ...
    def get_user_preset_directory(self) -> str: ...
    def get_manual_url(self) -> str: ...
    def is_favorite(self) -> bool: ...
    def set_favorite(self, favorite: bool) -> None: ...
    def from_json(self, data: dict[str, Any]) -> None: ...
    def append_context_menu(self, menu: _ui.Menu, in_browser: bool = False) -> None: ...
    def create_module(self) -> Module | EngineModule:
        """Make a module of a committed model; detached and staged models cannot make modules."""
    def create_module_widget(
        self, module: Module | EngineModule | None = None
    ) -> _app.ModuleWidget | _app.ForeignModuleWidget:
        """Make a widget of a committed model; detached and staged models cannot make widgets."""

def create_model(
    slug: str,
    module_factory: Callable[[Module], object],
    *,
    widget_factory: Callable[[Module | None], _app.ModuleWidget] | None = None,
    hp: int = 4,
) -> Model: ...
def plugin_instance() -> Plugin: ...
def is_slug_valid(slug: str) -> bool: ...
def normalize_slug(slug: str) -> str: ...
def get_plugin(plugin_slug: str) -> Plugin | None: ...
def get_plugin_fallback(plugin_slug: str) -> Plugin | None: ...
def get_model(plugin_slug: str, model_slug: str) -> Model | None: ...
def get_model_fallback(plugin_slug: str, model_slug: str) -> Model | None: ...
def model_from_json(module_json: dict[str, Any]) -> Model: ...

plugins: PluginList
pluginsPath: str

def on_destroy[F: Callable[[], object]](callback: F) -> F: ...
def set_settings_handlers(
    to_json: Callable[[], Any] | None = None, from_json: Callable[[Any], object] | None = None
) -> None: ...
