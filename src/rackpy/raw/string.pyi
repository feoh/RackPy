"""rack::string: text, UTF-8, Base64, versions and translations."""

from collections.abc import Iterable, Sequence
from typing import overload

def f(format: str, *args: int | float | str | bytes) -> str: ...
def fv(format: str, args: Sequence[int | float | str | bytes]) -> str: ...
def lowercase(s: str) -> str: ...
def uppercase(s: str) -> str: ...
def trim(s: str) -> str: ...
def truncate(s: str, max_codepoints: int) -> str: ...
def truncate_prefix(s: str, max_codepoints: int) -> str: ...
def ellipsize(s: str, max_codepoints: int) -> str: ...
def ellipsize_prefix(s: str, max_codepoints: int) -> str: ...
def starts_with(s: str, prefix: str) -> bool: ...
def ends_with(s: str, suffix: str) -> bool: ...

class Location:
    line: int
    column: int
    def __init__(self, line: int = 0, column: int = 0) -> None: ...

def position_to_location(s: str | bytes, pos: int) -> Location: ...
def location_to_position(s: str | bytes, location: Location) -> int: ...
def to_base64(data: bytes | bytearray | memoryview) -> str: ...
def from_base64(s: str) -> bytes: ...
def strcasecmp(s1: str, s2: str) -> int: ...

class CaseInsensitiveCompare:
    def __init__(self) -> None: ...
    def __call__(self, a: str, b: str) -> bool: ...

def join(container: Iterable[str], seperator: str = "") -> str: ...
def split(s: str, seperator: str, max_tokens: int = 0) -> list[str]: ...
def format_time(format: str, timestamp: float) -> str: ...
def format_time_iso(timestamp: float) -> str: ...
def utf32_to_utf8(s32: Sequence[int]) -> bytes: ...
def utf8_to_utf32(s8: str | bytes) -> list[int]: ...
def utf8_next_codepoint(s8: str | bytes, pos: int) -> int: ...
def utf8_prev_codepoint(s8: str | bytes, pos: int) -> int: ...
def utf8_length(s8: str | bytes) -> int: ...
def utf8_codepoint_index(s8: str | bytes, pos: int) -> int: ...
def utf8_codepoint_pos(s8: str | bytes, index: int) -> int: ...

class Version:
    parts: list[str]
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, s: str) -> None: ...
    def __lt__(self, other: Version) -> bool: ...
    def get_major(self) -> str: ...
    def get_minor(self) -> str: ...
    def get_revision(self) -> str: ...

@overload
def translate(id: str) -> str: ...
@overload
def translate(id: str, language: str) -> str: ...
def get_languages() -> list[str]: ...
def init() -> None: ...
