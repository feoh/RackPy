from rackpy.raw.math import Rect, Vec
from rackpy.raw.window import Svg

@final
class GraphicsContext:
    @property
    def alive(self) -> bool: ...

@final
class Framebuffer:
    @property
    def alive(self) -> bool: ...

@final
class WidgetChildren(Sequence[Widget | HostWidget]):
    """Rack's Widget::children: a live, read-only, checked view (main thread only).

    Iteration walks the children present when it starts. Change the children
    through ``add_child``, ``remove_child`` and the other ownership methods.
    """

    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int) -> Widget | HostWidget: ...
    @overload
    def __getitem__(self, index: slice) -> tuple[Widget | HostWidget, ...]: ...
    def __iter__(self) -> Iterator[Widget | HostWidget]: ...
    def __reversed__(self) -> Iterator[Widget | HostWidget]: ...
    def __contains__(self, value: object) -> bool: ...
    def index(self, value: object) -> int: ...  # type: ignore[override]
    def count(self, value: object) -> int: ...
    def __eq__(self, other: object) -> bool: ...
    __hash__: None  # type: ignore[assignment]
    def copy(self) -> tuple[Widget | HostWidget, ...]: ...
    def __copy__(self) -> tuple[Widget | HostWidget, ...]: ...

class HostWidget:
    """Checked nonowning host identity; not a transferable Widget."""

    def get_weak_count(self) -> int: ...
    @property
    def weak_handle(self) -> Any: ...
    @property
    def alive(self) -> bool: ...
    @property
    def parent(self) -> Widget | HostWidget | None: ...
    def get_box(self) -> Rect: ...
    def add_child(self, child: Widget) -> None: ...
    def step(self) -> None: ...
    def draw(self, args: Any) -> None: ...
    def draw_layer(self, args: Any, layer: int) -> None: ...
    def on_hover(self, event: Any) -> None: ...
    def on_button(self, event: Any) -> None: ...
    def on_double_click(self, event: Any) -> None: ...
    def on_hover_key(self, event: Any) -> None: ...
    def on_hover_text(self, event: Any) -> None: ...
    def on_hover_scroll(self, event: Any) -> None: ...
    def on_enter(self, event: Any) -> None: ...
    def on_leave(self, event: Any) -> None: ...
    def on_select(self, event: Any) -> None: ...
    def on_deselect(self, event: Any) -> None: ...
    def on_select_key(self, event: Any) -> None: ...
    def on_select_text(self, event: Any) -> None: ...
    def on_drag_start(self, event: Any) -> None: ...
    def on_drag_end(self, event: Any) -> None: ...
    def on_drag_move(self, event: Any) -> None: ...
    def on_drag_hover(self, event: Any) -> None: ...
    def on_drag_enter(self, event: Any) -> None: ...
    def on_drag_leave(self, event: Any) -> None: ...
    def on_drag_drop(self, event: Any) -> None: ...
    def on_path_drop(self, event: Any) -> None: ...
    def on_action(self, event: Any) -> None: ...
    def on_change(self, event: Any) -> None: ...
    def on_dirty(self, event: Any) -> None: ...
    def on_reposition(self, event: Any) -> None: ...
    def on_resize(self, event: Any) -> None: ...
    def on_show(self, event: Any) -> None: ...
    def on_hide(self, event: Any) -> None: ...

class HostFramebufferWidget(HostWidget):
    """A Rack-owned FramebufferWidget's public fields."""

    dirty: bool
    bypassed: bool
    oversample: float
    dirty_on_subpixel_change: bool
    def set_dirty(self, dirty: bool = True) -> None: ...
    def get_framebuffer_size(self) -> Vec: ...
    def get_image_handle(self) -> int: ...

class HostSvgWidget(HostWidget):
    """A Rack-owned SvgWidget's public fields."""

    svg: Svg | None
    def set_svg(self, svg: Svg | None) -> None: ...
    def wrap(self) -> None: ...

class HostTransformWidget(HostWidget):
    """A Rack-owned TransformWidget's public fields."""

    @property
    def transform(self) -> tuple[float, float, float, float, float, float]: ...
    @transform.setter
    def transform(self, value: tuple[float, float, float, float, float, float]) -> None: ...
    def identity(self) -> None: ...
    def translate(self, delta: Vec) -> None: ...
    def scale(self, scale: Vec) -> None: ...
    @overload
    def rotate(self, angle: float) -> None: ...
    @overload
    def rotate(self, angle: float, origin: Vec) -> None: ...

class HostCircularShadow(HostWidget):
    """A Rack-owned CircularShadow's public fields."""

    blur_radius: float
    opacity: float

class EventContext:
    propagating: bool
    consumed: bool
    target: Widget | HostWidget | None
    def __init__(
        self, *, propagating: bool = ..., consumed: bool = ..., target: Widget | HostWidget | None = ...
    ) -> None: ...

class BaseEvent:
    context: EventContext | None
    def __init__(self, *, context: EventContext | None = ...) -> None: ...
    def stop_propagating(self) -> None: ...
    def is_propagating(self) -> bool: ...
    def set_target(self, widget: Widget | HostWidget | None) -> None: ...
    def get_target(self) -> Widget | HostWidget | None: ...
    def consume(self, widget: Widget | HostWidget | None) -> None: ...
    def unconsume(self) -> None: ...
    def is_consumed(self) -> bool: ...

# Nested event classes derive from Widget.BaseEvent, and a PEP 695 `type` alias cannot be a base class.
_BaseEvent: TypeAlias = BaseEvent  # noqa: UP040

class Widget:
    BaseEvent: TypeAlias = _BaseEvent  # noqa: UP040
    def get_weak_count(self) -> int: ...
    @property
    def weak_handle(self) -> Any: ...

    class PositionBaseEvent:
        def __init__(self, *, pos: Vec | WidgetVecView = ...) -> None: ...
        @property
        def pos(self) -> Vec: ...
        @pos.setter
        def pos(self, value: Vec | WidgetVecView) -> None: ...

    class KeyBaseEvent:
        def __init__(
            self, *, key: int = ..., scancode: int = ..., key_name: str = ..., action: int = ..., mods: int = ...
        ) -> None: ...
        key: int
        scancode: int
        key_name: str
        action: int
        mods: int
        def is_key_command(self, key: int, mods: int = 0) -> bool: ...

    class TextBaseEvent:
        def __init__(self, *, codepoint: int = ...) -> None: ...
        codepoint: int

    class DragBaseEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ..., button: int = ...) -> None: ...
        button: int

    class DrawArgs:
        def __init__(
            self,
            *,
            vg: GraphicsContext | None = ...,
            fb: Framebuffer | None = ...,
            clip_box: Rect | WidgetBoxView = ...,
        ) -> None: ...
        vg: GraphicsContext | None
        fb: Framebuffer | None
        @property
        def clip_box(self) -> Rect: ...
        @clip_box.setter
        def clip_box(self, value: Rect | WidgetBoxView) -> None: ...

    class HoverEvent(BaseEvent, PositionBaseEvent):
        def __init__(
            self,
            *,
            context: EventContext | None = ...,
            pos: Vec | WidgetVecView = ...,
            mouse_delta: Vec | WidgetVecView = ...,
        ) -> None: ...
        @property
        def mouse_delta(self) -> Vec: ...
        @mouse_delta.setter
        def mouse_delta(self, value: Vec | WidgetVecView) -> None: ...

    class ButtonEvent(BaseEvent, PositionBaseEvent):
        def __init__(
            self,
            *,
            context: EventContext | None = ...,
            pos: Vec | WidgetVecView = ...,
            button: int = ...,
            action: int = ...,
            mods: int = ...,
        ) -> None: ...
        button: int
        action: int
        mods: int

    class DoubleClickEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class HoverKeyEvent(BaseEvent, PositionBaseEvent, KeyBaseEvent):
        def __init__(
            self,
            *,
            context: EventContext | None = ...,
            pos: Vec | WidgetVecView = ...,
            key: int = ...,
            scancode: int = ...,
            key_name: str = ...,
            action: int = ...,
            mods: int = ...,
        ) -> None: ...

    class HoverTextEvent(BaseEvent, PositionBaseEvent, TextBaseEvent):
        def __init__(
            self, *, context: EventContext | None = ..., pos: Vec | WidgetVecView = ..., codepoint: int = ...
        ) -> None: ...

    class HoverScrollEvent(BaseEvent, PositionBaseEvent):
        def __init__(
            self,
            *,
            context: EventContext | None = ...,
            pos: Vec | WidgetVecView = ...,
            scroll_delta: Vec | WidgetVecView = ...,
        ) -> None: ...
        @property
        def scroll_delta(self) -> Vec: ...
        @scroll_delta.setter
        def scroll_delta(self, value: Vec | WidgetVecView) -> None: ...

    class EnterEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class LeaveEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class SelectEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class DeselectEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class SelectKeyEvent(BaseEvent, KeyBaseEvent):
        def __init__(
            self,
            *,
            context: EventContext | None = ...,
            key: int = ...,
            scancode: int = ...,
            key_name: str = ...,
            action: int = ...,
            mods: int = ...,
        ) -> None: ...

    class SelectTextEvent(BaseEvent, TextBaseEvent):
        def __init__(self, *, context: EventContext | None = ..., codepoint: int = ...) -> None: ...

    class DragStartEvent(DragBaseEvent):
        def __init__(self, *, context: EventContext | None = ..., button: int = ...) -> None: ...

    class DragEndEvent(DragBaseEvent):
        def __init__(self, *, context: EventContext | None = ..., button: int = ...) -> None: ...

    class DragMoveEvent(DragBaseEvent):
        def __init__(
            self, *, context: EventContext | None = ..., button: int = ..., mouse_delta: Vec | WidgetVecView = ...
        ) -> None: ...
        @property
        def mouse_delta(self) -> Vec: ...
        @mouse_delta.setter
        def mouse_delta(self, value: Vec | WidgetVecView) -> None: ...

    class DragHoverEvent(DragBaseEvent, PositionBaseEvent):
        def __init__(
            self,
            *,
            context: EventContext | None = ...,
            button: int = ...,
            pos: Vec | WidgetVecView = ...,
            origin: Widget | HostWidget | None = ...,
            mouse_delta: Vec | WidgetVecView = ...,
        ) -> None: ...
        origin: Widget | HostWidget | None
        @property
        def mouse_delta(self) -> Vec: ...
        @mouse_delta.setter
        def mouse_delta(self, value: Vec | WidgetVecView) -> None: ...

    class DragEnterEvent(DragBaseEvent):
        def __init__(
            self, *, context: EventContext | None = ..., button: int = ..., origin: Widget | HostWidget | None = ...
        ) -> None: ...
        origin: Widget | HostWidget | None

    class DragLeaveEvent(DragBaseEvent):
        def __init__(
            self, *, context: EventContext | None = ..., button: int = ..., origin: Widget | HostWidget | None = ...
        ) -> None: ...
        origin: Widget | HostWidget | None

    class DragDropEvent(DragBaseEvent):
        def __init__(
            self, *, context: EventContext | None = ..., button: int = ..., origin: Widget | HostWidget | None = ...
        ) -> None: ...
        origin: Widget | HostWidget | None

    class PathDropEvent(BaseEvent, PositionBaseEvent):
        def __init__(
            self, paths: Sequence[str] = (), *, context: EventContext | None = ..., pos: Vec | WidgetVecView = ...
        ) -> None: ...
        @property
        def paths(self) -> list[str]: ...
        @paths.setter
        def paths(self, value: Sequence[str]) -> None: ...

    class ActionEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class ChangeEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class DirtyEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class RepositionEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class ResizeEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class AddEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class RemoveEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class ShowEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class HideEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ...) -> None: ...

    class ContextCreateEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ..., vg: GraphicsContext | None = ...) -> None: ...
        vg: GraphicsContext | None

    class ContextDestroyEvent(BaseEvent):
        def __init__(self, *, context: EventContext | None = ..., vg: GraphicsContext | None = ...) -> None: ...
        vg: GraphicsContext | None

    def __init__(self) -> None: ...
    @property
    def alive(self) -> bool: ...
    @property
    def box(self) -> WidgetBoxView: ...
    @box.setter
    def box(self, value: Rect | WidgetBoxView) -> None: ...
    visible: bool
    requested_delete: bool
    @property
    def parent(self) -> Widget | HostWidget | None: ...
    @property
    def children(self) -> WidgetChildren: ...
    def close(self) -> None: ...
    def add_child(self, child: Widget) -> None: ...
    def add_child_bottom(self, child: Widget) -> None: ...
    def add_child_above(self, child: Widget, sibling: Widget) -> None: ...
    def add_child_below(self, child: Widget, sibling: Widget) -> None: ...
    def remove_child(self, child: Widget) -> None: ...
    def clear_children(self) -> None: ...
    def remove_from_parent(self) -> None: ...
    def attach_to_scene(self) -> None: ...
    def step(self) -> None: ...
    def request_delete(self) -> None: ...
    def has_child(self, child: Widget | HostWidget | None) -> bool: ...
    def get_parent(self) -> Widget | HostWidget | None: ...
    def get_box(self) -> Rect: ...
    def set_box(self, box: Rect | WidgetBoxView) -> None: ...
    def get_position(self) -> Vec: ...
    def set_position(self, position: Vec | WidgetVecView) -> None: ...
    def get_size(self) -> Vec: ...
    def set_size(self, size: Vec | WidgetVecView) -> None: ...
    def is_visible(self) -> bool: ...
    def set_visible(self, visible: bool) -> None: ...
    def show(self) -> None: ...
    def hide(self) -> None: ...
    def get_children_bounding_box(self) -> Rect: ...
    def get_visible_children_bounding_box(self) -> Rect: ...
    def get_relative_offset(self, value: Vec | WidgetVecView, ancestor: Widget | HostWidget | None) -> Vec: ...
    def get_relative_zoom(self, ancestor: Widget | HostWidget | None) -> float: ...
    def get_absolute_offset(self, position: Vec | WidgetVecView) -> Vec: ...
    def get_absolute_zoom(self) -> float: ...
    def get_viewport(self, rect: Rect | WidgetBoxView = ...) -> Rect: ...
    def is_descendant_of(self, ancestor: Widget | HostWidget | None) -> bool: ...
    def draw(self, args: DrawArgs) -> None: ...
    def draw_vg(self, graphics: GraphicsContext) -> None: ...
    def draw_layer(self, args: DrawArgs, layer: int) -> None: ...
    def draw_child(self, child: Widget | HostWidget, args: DrawArgs, layer: int = 0) -> None: ...
    def on_hover(self, event: HoverEvent) -> None: ...
    def on_button(self, event: ButtonEvent) -> None: ...
    def on_double_click(self, event: DoubleClickEvent) -> None: ...
    def on_hover_key(self, event: HoverKeyEvent) -> None: ...
    def on_hover_text(self, event: HoverTextEvent) -> None: ...
    def on_hover_scroll(self, event: HoverScrollEvent) -> None: ...
    def on_enter(self, event: EnterEvent) -> None: ...
    def on_leave(self, event: LeaveEvent) -> None: ...
    def on_select(self, event: SelectEvent) -> None: ...
    def on_deselect(self, event: DeselectEvent) -> None: ...
    def on_select_key(self, event: SelectKeyEvent) -> None: ...
    def on_select_text(self, event: SelectTextEvent) -> None: ...
    def on_drag_start(self, event: DragStartEvent) -> None: ...
    def on_drag_end(self, event: DragEndEvent) -> None: ...
    def on_drag_move(self, event: DragMoveEvent) -> None: ...
    def on_drag_hover(self, event: DragHoverEvent) -> None: ...
    def on_drag_enter(self, event: DragEnterEvent) -> None: ...
    def on_drag_leave(self, event: DragLeaveEvent) -> None: ...
    def on_drag_drop(self, event: DragDropEvent) -> None: ...
    def on_path_drop(self, event: PathDropEvent) -> None: ...
    def on_action(self, event: ActionEvent) -> None: ...
    def on_change(self, event: ChangeEvent) -> None: ...
    def on_dirty(self, event: DirtyEvent) -> None: ...
    def on_reposition(self, event: RepositionEvent) -> None: ...
    def on_resize(self, event: ResizeEvent) -> None: ...
    def on_add(self, event: AddEvent) -> None: ...
    def on_remove(self, event: RemoveEvent) -> None: ...
    def on_show(self, event: ShowEvent) -> None: ...
    def on_hide(self, event: HideEvent) -> None: ...
    def on_context_create(self, event: ContextCreateEvent) -> None: ...
    def on_context_destroy(self, event: ContextDestroyEvent) -> None: ...
    # Rack's member templates: a class (Python subclasses too) for T, a handler for the member pointer.
    def get_ancestor_of_type[T: Widget](self, cls: type[T]) -> T | HostWidget | None: ...
    def get_first_descendant_of_type[T: Widget](self, cls: type[T]) -> T | HostWidget | None: ...
    def recurse_event(self, method: Callable[..., None], event: BaseEvent) -> None: ...
    def recurse_position_event(self, method: Callable[..., None], event: BaseEvent) -> None: ...

