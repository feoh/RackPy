from typing import final

from rackpy.raw.math import Rect

# Internal test-hooks builds only; absent from production.
def _native_root_count() -> int: ...

@final
class WidgetNode:
    """Detached native-only tree adapter; not the complete Widget binding."""
    @staticmethod
    def create() -> WidgetNode: ...
    @property
    def alive(self) -> bool: ...
    @property
    def parent(self) -> WidgetNode | None: ...
    @property
    def children(self) -> tuple[WidgetNode, ...]: ...
    def close(self) -> None: ...
    def add_child(self, child: WidgetNode) -> None: ...
    def add_child_bottom(self, child: WidgetNode) -> None: ...
    def remove_child(self, child: WidgetNode) -> None: ...
    def clear_children(self) -> None: ...
    def has_child(self, child: WidgetNode) -> bool: ...
    def get_box(self) -> Rect: ...
    def set_box(self, box: Rect) -> None: ...
    def is_visible(self) -> bool: ...
    def set_visible(self, visible: bool) -> None: ...
    def get_children_bounding_box(self) -> Rect: ...
    def get_visible_children_bounding_box(self) -> Rect: ...
