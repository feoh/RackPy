from typing import final

from rackpy.raw.math import Rect, Vec

@final
class WidgetVecView:
    """Checked field alias, not an independently owned Vec; use copy() for math."""
    @property
    def x(self) -> float: ...
    @x.setter
    def x(self, value: float) -> None: ...
    @property
    def y(self) -> float: ...
    @y.setter
    def y(self, value: float) -> None: ...
    def __getitem__(self, index: int) -> float: ...
    def __setitem__(self, index: int, value: float) -> None: ...
    def __add__(self, other: Vec | WidgetVecView) -> Vec: ...
    def __sub__(self, other: Vec | WidgetVecView) -> Vec: ...
    def __iadd__(self, other: Vec | WidgetVecView) -> WidgetVecView: ...
    def __isub__(self, other: Vec | WidgetVecView) -> WidgetVecView: ...
    def copy(self) -> Vec: ...
    def __copy__(self) -> Vec: ...
    def __deepcopy__(self, memo: dict[int, object]) -> Vec: ...

@final
class WidgetBoxView:
    """Checked live Widget.box alias; writes bypass reposition/resize events."""
    @property
    def pos(self) -> WidgetVecView: ...
    @pos.setter
    def pos(self, value: Vec | WidgetVecView) -> None: ...
    @property
    def size(self) -> WidgetVecView: ...
    @size.setter
    def size(self, value: Vec | WidgetVecView) -> None: ...
    def copy(self) -> Rect: ...
    def __copy__(self) -> Rect: ...
    def __deepcopy__(self, memo: dict[int, object]) -> Rect: ...

# Internal test-hooks builds only; absent from production.
def _native_root_count() -> int: ...

@final
class WidgetNode:
    """Detached native-only tree adapter; not the complete Widget binding."""
    @staticmethod
    def create() -> WidgetNode: ...
    @property
    def alive(self) -> bool: ...
    @property
    def box(self) -> WidgetBoxView: ...
    @box.setter
    def box(self, value: Rect | WidgetBoxView) -> None: ...
    @property
    def visible(self) -> bool: ...
    @visible.setter
    def visible(self, value: bool) -> None: ...
    @property
    def parent(self) -> WidgetNode | None: ...
    @property
    def children(self) -> tuple[WidgetNode, ...]: ...
    def close(self) -> None: ...
    def add_child(self, child: WidgetNode) -> None: ...
    def add_child_bottom(self, child: WidgetNode) -> None: ...
    def add_child_above(self, child: WidgetNode, sibling: WidgetNode) -> None: ...
    def add_child_below(self, child: WidgetNode, sibling: WidgetNode) -> None: ...
    def remove_child(self, child: WidgetNode) -> None: ...
    def clear_children(self) -> None: ...
    def request_delete(self) -> None: ...
    @property
    def requested_delete(self) -> bool: ...
    @requested_delete.setter
    def requested_delete(self, value: bool) -> None: ...
    def step(self) -> None: ...
    def has_child(self, child: WidgetNode) -> bool: ...
    def get_box(self) -> Rect: ...
    def set_box(self, box: Rect) -> None: ...
    def is_visible(self) -> bool: ...
    def set_visible(self, visible: bool) -> None: ...
    def get_children_bounding_box(self) -> Rect: ...
    def get_visible_children_bounding_box(self) -> Rect: ...
    def get_position(self) -> Vec: ...
    def set_position(self, position: Vec) -> None: ...
    def get_size(self) -> Vec: ...
    def set_size(self, size: Vec) -> None: ...
    def hide(self) -> None: ...
    def show(self) -> None: ...
    def is_descendant_of(self, ancestor: WidgetNode | None) -> bool: ...
    def get_absolute_offset(self, position: Vec) -> Vec: ...
    def get_relative_offset(self, position: Vec, ancestor: WidgetNode | None) -> Vec: ...
    def get_absolute_zoom(self) -> float: ...
    def get_relative_zoom(self, ancestor: WidgetNode | None) -> float: ...
    def get_viewport(self, rect: Rect = ...) -> Rect: ...
