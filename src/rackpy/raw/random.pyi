"""rack::random: Rack's random number generator."""

from typing import ClassVar, overload

class Xoroshiro128Plus:
    result_type: ClassVar[type[int]]
    state: list[int]
    @overload
    def __init__(self) -> None: ...
    @overload
    def __init__(self, s0: int, s1: int = 0) -> None: ...
    def seed(self, s0: int, s1: int = 0) -> None: ...
    def is_seeded(self) -> bool: ...
    def __call__(self) -> int: ...
    @staticmethod
    def rotl(x: int, k: int) -> int: ...
    @staticmethod
    def min() -> int: ...
    @staticmethod
    def max() -> int: ...

def local() -> Xoroshiro128Plus: ...
def init() -> None: ...
def get(type: str = "uint64") -> int | bool | float: ...
def get_uint32() -> int: ...
def get_uint16() -> int: ...
def get_uint8() -> int: ...
def get_bool() -> bool: ...
def get_float() -> float: ...
def get_double() -> float: ...
def u64() -> int: ...
def u32() -> int: ...
def uniform() -> float: ...
def normal() -> float: ...
def buffer(out: bytearray | memoryview) -> None: ...
def vector(len: int) -> bytes: ...
