class _TemplateMeta(type):
    # At run time a template class uses __class_getitem__ (pybind11's metaclass stays); typed here as indexing.
    def __getitem__(cls, args: type | tuple[type, ...]) -> type[Any]: ...

class Template(metaclass=_TemplateMeta):
    """A C++ class template: ``Template[Arg]`` is a cached specialization deriving from it and its base."""

    @classmethod
    def default(cls) -> type[Any]: ...

class AliasTemplate:
    """A C++ alias template: ``Alias[A]`` is the aliased specialization."""

    __name__: str
    def __getitem__(self, args: type | tuple[type, ...]) -> type[Any]: ...

