{
  "schema_version": 1,
  "note": "Which engine lock each public rack::engine::Engine method takes, read from src/engine/Engine.cpp at the pinned Rack commit (RP-11, from the ADR 003 table). exclusive and shared take Engine::Internal::mutex; caller_holds means the caller must already hold it (the _NoLock variants), so Python may call it only inside a callback Rack runs under the lock. bin/check_coverage.py fails if a public Engine method is missing here, and bin/generate_bindings.py refuses a Python mapping of an exclusive or shared method that does not release the GIL.",
  "rack_commit": "061ccf63c1758599396ac1bb10d47345d9d34076",
  "locks": {
    "exclusive": "takes the engine mutex exclusively: audio stops for the call",
    "shared": "takes the engine mutex shared: concurrent with audio, blocked by exclusive holders",
    "none": "takes no engine lock",
    "caller_holds": "requires the caller to hold the engine mutex already"
  },
